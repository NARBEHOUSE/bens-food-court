# ── Ben's Food Court (2026-11-08): every restaurant's counter and stations, laid out like the Burger Bar's ──────────
# SUPERSEDED for the seven counters (2026-11-09): the user asked that each counter scene match its storefront in the
# court picture, so the counters (the diner's 'counter' too) now come from jobs/write_counters.py, which attaches the
# storefront crop and the court picture as references. Don't redraw a counter from the entries below; the station
# backdrops (prep, oven, blender...) still come from here.
def counter_scene(stall, decor, queue, details):
    return f"""Asset type: game backdrop, 1536 x 1024, landscape
Scene: inside {stall}, one of the restaurants in a cheerful shopping-mall food court, seen from BEHIND its serving counter,
looking out past the counter at the food court: tables and chairs, other storefronts far away, a big skylight, eye level
about 1.6 m. Restaurant decor framing the view: {decor}
Composition (percent of the image):
- Left 10% to 55%: keep this area visually quiet (a plain wall and an empty table far back), because the game draws the
  current customer standing here, large, on top of the picture.
- Right 55% to 85%, middle distance: a short queue of three waiting customers, small, SHARP and in focus like everything
  else: {queue}. Original, funny designs.
- Bottom 22%: just the floor (the game draws the counter top here, on top of the picture).
Hidden funny details, small but findable: {details}
Everything sharp, nothing blurred. No text anywhere except what the details ask for. No border."""


def station_scene(what, wall, surface, details, top=62):
    return f"""Asset type: game backdrop, 1536 x 1024, landscape
Scene: {what}, as seen by the cook standing at it. The camera looks slightly downward.
Composition (percent of the image):
- Top {top}%: the wall behind the station: {wall}
- Bottom {100 - top}%: {surface} plain and simple (the game draws the food and the work surface on top of this part).
Hidden funny details, small but findable: {details}
Everything sharp. No text anywhere except what the details ask for. No border."""


BACKDROPS.update({
    # Burger Bar: the fryer and the drinks, for its bigger menu from two stars
    'diner-fryer': station_scene(
        "the Burger Bar's deep-fryer station", "stainless steel and white tiles, wire fry baskets hanging on hooks, a heat "
        "lamp glowing over a fry-dump tray, a salt shaker the size of a fire extinguisher, paper fry cones in a rack.",
        "the far back edge of a dark steel fryer with a soft golden glow of hot oil,",
        "a fry wearing a tiny crown on the shelf; a fire blanket in a frame labelled IN CASE OF ONION RINGS; a rubber "
        "chicken hanging with the baskets.", 65),

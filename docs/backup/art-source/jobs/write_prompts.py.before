"""Writes the Astra (Codex image generation) prompt files for Ben's Food Court art (Ben's Burger Bar first).

  python write_prompts.py models [char...]  one neutral "model" pose per character (the reference for the rest);
                                            mitch-<venue> is Mitch in that restaurant's uniform, drawn from his model
  python write_prompts.py poses <char...>   the other nine poses, two per job, with the model as reference
  python write_prompts.py backdrops         the station backdrops
Prompts land in jobs/<name>.txt; a jobs list (name<TAB>references) is printed for run_jobs.sh.
Art lands in art-source/cast/<char>/<pose>.png and art-source/backdrops/<name>.png (raw; the game gets optimised copies).
"""
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

STYLE = (
    "Style: original 2D cartoon art for a comedy diner game, TV-cartoon look. Thick, clean, even black outlines; "
    "flat bright colours with ONE hard-edged cel-shadow tone per colour; simple bold shapes; slightly exaggerated "
    "proportions (big head, big hands, big expressive eyes and mouth); a strong, readable silhouette. Funny for adults: "
    "dry, deadpan comedy, never cute, never babyish. It is an ORIGINAL design and must not resemble any existing "
    "cartoon character, show or brand."
)
FIGURE = (
    "Framing: ONE character, full body from the top of the head to the shoes, standing, facing the viewer and turned "
    "very slightly toward the viewer's right. The figure fills about 88% of the image height, centred, with a clear "
    "margin all round; nothing is cropped (hands, hat and feet all inside the frame). Plain pure white background, no "
    "floor, no cast shadow, no border, no text other than what the character description asks for, no other objects except what the character holds."
)


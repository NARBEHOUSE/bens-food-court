def prop_prompt(name):
    return f"""Use case: game prop for a 2D game
Asset type: one object on plain white, 1024 x 1024
Object: {PROPS[name]}
{PROP_STYLE}
Save as art-source/props/{name}.png (1024 x 1024) and the prompt as art-source/props/{name}-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the path of the generated file."""


def backdrop_prompt(name):
    return f"""Use case: background painting for a 2D game
{BACKDROPS[name]}
{BACKDROP_STYLE}
Save as art-source/backdrops/{name}.png (1536 x 1024) and the prompt as art-source/backdrops/{name}-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the path of the generated file."""


def main():
    what = sys.argv[1] if len(sys.argv) > 1 else ''
    jobs = []
    if what == 'models':
        chars = sys.argv[2:] or list(CAST)
        for c in chars:
            name = f'model-{c}'
            if c.startswith('mitch-'):   # a uniform: the approved Mitch is the reference
                write(name, uniform_prompt(c))
                jobs.append((name, 'art-source/cast/mitch/neutral.png'))
                continue
            write(name, model_prompt(c))
            jobs.append((name, ''))
    elif what == 'poses':
        for c in sys.argv[2:]:
            rest = [p for p in poses_for(c) if p != 'neutral']
            for i in range(0, len(rest), 2):
                group = rest[i:i + 2]
                name = f'poses-{c}-{"-".join(group)}'
                if c.startswith('mitch-'):     # uniform: costume from its model, poses from the approved Mitch
                    write(name, uniform_pose_prompt(c, group))
                    jobs.append((name, ' '.join([f'art-source/cast/{c}/neutral.png'] +
                                                [f'art-source/cast/mitch/{p}.png' for p in group])))
                    continue
                write(name, pose_prompt(c, group))
                jobs.append((name, f'art-source/cast/{c}/neutral.png'))
    elif what == 'extra':
        c, p = sys.argv[2], sys.argv[3]
        name = f'poses-{c}-{p}'
        write(name, pose_prompt(c, [p], EXTRA_POSES[c]))
        jobs.append((name, f'art-source/cast/{c}/neutral.png'))
    elif what == 'backdrops':
        for b in (sys.argv[2:] or list(BACKDROPS)):
            name = f'backdrop-{b}'
            write(name, backdrop_prompt(b))
            jobs.append((name, ''))
    elif what == 'props':
        for p in (sys.argv[2:] or list(PROPS)):
            name = f'prop-{p}'
            write(name, prop_prompt(p))
            jobs.append((name, ''))
    else:
        sys.exit(__doc__)
    for name, refs in jobs:
        print(f'{name}\t{refs}')


if __name__ == '__main__':
    main()

# Mitch works in every restaurant, in a different uniform over his usual shirt and tie (Food Court proposal).
UNIFORMS = {
    'burger': "a red diner work shirt with white piping worn open over his white shirt and red tie, and a white folded "
              "paper diner hat",
    'pizza': "a flour-dusted white apron over his shirt and tie, flour on his nose and hands, and a hat folded from a "
             "pizza box",
    'smoothie': "a loud tropical Hawaiian shirt worn open over his white shirt and red tie, a flower lei, and sunglasses "
                "pushed up on his head",
    'cafe': "a brown barista apron over his shirt and tie, a knitted beanie, and a takeaway coffee cup in one hand with "
            "his name written on it spelled wrong: MICH",
    'sushi': "a white sushi chef's jacket over his shirt (the red tie peeking out at the collar), a white headband tied "
             "round his forehead, and a very serious face",
    'burrito': "a red bandana tied on his head, a dark green apron over his shirt and tie, and a name tag splattered with "
               "hot sauce",
    'icecream': "a red-and-white candy-striped apron over his shirt, a red bow tie clipped on over his tie, and a white "
                "paper soda-jerk hat",
}
for _venue, _outfit in UNIFORMS.items():
    CAST['mitch-' + _venue] = CAST['mitch'] + " AT THIS RESTAURANT he wears " + _outfit + "."
EXTRAS = {k for k in CAST if k.startswith('shopper')}

# Ten whole-body poses, each with its own clear silhouette (DESIGN.md "Expressions").
POSES = {
    'neutral':   "NEUTRAL: standing relaxed and natural, a calm, pleasant face, hands at rest. This is the character's model pose.",
    'talking':   "TALKING: mid-sentence, mouth open, one hand raised beside the face gesturing as they order, eyebrows up.",
    'waiting':   "WAITING: patiently waiting, weight on one leg, glancing up and to the side, fingers drumming on the other arm or checking a wristwatch.",
    'happy':     "HAPPY: a big satisfied smile, eyes bright, giving a thumbs up with one hand, the other hand on the belly.",
    'delighted': "DELIGHTED: overjoyed, both arms thrown straight up in celebration, eyes squeezed shut with joy, mouth wide open, one foot kicked up.",
    'annoyed':   "ANNOYED: both hands on hips, a flat unimpressed frown, one eyebrow raised high, leaning back slightly.",
    'angry':     "ANGRY: furious, leaning forward, one arm out pointing an accusing finger straight at the viewer, the other fist clenched, face red, shouting, a vein on the forehead.",
    'disgusted': "DISGUSTED: recoiling backwards, one hand over the mouth as if about to gag, the other hand pushing away, tongue half out, face tinged green, eyes watering.",
    'shocked':   "SHOCKED: jaw dropped to the chest, eyes popping, both hands on the cheeks, hair standing on end, knees bent in alarm.",
    'laughing':  "LAUGHING: doubled over laughing, one hand on the belly and the other slapping the knee, eyes squeezed shut with tears of laughter.",
}
MITCH_POSES = {
    'neutral':   POSES['neutral'],
    'talking':   "TALKING: explaining something, mouth open, one hand raised palm-up beside the face, eyebrows up, confident.",
    'pointing':  "POINTING: pointing with one long arm straight out to the viewer's LEFT at something important, looking that way, the other hand on the headset mic, mid-sentence.",
    'thumbsUp':  "THUMBS UP: a cocky grin and a wink, both thumbs up, chest puffed out.",
    'shocked':   "SHOCKED: jaw dropped, eyes popping, both hands thrown up beside the head, headset knocked crooked.",
    'disgusted': "DISGUSTED: leaning back with his whole body, nose wrinkled, tongue out, one hand pinching his nose and the other waving away a smell.",
    'facepalm':  "FACEPALM: one hand slapped over his face, head tipped back, the other hand hanging limp, a long-suffering slump.",
    'laughing':  POSES['laughing'],
    'worried':   "WORRIED: biting his nails with both hands at his mouth, eyebrows up and together, sweat drops flying, knees together.",
    'shrug':     "SHRUG: a big exaggerated shrug, both palms up, shoulders to the ears, eyebrows raised, a sheepish 'what can you do' smile.",
}
# Poses only one character has: `python write_prompts.py extra <char> <pose>` (Food Court spec 2.2).
EXTRA_POSES = {
    'mitch': {
        'promoted': "PROMOTED: the proudest moment of his life: standing tall with his chest puffed out, peeling the "
                    "strip of masking tape off his name badge with one hand so the badge now reads just MANAGER, the "
                    "peeled tape held up in the other hand like a trophy, tears of joy, a huge grin.",
    },
}
# Vernon keeps his arms folded whenever the pose allows it: it is his silhouette.
VERNON_NOTE = ("Vernon keeps his arms FOLDED across his chest in every pose where the description allows it; when a pose "
               "needs a hand (pointing, gagging), only that hand comes out.")


def poses_for(char):
    return MITCH_POSES if char == 'mitch' or char.startswith('mitch-') else POSES


def uniform_pose_prompt(char, poses):
    """Mitch's poses in a uniform: the costume from his uniform model (image 1), each pose from his APPROVED pose
    pictures (images 2 and 3), so the uniformed Mitch moves exactly like the Mitch already in the game."""
    items = '\n'.join(f"- New picture {i + 1}: copy the POSE and EXPRESSION of attached image {i + 2} "
                      f"({MITCH_POSES[p].split(':')[0]}) exactly, dressed as in image 1. "
                      f"Save as art-source/cast/{char}/{p}.png (1024 x 1536)." for i, p in enumerate(poses))
    return f"""Use case: character pose set for a 2D game (a costume variant)
Asset type: full-body character poses on plain white, one image per pose
Attached image 1 is MITCH in this restaurant's uniform (approved). Attached images 2{' and 3' if len(poses) > 1 else ''} are the
APPROVED Mitch in the poses to copy. For each new picture: the pose, hands, expression and framing from its pose image;
the face, hair, body, the uniform, headset and badge from image 1. Nothing else changes. If a uniform item held in one
hand (a cup) does not fit the pose, leave it out.
{STYLE}
Character: {CAST[char]}
Make {len(poses)} separate images:
{items}
{FIGURE}
Also save the prompt as art-source/cast/{char}/{poses[0]}-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the paths of the generated files."""


def uniform_prompt(char):
    """Mitch in a restaurant's uniform: the approved Mitch is the reference, only his outfit changes."""
    venue = char.split('-', 1)[1]
    return f"""Use case: character model for a 2D game (a costume variant)
Asset type: full-body character pose on plain white
Attached image 1 is MITCH, the APPROVED character. Draw the SAME character: copy his face, hair, body shape and
proportions, skin, colours, outline weight and shading style exactly. Change ONLY his outfit: he now wears
{UNIFORMS[venue]}. Keep his phone headset with the boom microphone, and his name badge reading MANAGER with a strip of
masking tape across it on which ASST. is handwritten.
{STYLE}
Pose: {MITCH_POSES['neutral']}
{FIGURE}
Save as art-source/cast/{char}/neutral.png (1024 x 1536, portrait) and the prompt as art-source/cast/{char}/neutral-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the path of the generated file."""


def write(name, text):
    (HERE / (name + '.txt')).write_text(text.strip() + '\n', encoding='utf-8')


def model_prompt(char):
    pose = poses_for(char)['neutral']
    extra = ('\n' + VERNON_NOTE) if char == 'vernon' else ''
    return f"""Use case: character model for a 2D game
Asset type: full-body character pose on plain white
{STYLE}
Character: {CAST[char]}{extra}
Pose: {pose}
{FIGURE}
Save as art-source/cast/{char}/neutral.png (1024 x 1536, portrait) and the prompt as art-source/cast/{char}/neutral-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the path of the generated file."""


def pose_prompt(char, poses, texts=None):
    extra = ('\n' + VERNON_NOTE) if char == 'vernon' else ''
    texts = texts or poses_for(char)
    items = '\n'.join(f"- New picture {i + 1}: {texts[p]} Save as art-source/cast/{char}/{p}.png (1024 x 1536)."
                      for i, p in enumerate(poses))
    return f"""Use case: character pose set for a 2D game
Asset type: full-body character poses on plain white, one image per pose
Attached image 1 is the APPROVED model of this character in the neutral pose. Copy the character EXACTLY: the same
face, hair, body shape and proportions, clothes, accessories, colours, outline weight and shading style. Change ONLY the
pose and the facial expression. Each pose must read from its silhouette alone.
{STYLE}
Character: {CAST[char]}{extra}
Make {len(poses)} separate images:
{items}
{FIGURE}
Also save the prompt as art-source/cast/{char}/{poses[0]}-prompt.md.
Reply with the saved paths. If saving into the project fails, reply with the paths of the generated files."""


BACKDROP_STYLE = (
    "Style: original 2D cartoon background painting for a comedy diner game, matching a TV-cartoon look: clean dark "
    "outlines, flat bright colours with simple hard-edged shading, gently exaggerated shapes, warm and inviting, slightly "
    "absurd. No people in the foreground. It is ORIGINAL and must not resemble any existing show, restaurant or brand; "
    "no real logos."
)
BACKDROPS = {

'use strict';
/* Ben's Food Court - a restaurant's 3D food drawn on the CPU, over its real backdrops, with no browser (dev-only;
 * browsers are off-limits on this PC). For every food agent: look at the food before handing it over.
 *
 *   node tools/food-frames.cjs <pack> [out dir] [filters...]
 *
 *   <pack>     a pack id (pizza, diner, ...): packs/<pack>/pack.js and js/food/<pack>.js (a pack without its own
 *              module borrows the diner's, as the game does)
 *   [out dir]  where the PNGs go; a path (with a slash or a dot). Default: art-source/review/food-<pack>/
 *   [filters]  words: only frames whose name contains one are drawn (line, cook, timed, gross, reduced, giant,
 *              counter, low, or part of a name such as pepperoni). Flags: `guides` draws the backdrop's measured
 *              surface line (green) and, at the counter, where the served customer's eyes and hips go (cyan, spec
 *              5.2) and the painted queue that nothing may cover (yellow); `aspects` draws every counter frame at
 *              16:10, 4:3 and 21:9 too (by default only counter-one, -combo, -twin and the event's finale are);
 *              `nosheet` skips the contact sheets.
 *
 * Every counter frame is also measured, the way tests/dom-play.cjs checks the page: where the order lands on that
 * window (on screen or cut off, its size, how far it rises above the counter line, whether its right edge passes
 * 52% of the picture, where the painted queue starts). The lines go to the console and index.txt; `cut`, `queue`
 * and `not on the counter top` are the ones to fix. A window wider or narrower than 16:9 is resized the way the game
 * resizes (world.js places the order again for it).
 *
 * It runs the real frame (js/world.js) and the real line (js/core/line.js) in Node with a stub window: every
 * sample order is walked step by step as game.js would (goTo, showStep, outcome, showCounter), and at the moments
 * worth looking at the scene is rendered by NARBE Racer's tools/node_render.cjs at each set's solved camera, keyed
 * over the backdrop picture (art-source/backdrops/<pack>-<set>.png; the diner's are unprefixed). Frames:
 *   line-*      every station: the item so far and what waits on the line, before and after each step (each
 *               ingredient and each slot value once), the flourishes mid-air, then the order on the counter
 *   cook-*      every cooking set: waiting, every stage on the heat, Simple's run (going in, baking, done)
 *   timed-*     the Timed view: on the heat from the start
 *   gross-*     every gross-out: on the line (Full motion, the fly mid-orbit), served, on the counter
 *   reduced-*   the same gross-outs with Motion Reduced (fx sit still)
 *   giant-*     every event recipe on its line and on the counter, and the event's finale on the counter
 *   counter-*   one item, a main with a side, two mains (these and the event's finale also at 16:10, 4:3, 21:9:
 *               the frames named ...@16x10, @4x3, @21x9)
 *   low-*       Graphics Quality Low: the fullest item on the line, on the heat and on the counter
 * Then sheet-<n>.png: contact sheets of every frame, 12 to a sheet, and index.txt listing them (with the counter
 * fit of each counter frame, and a summary of the ones to fix at the end).
 */
const path = require('path'), fs = require('fs'), zlib = require('zlib');
const GAME = path.join(__dirname, '..');
const HUB = path.join(GAME, '..', '..', '..');
const NR = require(path.join(HUB, 'apps', 'games', 'NARBEKART', 'tools', 'node_render.cjs'));
const W = 1280, H = 720;

/* ── arguments ── */
const argv = process.argv.slice(2);
const packId = argv[0];
if (!packId || !fs.existsSync(path.join(GAME, 'packs', packId, 'pack.js'))) {
  console.log('usage: node tools/food-frames.cjs <pack> [out dir] [filters...]   (packs: ' +
    fs.readdirSync(path.join(GAME, 'packs')).filter(id => fs.existsSync(path.join(GAME, 'packs', id, 'pack.js'))).join(', ') + ')');
  process.exit(1);
}
const isPath = s => /[\\/.]/.test(s);
const OUT = path.resolve(argv[1] && isPath(argv[1]) ? argv[1] : path.join(GAME, 'art-source', 'review', 'food-' + packId));
const words = argv.slice(argv[1] && isPath(argv[1]) ? 2 : 1);
const GUIDES = words.includes('guides'), NOSHEET = words.includes('nosheet'), ASPECTS = words.includes('aspects');
const FILTERS = words.filter(w => w !== 'guides' && w !== 'nosheet' && w !== 'aspects');
// The window shapes the counter must work at (spec 5.2), drawn 720 high.
const SHAPES = { '16x10': 16 / 10, '4x3': 4 / 3, '21x9': 21 / 9 };
// The counter's layout (spec 5.2; docs/api/page.md 7 has the page's numbers): the served customer's eyes near the
// painted horizon (46.5% of the picture), the customer centred at 24% in the quiet left part; the painted queue of
// three in x 52-76%, 43-77% down. The order stays left of the queue: tests/dom-play.cjs fails an order whose right
// edge passes 52% of the picture.
const COUNTER = { eyes: 0.465, quiet: [0.10, 0.52], queue: [0.52, 0.43, 0.76, 0.77] };
const wanted = name => !FILTERS.length || FILTERS.some(f => name.includes(f));
fs.mkdirSync(OUT, { recursive: true });

/* ── a stub window for js/world.js: no DOM, no WebGL, a frame clock we step by hand ── */
const quiet = fn => { const w = console.warn; console.warn = () => {}; try { return fn(); } finally { console.warn = w; } };
const clock = { now: 0 };
let raf = null, LOW = false;
const motion = { value: 'full' };
globalThis.window = globalThis; globalThis.self = globalThis;
globalThis.innerWidth = W; globalThis.innerHeight = H; globalThis.devicePixelRatio = 1;
const listeners = {};                       // world.js listens for 'resize': windowShape() fires it
globalThis.addEventListener = (type, fn) => { (listeners[type] = listeners[type] || []).push(fn); };
globalThis.removeEventListener = (type, fn) => { listeners[type] = (listeners[type] || []).filter(f => f !== fn); };

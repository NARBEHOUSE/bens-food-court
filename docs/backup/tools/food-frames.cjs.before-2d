  });
  const sl = world.surfaceLine ? world.surfaceLine('counter') : null;
  const lineY = (sl ? sl.y : FOOD.lineOnScreen(def.line, w / h, def.picture || picture)) * h;
  queue = x1 > qa.x + 0.5;                                    // as tests/dom-play.cjs: the order's right edge past the queue's left edge
  return { x0, x1, y0, y1, line: lineY, cut: Math.max(0, Math.ceil(y1 - h)) + Math.max(0, Math.ceil(-x0)) + Math.max(0, Math.ceil(x1 - w)),
    above: Math.max(0, Math.round(lineY - y0)), queue, offTop: y1 <= lineY, w, h };
}

/* ── taking a picture ── */
let n = 0, tiles = [], sheets = 0;
const index = [], fits = [];
/** Draw the scene as it is now. o.shape: '16x10' | '4x3' | '21x9' (a window that shape, 720 high; default 16:9). */
/** Resize the window as the game would: world.js's resize sets the camera's shape and places the counter's order
 *  again for it (a window that shape may show less of the counter top), then one frame draws it. */
function windowShape(w, h) {
  globalThis.innerWidth = w; globalThis.innerHeight = h;
  (listeners.resize || []).forEach(fn => fn());
  tick(1);
}
async function snap(name, o) {
  if (!wanted(name)) return;
  const shape = o && o.shape, w = shape ? Math.round(H * SHAPES[shape]) : W, h = H;
  if (shape) windowShape(w, h);
  tick(1);                                  // one frame, so what changed is rendered
  if (!lastRender) { console.log('  nothing rendered yet for ' + name); return; }
  const setName = world.set;
  const bg = backdropFor(setName || 'counter', w, h);
  const img = composite(bg, render3d(w, h));
  const def = setName && world.__kit.find('sets', setName);
  const solved = def && typeof def.line === 'number';
  if (GUIDES && def) {
    if (solved) {
      const sl = world.surfaceLine ? world.surfaceLine(setName) : null;
      const y = Math.round((sl ? sl.y : FOOD.lineOnScreen(def.line, w / h, def.picture || bg.picture)) * h);
      hline(img, y, [40, 255, 60], 14);
      NR.text(img, w - 250, y - 22, 'LINE ' + (def.line * 100).toFixed(1) + '%', 2, [40, 255, 60], [0, 0, 0]);
    }
    if (setName === 'counter') {
      // Spec 5.2: the served customer stands in the quiet zone, hips at the counter line, eyes near the painted
      // horizon; the painted queue (yellow) is never covered.
      const eyes = onScreen(COUNTER.quiet[0], COUNTER.eyes, w, h, bg.picture), right = onScreen(COUNTER.quiet[1], COUNTER.eyes, w, h, bg.picture);
      const csl = world.surfaceLine ? world.surfaceLine('counter') : null;
      const hips = solved ? (csl ? csl.y : FOOD.lineOnScreen(def.line, w / h, def.picture || bg.picture)) * h : h * 0.86;
      rect(img, Math.round(eyes.x), Math.round(eyes.y), Math.round(right.x), Math.round(hips), [0, 220, 255]);
      NR.text(img, Math.round(eyes.x) + 6, Math.round(eyes.y) + 6, 'CUSTOMER EYES TO HIPS', 2, [0, 220, 255], [0, 0, 0]);
      const qa = onScreen(COUNTER.queue[0], COUNTER.queue[1], w, h, bg.picture), qb = onScreen(COUNTER.queue[2], COUNTER.queue[3], w, h, bg.picture);
      rect(img, Math.round(qa.x), Math.round(qa.y), Math.round(qb.x), Math.round(qb.y), [255, 220, 0]);
      NR.text(img, Math.round(qa.x) + 6, Math.round(qa.y) + 6, 'QUEUE', 2, [255, 220, 0], [0, 0, 0]);
    }
  }
  let note = '';
  if (setName === 'counter' && solved) {
    const f = counterFit(w, h, bg.picture, def);
    if (f) {
      note = 'FIT ' + (shape || '16x9') + ': ' + (f.cut ? 'cut ' + f.cut + 'px off the window' : 'on screen') + ', ' + Math.round(f.x1 - f.x0) + 'x' + Math.round(f.y1 - f.y0) +
        'px, top ' + f.above + 'px above the line, x ' + (f.x0 / w * 100).toFixed(1) + '-' + (f.x1 / w * 100).toFixed(1) + '%' +
        (f.queue ? ', reaches the queue (right of ' + (COUNTER.queue[0] * 100).toFixed(1) + '% of the picture)' : '') + (f.offTop ? ', not on the counter top' : '');
      fits.push(name + (shape ? '@' + shape : '') + '  ' + note);
    }
  }
  NR.text(img, 10, h - 26, name + (shape ? ' @' + shape : ''), 2, [255, 255, 255], [27, 18, 14]);
  const file = String(++n).padStart(2, '0') + '-' + name + (shape ? '@' + shape : '') + '.png';
  NR.writePNG(path.join(OUT, file), img);
  index.push(file + '  (' + (setName || '-') + (solved ? ', line ' + (def.line * 100).toFixed(1) + '%' : '') + ')' + (note ? '  ' + note : ''));
  console.log('  ' + file + (note ? '   ' + note : ''));
  tiles.push(tile(img));
  if (tiles.length >= 12) flushSheet();
  if (shape) windowShape(W, H);             // back to the 16:9 window
  // A counter frame at every window shape the counter must work at (spec 5.2).
  if (!shape && setName === 'counter' && (ASPECTS || /^(counter-(one|combo|twin)|giant-finale-counter)$/.test(name))) {
    for (const s of Object.keys(SHAPES)) await snap(name, { shape: s });
  }
}
function flushSheet() {
  if (NOSHEET || !tiles.length) { tiles = []; return; }
  const img = NR.sheet(tiles, 3);
  NR.writePNG(path.join(OUT, 'sheet-' + String(++sheets).padStart(2, '0') + '.png'), img);
  tiles = [];
}

/* ── sample orders: a recipe as written (every pick's normal value), or with every optional part on ── */
function specOf(rid, o) {
  o = o || {};
  const R = P.recipes[rid], it = R.item || {};
  const pickOf = name => (P.picks || {})[name] || null;
  const val = v => (v && typeof v === 'object' && v.pick ? ((pickOf(v.pick) || {}).normal || (pickOf(v.pick) || { values: [] }).values[0] || (P.slots && P.slots[v.pick] ? P.slots[v.pick].values[0].id : undefined)) : v);
  const spec = { recipe: rid, ing: val(it.ing), parts: [], holds: [], adds: [] };
  if (it.size) spec.size = val(it.size);
  if (it.done) spec.done = val(it.done);
  (it.parts || []).filter(p => o.all || p.opt !== 'out').forEach(p => {
    const q = { ing: val(p.ing) };
    if (p.done) q.done = val(p.done);
    if (p.ing && typeof p.ing === 'object') q.flavour = true;
    if (q.ing) spec.parts.push(q);
  });
  if (it.slots) {
    spec.picks = {};
    Object.keys(it.slots).forEach(slot => {
      const v = it.slots[slot], S = (P.slots || {})[slot], first = S && S.values && S.values[0] && S.values[0].id;
      if (typeof v === 'string' || Array.isArray(v)) spec.picks[slot] = v;
      else if (v && v.pick) {
        const pk = pickOf(v.pick), normal = (pk && pk.normal) || (pk && pk.values && pk.values[0]) || first;
        spec.picks[slot] = v.count ? Array.from({ length: v.count[0] || 1 }, () => normal) : normal;
      }
    });
  }
  if (o.picks) Object.assign(spec.picks || (spec.picks = {}), o.picks);
  if (o.set) Object.keys(o.set).forEach(key => { if (key === 'done' || (it.done && it.done.pick === key)) spec.done = o.set[key]; });
  return spec;
}
/** The right answer for a step (as tests/food.test.cjs answers), or the bad one when told to serve a gross-out. */
function answerFor(o, q, serveGross) {
  const want = L.expected(P, o.items[q.item], q.station, q.step);
  const leaves = (function flat(opts) { return opts.flatMap(x => (x.row ? flat(x.row) : [x])); })(q.options || []);
  if (q.kind === 'add') return q.gross ? (serveGross ? 'add' : 'swap') : q.have < want ? 'add' : 'skip';
  if (q.kind === 'cook') return q.timed ? 'takeOff' : want === null ? q.options[0].id : 'cook:' + want;
  if (q.kind === 'pick') {
    if (q.gross) return serveGross ? 'pick:' + q.gross.value : 'swap';
    if (q.repeat) {
      const left = L.remaining ? L.remaining(want || [], q.picked || []) : [];
      if (!left.length) return q.have ? 'done' : leaves.find(x => x.value !== undefined).id;
      return leaves.find(x => x.value === left[0]).id;
    }
    const hit = leaves.find(x => x.value === want) || leaves.find(x => x.value !== undefined);
    return hit.id;
  }
  return null;
}
const stepKey = q => q.kind + ':' + (q.kind === 'add' ? q.ing : q.kind === 'pick' ? (q.slot || q.of) : q.station);
const valueOf = (q, id) => (id && id.startsWith('pick:') ? id.slice(5) : id);

/** Walk one order through the line as game.js would. hooks: { before(q, made, o), after(q, made, r, o, id), mid(e, q) ->
 *  [{ ms, name }], answer(q, o) -> id, settings, gross, ms }. Returns the order and what was made. */
async function walk(spec, hooks) {
  hooks = hooks || {};
  const settings = Object.assign({ cooking: 'simple' }, hooks.settings);
  const o = L.create(P, { customer: { id: 'x', name: 'X' }, items: [spec] }, { settings, gross: hooks.gross });
  for (let guard = 0; o.phase === 'line' && guard < 400; guard++) {
    const q = L.question(P, o, settings);
    if (!q) break;
    const made = L.made(P, o, q.item);
    world.goTo(q.station);
    await drive(world.showStep(q, made));
    if (hooks.before) await hooks.before(q, made, o);
    const id = (hooks.answer && hooks.answer(q, o)) || answerFor(o, q, hooks.serveGross);
    if (q.kind === 'cook' && q.timed && hooks.timedTo !== undefined) {
      // Timed: tick the clock to the wanted stage, then take it off.
      for (let t = 0; t < 400; t++) {
        const ev = L.tick(P, o, 0.5, settings, false) || [];
        for (const e of ev) if (e && e.type === 'stage') { world.cookStage(e); advance(100); if (hooks.stage) await hooks.stage(e, q); }
        const now = L.question(P, o, settings);
        if (now && now.stage === hooks.timedTo) break;
      }
    }
    const r = L.answer(P, o, id, settings);
    if (r.refused) throw new Error('the line refused ' + id + ' at ' + q.key);
    const after = L.made(P, o, q.item);
    for (const e of r.events || []) await drive(world.outcome(e, after, { ms: hooks.ms || 420 }), hooks.mid ? { snapAt: hooks.mid(e, q) || [] } : null);
    if (hooks.after) await hooks.after(q, after, r, o, id);
  }
  return { o, made: L.made(P, o, 0) };
}
async function counterOf(list, name) {
  world.goTo('counter');
  world.showCounter(list);
  await snap(name);
}
const recipeIds = Object.keys(P.recipes || {});
const isEvent = rid => { const R = P.recipes[rid]; return R.level === 'event' || !!(R.look && R.look.giant) || R.giant === true; };
const everyday = recipeIds.filter(rid => !isEvent(rid));
/** The recipe with the most on it (the fullest line). */
const fullest = everyday.slice().sort((a, b) => ((P.recipes[b].item || {}).parts || []).length - ((P.recipes[a].item || {}).parts || []).length)[0];

(async () => {
  const t0 = Date.now();
  await world.init();
  world.usePack(P);
  if (world.useAnchor) world.useAnchor(true);   // as stage.js does: the counter picture anchored lower at 21:9
  console.log('frames for ' + packId + ' -> ' + OUT + (FILTERS.length ? '  (only: ' + FILTERS.join(', ') + ')' : ''));
  const seen = new Set();
  const once = key => { if (seen.has(key)) return false; seen.add(key); return true; };

  /* line: every recipe, each ingredient and each slot value pictured once, before and after its step */
  const order = [fullest].concat(everyday.filter(r => r !== fullest));
  for (const rid of order) {
    await walk(specOf(rid, { all: true }), {
      before: async q => { if (once('before:' + stepKey(q))) await snap('line-' + rid + '-' + q.station + '-' + (q.kind === 'add' ? q.ing : q.kind === 'pick' ? (q.slot || q.of) : q.kind) + '-before'); },
      mid: (e, q) => (e.type === 'auto' && once('mid:' + (e.show || e.id)) ? [{ ms: 400, name: 'line-' + rid + '-' + q.station + '-' + (e.show || e.id) + '-mid' }] : []),
      after: async (q, made, r, o, id) => {
        if (q.kind === 'add' && id !== 'add') return;
        const key = 'after:' + stepKey(q) + ':' + (q.kind === 'pick' ? valueOf(q, id) : q.kind === 'auto' ? q.key : '');
        if (once(key)) await snap('line-' + rid + '-' + q.station + '-' + (q.kind === 'add' ? q.ing : q.kind === 'pick' ? (q.slot || q.of) + '-' + valueOf(q, id) : q.kind) + '-after');
      },
    }).then(({ made }) => counterOf([made], 'counter-' + rid));
  }
  // Every slot value not yet seen: the first recipe with that slot, with that value, pictured after the pick.
  for (const slot of Object.keys(P.slots || {})) {
    for (const v of P.slots[slot].values || []) {
      if (seen.has('after:pick:' + slot + ':' + v.id)) continue;
      const rid = everyday.find(r => ((P.recipes[r].item || {}).slots || {})[slot] !== undefined);
      if (!rid) continue;
      seen.add('after:pick:' + slot + ':' + v.id);
      await walk(specOf(rid, { picks: { [slot]: v.id } }), {
        after: async (q, made, r, o, id) => { if (q.kind === 'pick' && q.slot === slot) await snap('line-' + rid + '-' + q.station + '-' + slot + '-' + v.id + '-after'); },
      }).then(({ made }) => counterOf([made], 'counter-' + rid + '-' + slot + '-' + v.id));
    }
  }

  /* cook: every cooking set, every stage, Simple's run and the Timed view */
  const cookSets = new Set();
  Object.keys(P.stations || {}).forEach(sid => { if (P.stations[sid].steps.some(s => s.kind === 'cook')) cookSets.add(sid); });
  const cookedIngs = new Set();
  for (const rid of everyday) {
    const R = P.recipes[rid];
    const sid = R.stations.find(s => cookSets.has(s));
    if (!sid) continue;
    const spec = specOf(rid, { all: true });
    const key = sid + ':' + (spec.ing || rid);
    if (cookedIngs.has(key)) continue;
    cookedIngs.add(key);
    const tag = 'cook-' + (spec.ing || rid);
    await walk(spec, {
      before: async (q, made) => {
        if (q.kind !== 'cook' || q.station !== sid) return;
        await snap(tag + '-wait');
        const names = (q.set && P.stageSets && P.stageSets[q.set] && P.stageSets[q.set].stages) || [];
        for (let i = 0; i < names.length; i++) { world.cookStage(i); advance(300); await snap(tag + '-stage' + i + '-' + names[i]); }
        // Back to how the step was shown, so Simple's run starts from the start.
        await drive(world.showStep(q, made));
      },
      answer: (q, o) => null,
      mid: (e, q) => (e.type === 'cooked' ? [{ ms: 110, name: tag + '-run-in' }, { ms: 300, name: tag + '-run-baking' }] : []),
      after: async (q, made, r) => { if (q.kind === 'cook' && q.station === sid) await snap(tag + '-run-done-' + (made.done || '')); },
      ms: 520,
    });
    // Timed: on the heat from the start; taken off at the wanted stage.
    // A cook step with `want` (the Cafe's pour and fryer: no made.done) has no done to stop at: the Timed walk runs
    // its stage set to the last stage and pictures every stage on the way (food-cafe, 2026-11-09).
    const cookStep = P.stations[sid].steps.find(s => s.kind === 'cook');
    // A stage set with simple: 'auto' (the sushi's mat) is never asked in Simple, so the Simple walk above shows none
    // of its stages: the Timed walk runs it to the last stage and pictures every stage instead (food-sushi).
    const autoSet = cookStep && cookStep.stages && P.stageSets && P.stageSets[cookStep.stages] && P.stageSets[cookStep.stages].simple === 'auto' ? P.stageSets[cookStep.stages] : null;
    const wantSet = (!spec.done && cookStep && cookStep.want && cookStep.stages && P.stageSets && P.stageSets[cookStep.stages]) || autoSet;
    const want = autoSet ? autoSet.stages[autoSet.stages.length - 1] : spec.done || (wantSet ? wantSet.stages[wantSet.stages.length - 1] : null);
    await walk(spec, {
      settings: { cooking: 'timed', speed: 'normal' },
      timedTo: want,
      stage: wantSet ? async e => { await snap('timed-' + (spec.ing || rid) + '-stage-' + e.stage); } : undefined,
      before: async q => { if (q.kind === 'cook' && q.station === sid) await snap('timed-' + (spec.ing || rid) + '-start'); },
      after: async (q, made) => { if (q.kind === 'cook' && q.station === sid) await snap('timed-' + (spec.ing || rid) + '-off-' + (made.done || '')); },
      ms: 400,
    });
  }

  /* gross: every gross-out on the line (Full motion), served, on the counter; then with Motion Reduced */
  for (const E of P.gross || []) {
    const ing = E.step === 'pick' ? null : [].concat(E.on || [])[0];
    const rid = everyday.find(r => (E.step === 'pick' ? ((P.recipes[r].item || {}).slots || {})[E.slot] !== undefined
      : ((P.recipes[r].item || {}).parts || []).some(p => p.ing === ing)));
    if (!rid) { console.log('  no recipe carries the gross-out ' + E.id); continue; }
    const spec = specOf(rid, { all: true });
    if (E.step === 'pick') { const bad = [].concat(E.on || []).find(v => v !== 'none') || E.on[0]; spec.picks = Object.assign({}, spec.picks, { [E.slot]: bad }); }
    const gross = E.step === 'pick' ? { item: 0, slot: E.slot, event: E.id } : { item: 0, ing, event: E.id };
    for (const mode of ['full', 'reduced']) {
      motion.value = mode;
      const tag = (mode === 'full' ? 'gross-' : 'reduced-') + E.id;
      await walk(spec, {
        gross, serveGross: true,
        before: async q => { if (q.gross) { advance(450); await snap(tag + '-line'); } },
        after: async (q, made, r) => { if (mode === 'full' && q.gross) await snap(tag + '-served'); },
      }).then(async ({ made }) => { if (mode === 'full') await counterOf([made], tag + '-counter'); });
    }
    motion.value = 'full';
  }

  /* giant: the event recipes on their line and the counter; the event's finale together */
  for (const rid of recipeIds.filter(isEvent)) {
    const stations = new Set();
    await walk(specOf(rid), {
      before: async q => { if (!stations.has(q.station)) { stations.add(q.station); } },
      after: async (q, made, r, o) => {
        const st = P.stations[q.station];
        const last = st && st.steps && q.step === st.steps.length - 1;
        if (last || (q.kind === 'cook')) await snap('giant-' + rid + '-' + q.station);
      },
    }).then(({ made }) => counterOf([made], 'giant-' + rid + '-counter'));
  }
  const finale = P.events && P.events.five && P.events.five.finale && P.events.five.finale.items;
  if (finale && finale.length) {
    const list = [];
    for (const it of finale) { const { made } = await walk(specOf(it.recipe, { set: it.set })); list.push(made); }
    await counterOf(list, 'giant-finale-counter');
  }

  /* counter: one item, a main with its side, two mains */
  if (wanted('counter-one') || wanted('counter-combo') || wanted('counter-twin')) {
    // (a pack whose courses are not main/side, the Cafe's drink/donut: the first course's first recipe with the
    // second course's first, as the pack's combos pair them; food-cafe 2026-11-09)
    const firstCourse = (P.courses && P.courses[0]) || 'main';
    const main = everyday.find(r => !P.recipes[r].course || P.recipes[r].course === firstCourse) || everyday[0];
    const side = everyday.find(r => P.recipes[r].course && P.recipes[r].course !== (P.recipes[main].course || 'main'));
    const one = (await walk(specOf(main, { all: true }))).made;
    await counterOf([one], 'counter-one');
    if (side) await counterOf([one, (await walk(specOf(side))).made], 'counter-combo');
    const other = everyday.find(r => r !== main && (!P.recipes[r].course || P.recipes[r].course === (P.recipes[main].course || 'main')));
    if (other) await counterOf([one, (await walk(specOf(other))).made], 'counter-twin');
  }

  /* low: Graphics Quality Low on the fullest item */
  if (wanted('low-line') || wanted('low-cook') || wanted('low-counter')) {
    LOW = true;
    const sid = (P.recipes[fullest].stations || []).find(s => cookSets.has(s));
    await walk(specOf(fullest, { all: true }), {
      before: async q => { if (q.kind === 'cook' && q.station === sid) { world.cookStage(2); advance(200); await snap('low-cook'); } },
      after: async (q, made, r, o) => {
        const st = P.stations[q.station];
        if (q.station === (P.recipes[fullest].stations || [])[0] && st && q.step === st.steps.length - 1) await snap('low-line');
      },
    }).then(({ made }) => counterOf([made], 'low-counter'));
    LOW = false;
  }

  flushSheet();
  const bad = fits.filter(f => / cut |reaches the queue|not on the counter/.test(f));
  const summary = fits.length ? ['', 'Counter fit (spec 5.2: the order on the counter top, fully on screen, the painted queue clear): ' +
    (fits.length - bad.length) + ' of ' + fits.length + ' frames fine'].concat(bad.map(f => '  ' + f)) : [];
  fs.writeFileSync(path.join(OUT, 'index.txt'), index.concat(summary).join('\n') + '\n');
  summary.forEach(s => console.log(s));
  console.log(n + ' frames in ' + OUT + ' (' + ((Date.now() - t0) / 1000).toFixed(1) + ' s)');
})().catch(e => { console.error(e && e.stack || e); process.exit(1); });

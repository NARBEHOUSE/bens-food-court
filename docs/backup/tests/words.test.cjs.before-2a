/** Words: tickets, order parts for recorded voices, the review's description, step labels,
 *  receipt lines and saved settings. The Burger Bar's wording on the frozen diner (byte for
 *  byte, the golden tests), then the Food Court's: slots, repeats and counts on the ticket, in
 *  the line's order; numbers to twelve; stage-set words; pick complaints. */
'use strict';
const test = require('node:test');
const assert = require('node:assert');
const { golden: pack, testPizza: P, O, L, S, W, R, F, right, play, makeOrder, run, random } = require('./bot.cjs');

const spec = (recipe, ctx) => O.resolve(pack, recipe, { rng: R.seed(1) }, Object.assign({ change: 0 }, ctx));
const ticket = items => ({ customer: { id: 'x', name: 'X' }, items });

/* ── the Burger Bar's words (the frozen diner) ─────────────────────────── */
test('customers order the way people do', () => {
  assert.strictEqual(W.said(pack, ticket([spec('cheeseburger', { set: { doneness: 'mediumWell' } })])), 'Cheeseburger, medium well.');
  assert.strictEqual(W.said(pack, ticket([O.hold(spec('baconCheeseburger'), ['onion'])])), 'Bacon Cheeseburger, medium, no onions.');
  const one = spec('hamburger', { set: { doneness: 'rare' } });
  assert.strictEqual(W.said(pack, ticket([one, JSON.parse(JSON.stringify(one))])), 'Two Hamburgers, rare.');
  assert.strictEqual(W.said(pack, ticket([spec('cheeseburger'), spec('hamburger')])), 'Cheeseburger, medium and Hamburger, medium.');
  const simple = O.resolve(pack, 'hamburger', { rng: R.seed(4) }, { style: 'simple', change: 0 });
  assert.match(W.said(pack, ticket([simple])), /with just \w+ and \w+\./);
});

test('the ticket spells out every patty and everything that goes on, in the line\'s order', () => {
  assert.strictEqual(W.ticket(pack, ticket([spec('cheeseburger', { set: { doneness: 'mediumWell' } })])),
    'Cheeseburger: one patty, medium well, with cheese, lettuce, tomato, pickles and ketchup.');
  assert.strictEqual(W.ticket(pack, ticket([O.hold(spec('baconCheeseburger'), ['onion'])])),
    'Bacon Cheeseburger: one patty, medium, with cheese, bacon, lettuce, tomato and ketchup.');
  const one = spec('hamburger', { set: { doneness: 'rare' } });
  assert.strictEqual(W.ticket(pack, ticket([one, JSON.parse(JSON.stringify(one))])),
    'Two Hamburgers, each: one patty, rare, with lettuce, tomato, pickles and ketchup.');
  assert.strictEqual(W.ticket(pack, ticket([spec('doubleCheeseburger'), spec('hamburger')])),
    'Double Cheeseburger: two patties, medium, with cheese, lettuce, pickles, onion, ketchup and mustard. ' +
    'Hamburger: one patty, medium, with lettuce, tomato, pickles and ketchup.');
  const bare = O.hold(spec('hamburger'), ['lettuce', 'tomato', 'pickles', 'ketchup']);
  assert.strictEqual(W.item(pack, bare), 'Hamburger: one patty, medium, nothing else on it');
  // The fryer and the drinks: the pick is the name, then the doneness, then what goes on.
  const s = { rng: R.seed(1) };
  assert.strictEqual(W.ticket(pack, ticket([O.resolve(pack, 'onionRings', s, { change: 0, set: { fry: 'crispy' } })])), 'Onion Rings: crispy, with salt.');
  assert.strictEqual(W.ticket(pack, ticket([O.resolve(pack, 'fountain', s, { change: 0, set: { cupSize: 'large', soda: 'orangeSoda' } })])),
    'Large orange soda: with ice.');
  const sp = W.spelled(pack, spec('cheeseburger'));
  assert.deepStrictEqual(sp.bits, sp.cooked.concat([W.onWords(sp)]), 'bits are the whole ticket line; cooked and on are kept for the wheel');
});

test('the ticket lists exactly what the line expects, for any order', () => {
  for (let seed = 1; seed <= 300; seed++) {
    const s = S.create(pack, { seed, settings: { orders: ['simple', 'usual', 'fancy'][seed % 3], shiftLength: 4 } });
    while (!s.done) {
      const o = S.next(pack, s);
      o.items.forEach((item, i) => {
        const sp = W.spelled(pack, item.spec);
        for (const sid of L.stationsOf(pack, item)) {
          pack.stations[sid].steps.forEach((st, n) => {
            if (st.kind !== 'add') return;
            const want = L.expected(pack, item, sid, n) || 0, word = W.lower(W.name(pack, st.ing));
            if ((st.max || 1) > 1) assert.ok(sp.cooked.some(c => c.startsWith(W.NUMBER[want] + ' ')), 'seed ' + seed + ' item ' + i + ': ' + want + ' ' + st.ing + ' not on ' + JSON.stringify(sp));
            else assert.strictEqual(sp.on.includes(word), want > 0, 'seed ' + seed + ' item ' + i + ': ' + st.ing + ' (wanted ' + want + ') vs ' + JSON.stringify(sp.on));
          });
        }
      });
      play(pack, s, (q, ord) => right(pack, ord, q));
    }
  }
});

test('every order part any order needs is in the recording list, with the same words', () => {
  const all = new Map(W.allOrderParts(pack).map(p => [p.id, p.text]));
  for (let seed = 1; seed <= 400; seed++) {
    const s = S.create(pack, { seed, settings: { orders: ['simple', 'usual', 'fancy'][seed % 3], shiftLength: 5 } });
    while (!s.done) {
      const o = S.next(pack, s);
      for (const part of W.orderParts(pack, o.ticket)) {
        assert.ok(all.has(part.id), 'missing part ' + part.id);
        assert.strictEqual(all.get(part.id), part.text);
      }
      play(pack, s, (q, ord) => right(pack, ord, q));
    }
  }
});

test('the parts say the same order as the customer does', () => {
  const t = ticket([O.hold(spec('baconCheeseburger', { set: { doneness: 'well' } }), ['onion', 'tomato'])]);
  assert.deepStrictEqual(W.orderParts(pack, t).map(p => p.text), ['Bacon Cheeseburger', 'well done', 'no onions', 'no tomatoes']);
  assert.strictEqual(W.said(pack, t), 'Bacon Cheeseburger, well done, no onions, no tomatoes.');
});

test('the review describes what was made, never whether it is right', () => {
  const o = L.create(pack, ticket([spec('cheeseburger')]), { settings: {}, gross: { item: 0, ing: 'cheese', event: 'mouldy' } });
  L.answer(pack, o, 'add', {}); L.answer(pack, o, 'add', {}); L.answer(pack, o, 'skip', {}); L.answer(pack, o, 'cook:rare', {});
  for (const id of ['add', 'skip', 'add', 'skip', 'skip', 'add', 'skip', 'skip', 'skip']) L.answer(pack, o, id, {});
  const said = W.made(pack, L.made(pack, o, 0), o.items[0].spec);
  assert.strictEqual(said, 'Cheeseburger: two patties, rare, with the green cheese, lettuce and onion.');
  const none = L.create(pack, ticket([spec('hamburger')]), { settings: {} });
  L.answer(pack, none, 'skip', {});
  for (let k = 0; k < 9; k++) L.answer(pack, none, 'skip', {});
  assert.strictEqual(W.made(pack, L.made(pack, none, 0), none.items[0].spec), 'Hamburger: no patty, nothing else on it.');
});

for (const p of [pack, P]) {
  test(p.id + ': every step has a prompt and a label for every answer, in Simple and Timed', () => {
    for (const cooking of ['simple', 'timed']) {
      for (let seed = 5; seed <= (p === pack ? 5 : 40); seed++) {
        const s = S.create(p, { seed, settings: { cooking, shiftLength: 3, orders: 'fancy', speed: 'normal' } });
        const bot = seed % 2 ? random(s) : (q, o) => right(p, o, q);
        while (!s.done) {
          play(p, s, (q, o) => {
            assert.ok(W.prompt(p, q, o).length > 3, 'prompt for ' + q.kind);
            assert.ok(!/undefined|null|NaN|\{/.test(W.prompt(p, q, o)), W.prompt(p, q, o));
            const every = opts => opts.forEach(opt => {
              const l = W.option(p, q, opt, o);
              assert.ok(l.label && l.say, q.kind + ' ' + opt.id);
              assert.ok(!/undefined|null|NaN|\{/.test(l.label + l.say), l.label + ' / ' + l.say);
              if (opt.row) every(opt.row);
            });
            every(q.options);
            return bot(q, o);
          });
        }
      }
    }
  });
}

test('labels for the grill and a bad ingredient', () => {
  const q = { kind: 'add', ing: 'patty', max: 3, have: 1, offer: 2, options: [] };
  assert.strictEqual(W.option(pack, q, { id: 'add' }).say, 'Add a second patty');
  assert.deepStrictEqual(W.option(pack, q, { id: 'skip' }), { label: 'Done', say: 'Done, one patty' });
  const g = { kind: 'add', ing: 'tomato', max: 1, have: 0, offer: 1, gross: { event: 'hair' }, options: [] };
  assert.strictEqual(W.option(pack, g, { id: 'add' }).say, 'Add tomato with a hair on it');
  assert.strictEqual(W.option(pack, g, { id: 'swap' }).label, 'Swap It');
  const cook = { kind: 'cook', ing: 'patty', count: 2, set: 'patty', options: [] };
  assert.strictEqual(W.prompt(pack, cook), 'Cook the patties. How done?');
  assert.strictEqual(W.prompt(pack, Object.assign({}, cook, { timed: true, stage: 'rare' })), 'The patties are cooking. Take it off when it is right.');
  assert.deepStrictEqual(W.option(pack, Object.assign({}, cook, { timed: true, stage: 'rare' }), { id: 'takeOff' }), { label: 'Take It Off', say: 'Take it off. Rare' });
});

test('receipt lines name each mistake in words', () => {
  assert.strictEqual(W.mistake(pack, { kind: 'extra', ing: 'cheese' }), 'Cheese: not wanted');
  assert.strictEqual(W.mistake(pack, { kind: 'missing', ing: 'pickles' }), 'Pickles: left off');
  assert.strictEqual(W.mistake(pack, { kind: 'count', ing: 'patty', want: 2, got: 1 }), 'Patties: wanted 2, got 1');
  assert.strictEqual(W.mistake(pack, { kind: 'done', ing: 'patty', want: 'medium', got: 'well' }), 'Patty: wanted medium, got well done');
  assert.strictEqual(W.mistake(pack, { kind: 'gross', ing: 'cheese', event: 'mouldy' }), 'Cheese: green cheese');
});

test('settings: a version 1 save is upgraded; a newer save is never written over', () => {
  const v1 = JSON.stringify({ v: 1, kind: 'settings', data: { cooking: 'timed', mitch: 'off', star: true, customersAtOnce: 2, shiftLength: 8 } });
  const r = F.read('settings', v1, pack);
  assert.ok(r.ok);
  assert.deepStrictEqual([r.data.cooking, r.data.manager, r.data.shiftLength], ['timed', 'off', 8]);
  assert.ok(!('star' in r.data) && !('customersAtOnce' in r.data) && !('mitch' in r.data));
  const newer = JSON.stringify({ v: 9, kind: 'settings', data: {} });
  assert.deepStrictEqual(F.read('settings', newer, pack), { ok: false, reason: 'newer', keep: true });
  assert.ok(!F.canWrite('settings', newer));
  assert.ok(F.read('shift', JSON.stringify(F.wrap('shift', { id: 'diner', version: 1 }, {})), pack).reason === 'packVersion');
});

/* ── the Food Court's words (the test pizzeria) ────────────────────────── */
const pspec = (recipe, set, picks) => {
  const sp = O.resolve(P, recipe, { rng: R.seed(1) }, { change: 0, set });
  if (picks) Object.assign(sp.picks, picks);
  return sp;
};

test('the ticket spells out every slot, repeat and count, in the line\'s order', () => {
  const pep = pspec('pepperoni', { crust: 'thin', sauce: 'white', bake: 'crispy', cut: 'c6' });
  assert.strictEqual(W.ticket(P, ticket([pep])), 'Pepperoni Pizza: thin crust, white sauce, with mozzarella and pepperoni, crispy, cut in 6.');
  const bare = pspec('pepperoni', { sauce: 'bare', cut: 'whole' });
  assert.strictEqual(W.item(P, bare), 'Pepperoni Pizza: regular crust, sauce: none, with mozzarella and pepperoni, golden, left whole',
    'a value\'s own say; never "no sauce"');
  assert.strictEqual(W.item(P, pspec('chicago')),
    'Chicago Deep Dish: deep dish crust, red sauce, with mozzarella, pepperoni and two garlic cloves, golden, cut in 8');
  const knots = pspec('knots', { heat: 'hot' }, { dips: ['pesto', 'pesto', 'ranch'] });
  assert.strictEqual(W.item(P, knots), 'Garlic Knots: with garlic butter and two parmesan shakes, hot, two pesto dips and one ranch dip');
  const sp = W.spelled(P, knots);
  assert.deepStrictEqual(sp.bits, ['with garlic butter and two parmesan shakes', 'hot', 'two pesto dips and one ranch dip']);
  assert.deepStrictEqual([sp.cooked, sp.on], [['hot', 'two pesto dips and one ranch dip'], ['garlic butter', 'two parmesan shakes']]);
  assert.strictEqual(W.ticket(P, ticket([knots, JSON.parse(JSON.stringify(knots))])),
    'Two Garlic Knots, each: with garlic butter and two parmesan shakes, hot, two pesto dips and one ranch dip.');
  // A repeat lists alike values together: "two pesto dips and one ranch dip", never "pesto, ranch and pesto".
  assert.deepStrictEqual(O.grouped(['pesto', 'ranch', 'pesto']), ['pesto', 'pesto', 'ranch']);
});

test('the ticket lists exactly what the line expects, for any order, in the line\'s order (test pizzeria)', () => {
  for (let seed = 1; seed <= 300; seed++) {
    const s = S.create(P, { seed, settings: { orders: ['simple', 'usual', 'fancy'][seed % 3], shiftLength: 4 } });
    while (!s.done) {
      const o = S.next(P, s);
      o.items.forEach((item, i) => {
        const sp = W.spelled(P, item.spec), where = 'seed ' + seed + ' item ' + i + ' ' + JSON.stringify(sp.bits);
        let at = 0;                                    // each step's words come no earlier than the last step's
        const find = (words) => {
          const k = sp.bits.findIndex((b, j) => j >= at && b.includes(words));
          assert.ok(k >= 0, words + ' not in line order: ' + where);
          at = k;
        };
        for (const { sid, n, step } of W.lineSteps(P, item.spec)) {
          const want = L.expected(P, item, sid, n);
          if (step.kind === 'add') {
            const k = want || 0, word = (step.max || 1) > 1 ? W.number(k) + ' ' + W.lower(k === 1 ? W.name(P, step.ing) : W.plural(P, step.ing)) : W.lower(W.name(P, step.ing));
            if (k) find(word); else assert.ok(!sp.on.includes(word), word + ' is not wanted: ' + where);
          } else if (step.kind === 'cook') find(W.lower(W.stage(P, want)));
          else if (step.kind === 'pick') find(step.repeat ? W.repeatSay(P, step.slot, want) : W.valueSay(P, step.slot, want));
        }
      });
      play(P, s, (q, ord) => right(P, ord, q));
    }
  }
});

test('numbers in words up to twelve, then the digits', () => {
  assert.deepStrictEqual([1, 2, 7, 11, 12].map(W.number), ['one', 'two', 'seven', 'eleven', 'twelve']);
  assert.strictEqual(W.number(13), '13');
  assert.deepStrictEqual([1, 2, 8, 11, 12, 13].map(W.ordinal), ['a', 'a second', 'an eighth', 'an eleventh', 'a twelfth', 'another']);
  const one = pspec('margherita', { crust: 'thin', bake: 'golden', cut: 'c8' });
  const dozen = Array.from({ length: 12 }, () => JSON.parse(JSON.stringify(one)));
  assert.match(W.ticket(P, ticket(dozen)), /^Twelve Margheritas, each: thin crust/);
  assert.match(W.said(P, ticket(dozen.slice(0, 7))), /^Seven Margheritas, golden, thin crust, cut in 8\.$/);
  assert.deepStrictEqual(W.orderParts(P, ticket(dozen.slice(0, 9))).slice(0, 2), [{ id: 'count.9', text: 'Nine' }, { id: 'recipes.margherita', text: 'Margheritas' }]);
  // A repeat or a count past six, in words.
  const many = JSON.parse(JSON.stringify(P));
  many.stations.warmer.steps[1].max = 12;
  many.stations.warmer.steps[3].repeat.max = 12;
  const k = O.resolve(many, 'knots', { rng: R.seed(1) }, { change: 0 });
  k.parts = k.parts.filter(p => p.ing !== 'parmesan').concat(Array.from({ length: 11 }, () => ({ ing: 'parmesan' })));
  k.picks.dips = Array.from({ length: 8 }, () => 'honey').concat(['ranch']);
  assert.strictEqual(W.item(many, k), 'Garlic Knots: with garlic butter and eleven parmesan shakes, warm, eight honey dips and one ranch dip');
  assert.strictEqual(W.option(many, { kind: 'add', ing: 'parmesan', max: 12, have: 11, offer: 12, options: [] }, { id: 'add' }).say, 'Add a twelfth parmesan shake');
});

test('stage-set words: a cook step asks its own question and names its own Timed button', () => {
  const o = makeOrder(P, ['margherita']);
  let q;
  while ((q = L.question(P, o, { cooking: 'simple' })).kind !== 'cook') L.answer(P, o, right(P, o, q), { cooking: 'simple' });
  assert.strictEqual(W.prompt(P, q, o), 'Oven. How crispy?');
  assert.deepStrictEqual(W.option(P, q, q.options[2], o), { label: 'Crispy', say: 'Crispy' });
  const timed = { kind: 'cook', ing: 'pizza', count: 1, set: 'bake', timed: true, stage: 'golden', fresh: false, station: 'oven', options: [{ id: 'takeOff' }] };
  assert.strictEqual(W.prompt(P, timed), 'Pull it out when it is right.');
  assert.deepStrictEqual(W.option(P, timed, { id: 'takeOff' }), { label: 'Pull It Out', say: 'Pull it out. Golden' });
  const warm = { kind: 'cook', ing: 'knots', count: 1, set: 'warm', timed: true, stage: 'hot', fresh: true, station: 'warmer', options: [{ id: 'takeOff' }] };
  assert.strictEqual(W.prompt(P, warm), 'Warmer. Stop the warmer when it is right.');
  assert.deepStrictEqual(W.option(P, warm, { id: 'takeOff' }), { label: 'Stop the Warmer', say: 'Stop the warmer. Hot' });
});

test('labels on a slot pick: the values, the bad one by name, Swap It, Done, More…', () => {
  const o = makeOrder(P, ['pepperoni'], { set: { sauce: 'red' }, gross: { item: 0, slot: 'sauce', event: 'skin' } });
  L.answer(P, o, 'pick:regular', { cooking: 'simple' });
  let q = L.question(P, o, { cooking: 'simple' });
  assert.deepStrictEqual(q.options.map(x => W.option(P, q, x, o).label), ['Red sauce with a skin on it', 'White', 'None', 'Swap It']);
  assert.strictEqual(W.option(P, q, { id: 'swap' }, o).say, 'Swap red sauce with a skin on it for a fresh one');
  assert.strictEqual(W.prompt(P, q, o), 'Sauce: Red sauce with a skin on it, White or None?');
  const fresh = makeOrder(P, ['pepperoni']);
  q = L.question(P, fresh, { cooking: 'simple' });
  assert.strictEqual(W.prompt(P, q, fresh), 'Prep Table. Crust: Thin, Regular or Deep Dish?');
  const k = makeOrder(P, ['knots'], { set: { dip: 'pesto' } });
  while ((q = L.question(P, k, { cooking: 'simple' })).slot !== 'dips') L.answer(P, k, right(P, k, q), { cooking: 'simple' });
  assert.strictEqual(W.prompt(P, q, k), 'Dip: Ranch, Garlic or more?');
  assert.deepStrictEqual(W.option(P, q, q.options[2], k), { label: 'More…', say: 'More choices' });
  assert.deepStrictEqual(W.option(P, q, q.options[2].row[4], k), { label: 'More…', say: 'More choices' });
  L.answer(P, k, 'pick:pesto', { cooking: 'simple' });
  L.answer(P, k, 'pick:pesto', { cooking: 'simple' });
  q = L.question(P, k, { cooking: 'simple' });
  assert.strictEqual(W.prompt(P, q, k), 'A third dip: Ranch, Garlic, more or Done?');
  assert.deepStrictEqual(W.option(P, q, { id: 'done' }, k), { label: 'Done', say: 'Done, two pesto dips' });
});

test('pick complaints get {slot} and {want} words; receipt lines name slots, repeats and bad values', () => {
  const m = { kind: 'pick', of: 'slot', slot: 'sauce', want: 'white', got: 'bare' };
  assert.deepStrictEqual(W.blanks(P, m), { slot: 'sauce', want: 'white', got: 'none' });
  assert.strictEqual(W.mistake(P, m), 'Sauce: wanted white, got none');
  assert.deepStrictEqual(W.blanks(P, { kind: 'pick', of: 'slot', slot: 'crust', want: 'deepDish', got: 'thin' }), { slot: 'crust', want: 'deep dish', got: 'thin' });
  const count = { kind: 'count', of: 'slot', slot: 'dips', want: 2, got: 3, n: 1 };
  assert.deepStrictEqual(W.blanks(P, count), { slot: 'dip', count: 'two', want: 'two' });
  assert.strictEqual(W.mistake(P, count), 'Dips: wanted 2, got 3');
  const gross = { kind: 'gross', slot: 'sauce', value: 'red', event: 'skin' };
  assert.deepStrictEqual(W.blanks(P, gross), { slot: 'sauce', value: 'red' });
  assert.strictEqual(W.mistake(P, gross), 'Sauce: red sauce with a skin on it');
  assert.deepStrictEqual(W.blanks(P, { kind: 'done', ing: 'knots', want: 'hot', got: 'warm' }), { ing: 'garlic knots', ings: 'garlic knots', want: 'hot', got: 'warm' });
  assert.strictEqual(W.mistake(P, { kind: 'done', ing: 'knots', want: 'hot', got: 'scorched' }), 'Garlic Knots: wanted hot, got scorched');
  assert.strictEqual(W.mistake(P, { kind: 'count', ing: 'parmesan', want: 2, got: 3 }), 'Parmesan Shakes: wanted 2, got 3');
  // The diner's words for its own kinds, through the same helper.
  assert.deepStrictEqual(W.blanks(pack, { kind: 'done', ing: 'patty', want: 'mediumWell', got: 'rare' }), { ing: 'patty', ings: 'patties', want: 'medium well', got: 'rare' });
  assert.deepStrictEqual(W.blanks(pack, { kind: 'pick', of: 'ing', want: 'fries', got: 'rings' }), { want: 'fries', got: 'onion rings' });
  assert.deepStrictEqual(W.blanks(pack, { kind: 'count', ing: 'patty', want: 2, got: 1 }), { ing: 'patty', ings: 'patties', count: 'two', want: 'two', got: 'one' });
});

test('the customer says the slots the order chose; the parts say the same, and every part is in the recording list', () => {
  const t = ticket([pspec('pepperoni', { crust: 'thin', sauce: 'bare', bake: 'crispy', cut: 'c10' })]);
  assert.strictEqual(W.said(P, t), 'Pepperoni Pizza, crispy, thin crust, sauce: none, cut in 10.');
  assert.deepStrictEqual(W.orderParts(P, t).map(p => p.id), ['recipe.pepperoni', 'done.crispy', 'slot.crust.thin', 'slot.sauce.bare', 'slot.cut.c10']);
  // A fixed slot is part of the recipe and goes unsaid; a repeat is said with its counts.
  assert.strictEqual(W.said(P, ticket([pspec('chicago', { sauce: 'white' })])), 'Chicago Deep Dish, golden, white sauce.');
  const k = ticket([pspec('knots', { heat: 'hot' }, { dips: ['pesto', 'pesto', 'ranch'] })]);
  assert.strictEqual(W.said(P, k), 'Garlic Knots, hot, two pesto dips and one ranch dip.');
  assert.deepStrictEqual(W.orderParts(P, k).map(p => p.text), ['Garlic Knots', 'hot', 'two pesto dips', 'and', 'one ranch dip']);
  const all = new Map(W.allOrderParts(P).map(p => [p.id, p.text]));
  for (let seed = 1; seed <= 300; seed++) {
    const s = S.create(P, { seed, settings: { orders: ['simple', 'usual', 'fancy'][seed % 3], shiftLength: 4 } });
    while (!s.done) {
      const o = S.next(P, s);
      for (const part of W.orderParts(P, o.ticket)) {
        assert.ok(all.has(part.id), 'missing part ' + part.id);
        assert.strictEqual(all.get(part.id), part.text);
      }
      play(P, s, (q, ord) => right(P, ord, q));
    }
  }
});

test('the review says what was made, in the line\'s order, a bad value by its gross-out', () => {
  const o = makeOrder(P, ['pepperoni', 'knots'], { set: { sauce: 'red', heat: 'warm' }, gross: { item: 0, slot: 'sauce', event: 'skin' } });
  const choices = { crust: 'pick:deepDish', sauce: 'pick:red', cut: 'pick:whole' };
  let dips = 0;
  const res = run(P, o, { cooking: 'simple' }, (q, ord) => {
    if (q.kind === 'pick' && choices[q.slot]) return choices[q.slot];
    if (q.slot === 'dips') return dips++ < 2 ? 'pick:honey' : 'done';
    return right(P, ord, q);
  });
  // The garlic step follows the ticket's crust (regular), not the deep dish picked: it never asks.
  assert.ok(!res.seen.some(q => q.ing === 'garlic'));
  const said = o.items.map((it, i) => W.made(P, L.made(P, o, i), it.spec));
  assert.deepStrictEqual(said, [
    'Pepperoni Pizza: deep dish crust, red sauce with a skin on it, with mozzarella and pepperoni, golden, left whole.',
    'Garlic Knots: with garlic butter and two parmesan shakes, warm, two honey dips.']);
  const deep = makeOrder(P, ['chicago']);
  run(P, deep, { cooking: 'simple' }, (q, ord) => (q.ing === 'garlic' ? (q.have < 1 ? 'add' : 'skip') : right(P, ord, q)));
  assert.strictEqual(W.made(P, L.made(P, deep, 0), deep.items[0].spec),
    'Chicago Deep Dish: deep dish crust, red sauce, with mozzarella, pepperoni and one garlic clove, golden, cut in 8.');
});

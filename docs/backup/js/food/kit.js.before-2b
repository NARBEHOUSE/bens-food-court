      });
    }

    /* ── shared builders: fill and pour ── */
    const radiusAt = (profile, y) => {
      if (y <= profile[0][1]) return profile[0][0];
      for (let i = 1; i < profile.length; i++) {
        const [r0, y0] = profile[i - 1], [r1, y1] = profile[i];

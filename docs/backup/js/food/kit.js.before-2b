        const hole = new THREE.Mesh(new THREE.CircleGeometry(0.006 * S, 6), toon(0x2b2b2b));
        hole.rotation.x = -Math.PI / 2;
        const a = i * Math.PI * 2 / 5, r = i ? 0.018 * S : 0;

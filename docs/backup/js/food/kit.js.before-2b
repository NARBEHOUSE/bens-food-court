        shred: () => new THREE.BoxGeometry(0.08, 0.008, 0.014),
        sprinkle: () => new THREE.CylinderGeometry(0.006, 0.006, 0.035, 6),
        leaf: () => new THREE.CircleGeometry(0.04, 8).rotateX(-Math.PI / 2),

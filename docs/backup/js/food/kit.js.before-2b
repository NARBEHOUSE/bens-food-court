    }
    /** Show a bead of sauce squirted as far as u (0 to 1) along its path. */
    function growBead(S, u) {
      const n = Math.round(Math.max(0, Math.min(1, u)) * SAUCE.seg);
      S.geo.setDrawRange(0, n * SAUCE.rad * 6);

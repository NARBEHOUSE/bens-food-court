      [[W / 2, 0, D], [-W / 2, 0, D]].forEach(([x, z, len]) => { const lip = k.inkThin(new THREE.BoxGeometry(0.012, 0.03, len), k.toon(0xb8c1c8)); lip.position.set(x, 0.02, z); g.add(lip); });

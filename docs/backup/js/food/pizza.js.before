        colour: (L, s) => mix(L, s, 0x3a120e, [0, 0, 0.15, 0.32, 0.7]),
        flecks: { n: 3, colour: 0x5a1510 },
      },
      sausage: { n: 14, inset: 0.86, h: 0.03, tilt: 1.5, jitter: true, piece: () => k.piece('chunk'), colour: (L, s) => mix(L, s, 0x2e1810, [0, 0.08, 0.2, 0.4, 0.75]) },
      mushrooms: {
        n: 10, inset: 0.84, h: 0.012, tilt: 0.3, scale: s => (s >= 2 ? 0.92 : 1),
        piece: () => kept('mushroom', () => {
          const sh = new THREE.Shape();

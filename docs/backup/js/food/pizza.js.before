    const TOPPINGS = {
      pepperoni: {
        n: 12, inset: 0.84, h: 0.012, tilt: 0.25,
        piece: (s, o) => (o && o.heart ? heartGeo('pep', 0.062, 0.012, 0)
          : s >= 2 ? kept('pep-cup', () => k.lathe([[0, 0], [0.05, 0], [0.06, 0.012], [0.058, 0.022], [0.052, 0.018], [0.046, 0.008], [0, 0.008]], 18))

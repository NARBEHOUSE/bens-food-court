          const R = k.rand(seed + ':fl' + i);
          for (let j = 0; j < per; j++) { const a = R() * Math.PI * 2, rr = R() * 0.038; fl.push({ p: [p.p[0] + Math.cos(a) * rr, p.p[1] + T.h + 0.002, p.p[2] + Math.sin(a) * rr], nrm: [0, 1, 0], r: 0, t: 0.5 }); }
        });

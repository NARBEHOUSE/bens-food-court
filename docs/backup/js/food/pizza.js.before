      greenPeppers: { n: 10, inset: 0.86, h: 0.014, tilt: 0.5, piece: () => kept('pepper', () => new THREE.TorusGeometry(0.06, 0.012, 6, 12, 1.7).rotateX(Math.PI / 2)), colour: (L, s) => mix(L, s, 0x1f3a16, [0, 0, 0.1, 0.3, 0.6]), char: s => (s >= 3 ? (s === 3 ? 5 : 9) : 0) },
      redOnions: { n: 12, inset: 0.86, h: 0.008, tilt: 0.4, piece: () => kept('onion', () => new THREE.TorusGeometry(0.075, 0.006, 5, 16, 2.4).rotateX(Math.PI / 2)), colour: (L, s) => mix(L, s, 0x8a4a3a, [0, 0, 0.15, 0.3, 0.6]), flat: s => (s >= 2 ? 0.7 : 1) },
      blackOlives: { n: 12, inset: 0.86, h: 0.014, tilt: 0.3, piece: () => kept('olive', () => new THREE.TorusGeometry(0.034, 0.012, 6, 14).rotateX(Math.PI / 2)), colour: L => L.colour },
      pineapple: { n: 10, inset: 0.86, h: 0.016, tilt: 0.3, piece: () => kept('pineapple', () => k.cyl(0.05, 0.026, 3)), colour: (L, s) => mix(L, s, 0xb5731f, [0, 0, 0.1, 0.4, 0.7]) },

        const red = (x + y) % 2 === 0, i = (y * cols + x) * 4;
        data[i] = red ? 0xc4 : 0xff; data[i + 1] = red ? 0x2a : 0xfa; data[i + 2] = red ? 0x22 : 0xf2; data[i + 3] = 255;
      }

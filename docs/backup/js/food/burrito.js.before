    const FLOURISH = ['wrap', 'fold', 'arrange', 'burst'];
    const C = { foil: 0xd8dfe5, foilDark: 0xa3adb6, steel: 0xaab3ba, steelDark: 0x6f7880, cream: 0xfff4e2, orange: 0xe8792b, green: 0x2f8a3e };

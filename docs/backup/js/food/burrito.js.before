          });
        }).then(() => { if (c.onApply) c.onApply(); return c.pop(b.g); });
      },
      /** The wrapped burrito bulges, wobbles and pops: beans, rice and sour cream fly out onto a scrap of foil with a
       *  puff of steam; a second tortilla flops over it and rolls round it. */
      burritoBurst(c, e, made) {
        if (pickOf(made, 'style') !== 'burrito') return popIt(c, made);
        if (k.reduced()) { c.showItem(made); return P0(); }
        const before = c.showItem(without(made, ['burst']));
        if (!before) { c.showItem(made); return P0(); }
        const g = before.g, s0 = g.scale.clone();
        return k.tween(700, t => {
          const swell = 1 + 0.16 * k.ease(t), wob = Math.sin(t * PI * 9) * 0.05 * t;
          g.scale.set(s0.x * (1 + wob * 0.3), s0.y * (swell - wob), s0.z * (swell + wob));
        }).then(() => {
          if (c.onApply) c.onApply();
          const b = c.showItem(made), bg = b && b.g;
          if (!bg) return P0();
          const spill = bg.getObjectByName('spill'), outer = bg.getObjectByName('outer');
          c.F.updateMatrixWorld(true);
          const steam = [];
          for (let i = 0; i < 3; i++) {
            const p = k.puff(0xffffff, 0.75);
            p.position.copy(c.toF(bg, V(0.22 + i * 0.04, 0.2, 0.08)));
            p.scale.setScalar(1.4);
            c.F.add(p); steam.push(p);
          }
          const sp0 = spill ? spill.position.clone() : null;
          if (outer) outer.scale.set(0.05, 1, 1);
          return k.tween(520, t => {
            const e2 = k.ease(t);
            if (spill) { spill.position.set(sp0.x - 0.12 * (1 - e2), sp0.y + Math.sin(t * PI) * 0.18, sp0.z - 0.15 * (1 - e2)); spill.scale.setScalar(0.4 + 0.6 * e2); }
            steam.forEach((p, i) => { p.position.y += 0.004; p.userData.mat.opacity = 0.75 * (1 - t); });
          }).then(() => {
            steam.forEach(p => { c.F.remove(p); k.free(p); });
            if (!outer) return P0();
            return k.tween(460, t => { const e2 = k.ease(t); outer.scale.set(0.05 + 0.95 * e2, 1 + 0.15 * Math.sin(t * PI), 1 + 0.15 * Math.sin(t * PI)); outer.rotation.x = (1 - e2) * 2.2; });
          }).then(() => { const b2 = c.showItem(made); return b2 ? c.pop(b2.g) : P0(); });
        });
      },
    };
    function popIt(c, made) { const b = c.showItem(made); return b ? c.pop(b.g) : P0(); }

    /* ── the griddle: the item lies on the dark plate; steam while it toasts, smoke when burnt ── */
    function steam(c, at, top) {
      const R = k.rand('steam');
      for (let i = 0; i < 3; i++) {
        const p = k.puff(0xffffff, 0.6);
        p.position.set(at.x + (i - 1) * 0.22 + (R() - 0.5) * 0.05, at.y + top + 0.04, at.z + (R() - 0.5) * 0.08);
        p.scale.setScalar(1.3);
        c.F.add(p);
        k.spin(p, 'rise', { phase: i * 0.7, alpha: 0.6, height: 0.3 });
      }
    }
    const cooks = {
      griddle: {
        show(c, s) {
          const made = s.made || c.state.made || (s.ing ? { recipe: null, ing: s.ing, parts: [], picks: { style: s.ing === 'tacos' ? 'tacos' : 'burrito' }, counts: {}, auto: [], gross: [] } : null);
          if (!made) return;
          const A = c.anchors, b = k.item(made, { stage: s.stage || 0, where: 'griddle', set: 'griddle' });
          if (A.giantMax && b.giant > A.giantMax) { const f = A.giantMax / b.giant; b.g.scale.multiplyScalar(f); b.h *= f; }
          b.g.position.copy(A.plate);
          b.g.name = 'item';
          c.F.add(b.g);
          if (s.cooking || s.steam) steam(c, A.plate, b.h);
        },
        /** The item slides onto the plate from the right. */
        add(c, s) {
          c.redraw({ ing: s.ing, n: s.n, stage: 0, cooking: false });
          const item = c.F.getObjectByName('item');
          if (!item || k.reduced()) return P0();
          const p0 = item.position.clone();
          return k.tween(300, t => { item.position.x = p0.x + (1 - k.ease(t)) * 1.3; });
        },
        /** Simple: it toasts a stage at a time to the one chosen (the stripes appear one by one), a hiss of steam at
         *  the end. Timed: it is shown at the stage it came off at. */
        run(c, s) {
          const stage = s.stage | 0, ms = s.ms || 1800;
          if (k.reduced() || c.state.timed) { c.redraw({ stage, cooking: false, steam: false }); return P0(); }
          let p = P0();
          for (let i = 1; i <= stage; i++) p = p.then(() => { c.redraw({ stage: i, cooking: true }); return k.wait(ms * 0.7 / Math.max(1, stage)); });
          return p.then(() => { c.redraw({ stage, cooking: false, steam: true }); return k.wait(ms * 0.2); })
            .then(() => { c.redraw({ stage, cooking: false, steam: false }); });
        },
        stage(c, s) { c.redraw({ stage: s.stage, cooking: true }); },
      },
    };

    /* ── the sets, by backdrop name ── */
    const sets = {
      counter: {
        // Solved to its picture like a station (spec 5.2): the counter top's back edge lands at 80% of the picture.
        // Everything here lies flat on the counter top, so nothing covers the painted queue.
        x: 12, line: COUNTER.line, surface: { y: COUNTER.top, back: COUNTER.back },
        cam: { pos: [0, COUNTER.top + 1.15, COUNTER.back + 4.6], at: [0, COUNTER.top + 1.15 - 1.55, COUNTER.back - 1], fov: 38 },
        build(g) {
          // The Burritos' counter as the court picture draws it: a cream top over bright orange planks, the orange
          // edge along the customer's side with a dark brown trim line.
          const T = COUNTER.top, B = COUNTER.back, D = 3.6, L = 16;
          const top = new THREE.Mesh(new THREE.BoxGeometry(L, 0.12, D), k.toon(0xfff3dc)); top.position.set(0, T - 0.06, B + D / 2); g.add(top);
          const body = new THREE.Mesh(new THREE.BoxGeometry(L, T - 0.12, D - 0.1), k.toon(0xf07a14)); body.position.set(0, (T - 0.12) / 2, B + D / 2 + 0.05); g.add(body);
          const flat = (z0, z1, mat) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(L, z1 - z0).rotateX(-PI / 2), mat); m.position.set(0, T + 0.0015, B + (z0 + z1) / 2); g.add(m); return m; };
          flat(0, 0.07, k.toon(0xf28a1e));                                   // the orange edge, the storefront's planks
          flat(0.07, 0.085, k.toon(0x5a2a08));                               // the dark brown trim line
          [0.6, 1.4, 2.4].forEach(z => flat(z, z + 0.008, k.toon(0xf6e4c4)));   // faint seams in the cream
          return {
            spots: [V(COUNTER.x, T, COUNTER.row)], row: COUNTER.row, contentScale: COUNTER.scale,
            back: B + 0.03, front: COUNTER.front, minX: -2.4, maxX: 0.6, minScreenX: SPAN.left,
          };
        },
      },
      prep: {
        // The burrito line's plain steel counter (measured: it starts at 62.5% of the picture, under the steam
        // table's front edge). The painted steel is the surface: no slab. The board camera.
        x: 0, line: 0.625, surface: { y: TOP, back: -0.5 },
        cam: { pos: [0.329, 2.573, 3.277], at: [0.329, 1.115, 0.15], fov: 30 },
        build() {
          return { stack: V(-0.04, TOP, 0.06), incoming: V(0.98, TOP + 0.12, 0.15), surface: TOP, giantMax: 1.05 };
        },
        /** A pick here: the base is set down (style), a scoop drops into the band (rice, beans, protein), the bottle
         *  zigzags the sauce on, the salsa cup is set down. The flourishes that follow play from their own hooks. */
        pick(c, e, made) {
          if (!made) return P0();
          const before = without(made, FLOURISH);
          if (e.slot === 'sauce') return sauceOn(c, e, before);
          const b = c.showItem(before);
          if (c.onApply) c.onApply();
          if (!b || k.reduced()) return P0();
          if (e.slot === 'style') return c.drop(b.g, 0.3, 260).then(() => c.pop(b.g));
          if (e.slot === 'salsa' && b.salsa) return c.drop(b.salsa, 0.4, 280);
          const part = b.g.getObjectByName(e.slot);
          if (part) {
            const y = part.position.y;
            return k.tween(300, t => { const e2 = k.ease(t); part.position.y = y + (1 - e2) * 0.28; part.scale.set(1, 0.6 + 0.4 * e2 + Math.sin(t * PI) * 0.15, 1); });
          }
          return c.pop(b.g);
        },
      },
      griddle: {
        // The dark steel griddle (measured: its plate starts at 74.4% of the picture, under the ink line of its back
        // lip). The painted plate is the surface; the page draws the grill press (the tool). The board camera.
        x: 24, line: 0.744, surface: { y: TOP, back: -0.5 }, cook: 'griddle',
        cam: { pos: [0.329, 2.573, 3.277], at: [0.329, 1.115, 0.15], fov: 30 },
        build() { return { plate: V(-0.02, TOP, 0.02), surface: TOP, giantMax: 1.0 }; },
      },
    };
    /** The sauce pick: the bottle comes over, turns and zigzags its sauce along the food, then goes on. */
    function sauceOn(c, e, made) {
      const b = c.showItem(made);
      if (c.onApply && (!b || k.reduced() || e.value === 'noSauce')) c.onApply();
      if (!b || k.reduced()) return P0();
      let D = null;
      b.g.traverse(o => { if (!D && o.userData.drizzle) D = { g: o, d: o.userData.drizzle }; });
      if (!D) return c.pop(b.g);
      const look = k.slotLook('sauce', e.value) || {};
      const bottle = sauceBottle({ ing: e.value, look }).g;
      c.F.add(bottle);
      const at = u => c.toF(D.g, D.d.curve.getPointAt(clamp(u, 0, 1)));
      const lean = PI - 0.5;
      const hold = u => at(u).add(V(0.03, 0.3, 0));
      const from = (c.anchors.incoming || V(1, TOP, 0)).clone().add(V(0.3, 0, 0));
      D.d.grow(0);
      bottle.position.copy(from);
      return k.tween(320, t => { const e2 = k.ease(t); bottle.position.lerpVectors(from, hold(0), e2); bottle.position.y += Math.sin(t * PI) * 0.2; bottle.rotation.z = lean * e2; })
        .then(() => { if (c.onApply) c.onApply(); return k.tween(900, t => { D.d.grow(t); bottle.position.copy(hold(t)); bottle.rotation.x = Math.sin(t * PI * 6) * 0.08; }); })
        .then(() => { D.d.grow(1); const p0 = bottle.position.clone(); return k.tween(300, t => { const e2 = k.ease(t); bottle.rotation.z = lean * (1 - e2); bottle.position.set(p0.x + e2 * 2.4, p0.y + Math.sin(t * PI) * 0.15, p0.z); }); })
        .then(() => { c.F.remove(bottle); k.free(bottle); });
    }

    /* ── the counter: one item at its spot; more side by side, left of the painted queue, at every window shape ── */
    // The page keeps the Back in 5 sign in the bottom-left corner (to 12.5% of the window) and the order left of the
    // counter picture's own painted queue (BBArt.burrito.counter: 56.4% across): world.js hands arrange()
    // anchors.maxScreenX and anchors.lineY. In Node (no anchors from world.js) the shape is 16:9 and the queue 56.4%.
    const SPAN = { left: 0.14, queue: 0.564, gap: 0.1 };
    function windowAspect() {
      const w = typeof innerWidth === 'number' ? innerWidth : 0, h = typeof innerHeight === 'number' ? innerHeight : 0;
      return w > 0 && h > 0 ? w / h : 16 / 9;
    }
    function counterCamera(aspect, lineY) {
      const d = sets.counter, cam = new THREE.PerspectiveCamera(d.cam.fov, aspect, 0.1, 60);
      cam.position.set(d.cam.pos[0], d.cam.pos[1], d.cam.pos[2]);
      cam.lookAt(d.cam.at[0], d.cam.at[1], d.cam.at[2]);
      cam.updateMatrixWorld(); cam.updateProjectionMatrix();
      const want = typeof lineY === 'number' ? lineY : food.lineOnScreen(d.line, aspect, d.picture);
      const dy = food.lensShift(cam, V(d.cam.at[0], d.surface.y, d.surface.back), want);
      cam.view = { enabled: true, fullWidth: 1, fullHeight: 1, offsetX: 0, offsetY: -dy, width: 1, height: 1 };
      cam.updateProjectionMatrix();
      return cam;
    }
    function xAcross(cam, fx2, z) {
      const a = V(0, COUNTER.top, z).project(cam), b = V(1, COUNTER.top, z).project(cam);
      return (fx2 * 2 - 1 - a.x) / (b.x - a.x);
    }
    const counter = {
      /** One item at its spot when it fits there; more (or a giant): side by side in ticket order between the Pause
       *  sign and the painted queue on this window (at the items' near edge), shrunk together only if they do not
       *  fit; world.js then keeps each on the counter top it can see. */
      arrange(n, items, anchors) {
        const aspect = windowAspect(), cam = counterCamera(aspect, anchors.lineY);
        const right = typeof anchors.maxScreenX === 'number' ? anchors.maxScreenX
          : (aspect < food.PICTURE ? 0.5 + (SPAN.queue - 0.5) * food.PICTURE / aspect : SPAN.queue) - 0.006;
        const sizes = items.map(m => {
          const b = k.item(m, { where: 'counter', set: 'counter', contentScale: anchors.contentScale });
          const box = k.boxOf(b.g), sc = b.g.scale.x;
          k.free(b.g);
          return { w: (box.max.x - box.min.x) * sc, mid: (box.min.x + box.max.x) / 2 * sc, near: box.max.z * sc };
        });
        const z = anchors.row + Math.max(...sizes.map(s => s.near));
        const x0 = xAcross(cam, typeof anchors.minScreenX === 'number' ? anchors.minScreenX : SPAN.left, z), x1 = xAcross(cam, right, z);
        const spot = anchors.spots[0];
        if (n === 1 && spot.x + sizes[0].mid - sizes[0].w / 2 >= x0 && spot.x + sizes[0].mid + sizes[0].w / 2 <= x1) return [{ p: spot.clone(), s: 1 }];
        const total = sizes.reduce((t, x) => t + x.w, 0) + SPAN.gap * (n - 1), s = Math.min(1, (x1 - x0) / total);
        let x = x0 + ((x1 - x0) - total * s) / 2;
        return sizes.map(({ w, mid }) => {
          const p = V(x + (w / 2 - mid) * s, COUNTER.top, anchors.row);
          x += (w + SPAN.gap) * s;
          return { p, s };
        });
      },
    };

    const layouts = { burrito: itemLayout, giantBurrito: itemLayout, bowl: itemLayout, tacos: itemLayout, chipsBasket: itemLayout };
    return {
      shapes, sets, cooks, lines, applies, autos, layouts, counter, fx,
      /** Recipe looks name the layout (burrito, bowl, tacos, chipsBasket, giantBurrito); each draws the style picked. */
      layoutOf(made) {
        const s = shapeOfRecipe(made);
        if (layouts[s]) return s;
        if (made.ing === 'burrito' || made.ing === 'tacos' || made.ing === 'bowl' || made.ing === 'chips') return 'burrito';
        return null;
      },
      // Doneness colours by stage for the dial plates (world.colourOf) when a look has no ramp of its own.
      ramps: { burritoBody: TOAST, flourTortilla: TOAST, tacoBody: TACO, softTacos: TACO },
    };
  });
  return food;
});

            const s1 = bg.scale.clone(), r = bg.children[0];
            const r0 = r ? r.rotation.x : 0;
            return k.tween(420, t => {
              const e2 = k.ease(t);
              bg.scale.set(s1.x * (0.85 + 0.15 * e2), s1.y * (0.45 + 0.55 * e2), s1.z * (1.5 - 0.5 * e2));
              if (r) r.rotation.x = r0 + (1 - e2) * -1.4;
            });
          })
          .then(() => { const b = c.showItem(after); return b ? c.pop(b.g) : P0(); });
      },
      /** Each taco flops over its filling, one after another; the holder's rods pop up last. */
      tacoFold(c, e, made) {
        if (pickOf(made, 'style') !== 'tacos') return popIt(c, made);
        if (k.reduced()) { c.showItem(made); return P0(); }
        const b = c.showItem(made, { foldT: 0 });
        if (!b || !b.setFold) { c.showItem(made); return P0(); }
        let p = P0();
        [0, 1, 2].forEach(i => { p = p.then(() => k.tween(300, t => { const e2 = k.ease(t); b.setFold(i, Math.min(1, e2 * 1.08) - Math.max(0, e2 - 0.93)); })); });
        return p.then(() => { if (c.onApply) c.onApply(); const b2 = c.showItem(made); return b2 ? c.pop(b2.g) : P0(); });
      },
      /** The parts slide out of their loose heaps into tidy wedges, then the bowl settles. */
      bowlArrange(c, e, made) {
        if (pickOf(made, 'style') !== 'bowl') return popIt(c, made);
        const b = c.showItem(made);
        if (!b || k.reduced()) return P0();
        const moving = [];
        b.g.traverse(o => { if (o.userData.slideFrom) moving.push({ o, from: o.userData.slideFrom.clone(), p0: o.position.clone() }); });
        moving.forEach(m => m.o.position.copy(m.p0).add(m.from));
        return k.tween(620, t => {
          moving.forEach((m, i) => {
            const u = clamp(t * 1.6 - i * (0.6 / Math.max(1, moving.length)), 0, 1), e2 = k.ease(u);
            m.o.position.copy(m.p0).add(m.from.clone().multiplyScalar(1 - e2));

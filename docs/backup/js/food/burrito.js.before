    }
    /** A hot sauce bottle as the prep shelf paints them: the sauce's colour, a cream label with 1-3 chili marks, a
     *  dark cap. No words. userData.bottle.tip: the nozzle's height. */
    function sauceBottle(part) {
      const L = k.lookFor(part), g = new THREE.Group(), S = 1.15;
      g.add(k.ink(k.lathe([[0, 0], [0.046, 0], [0.05, 0.01], [0.05, 0.13], [0.044, 0.15], [0.02, 0.175], [0.017, 0.2], [0, 0.2]], k.seg(20), S), k.toon(L.colour)));
      g.add(k.ink(k.lathe([[0, 0.195], [0.021, 0.195], [0.022, 0.235], [0.012, 0.245], [0, 0.245]], k.seg(14), S), k.toon(0x2b1a12)));
      const label = new THREE.Mesh(new THREE.CylinderGeometry(0.0515 * S, 0.0515 * S, 0.07 * S, k.seg(20), 1, true), k.toon(0xfff4dc));
      label.position.y = 0.075 * S;
      g.add(label);
      const n = L.chilies || 1;
      for (let i = 0; i < n; i++) {
        const ch = new THREE.Group(), x = (i - (n - 1) / 2) * 0.026 * S;
        const body = k.inkThin(new THREE.SphereGeometry(0.009 * S, 8, 6).scale(1, 2.2, 1), k.toon(0xd8261a));
        body.rotation.z = 0.5;
        const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.003 * S, 0.003 * S, 0.01 * S, 5), k.toon(0x3f8a2a));
        stem.position.set(-0.009 * S, 0.018 * S, 0);

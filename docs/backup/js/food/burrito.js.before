    /* ── the tortilla, the foil, the bowl, the taco holder, the chip boat, the cups ── */
    const TORT = { r: 0.4, t: 0.011 };
    function freckles(g, pts, colour, size) { g.add(scat(PIECE.dot(), colour, pts.map(p => Object.assign(p, { s: size * (0.6 + p.t * 0.7) })), { outline: false })); }
    /** A flat flour tortilla (radius r) at a toast stage: its colour, toasty freckles, and the press stripes. */
    function flatTortilla(r, s, seed, ing) {
      const g = new THREE.Group(), t = TORT.t;
      g.name = 'tortilla';
      g.add(k.ink(k.lathe([[0, 0], [r - 0.006, 0], [r, 0.004], [r - 0.002, t * 0.8], [r - 0.012, t], [0, t]], k.seg(48)), k.toon(tortillaColour(s, ing))));
      const S = { kind: 'disc', r: r * 0.92, y: t + 0.001 };
      freckles(g, k.sample(S, k.thin(Math.round(22 * (r / 0.4) ** 2) + 4, 6), seed + ':fr'), k.mix(tortillaColour(s, ing), 0x8a5a24, 0.35), r < 0.25 ? 0.4 : 0.55);
      stripesFlat(g, r, s, t + 0.0015, seed);
      return { g, h: t };
    }
    /** Straight press stripes across a flat disc (cut to its edge) and the stage's crisp marks. */
    function stripesFlat(g, r, s, y, seed) {
      const [n, col, th] = STRIPES[s];
      for (let i = 0; i < n; i++) {
        const x = (i - (n - 1) / 2) * r * 1.5 / Math.max(n, 2), half = Math.sqrt(Math.max(0, r * r - x * x)) * 0.86;
        const bar = new THREE.Mesh(new THREE.BoxGeometry(th * 2.2, th * 0.5, half * 2), k.toon(col));
        bar.position.set(x, y, 0); bar.rotation.y = 0.35;
        g.add(bar);
      }
      if (s >= 2) freckles(g, k.sample({ kind: 'disc', r: r * 0.85, y: y + 0.0005 }, s === 2 ? 8 : 14, seed + ':ts'), s >= 4 ? 0x120a06 : 0x7a4418, r < 0.25 ? 0.5 : 0.7);
    }
    /** A square of foil with a few crinkle lines. */
    function foilSheet(w, d, seed) {
      const g = new THREE.Group();
      const sheet = new THREE.Mesh(new THREE.BoxGeometry(w, 0.005, d), k.toon(C.foil));
      sheet.position.y = 0.0025;
      g.add(sheet);
      const R = k.rand(seed + ':foil');
      for (let i = 0; i < 7; i++) {
        const m = new THREE.Mesh(new THREE.BoxGeometry(w * (0.12 + R() * 0.16), 0.002, 0.006), i % 2 ? k.toon(0xf2f5f7) : k.toon(C.foilDark));
        m.position.set((R() - 0.5) * w * 0.5, 0.0055, (R() - 0.5) * d * 0.7); m.rotation.y = (R() - 0.5) * 1.0;
        g.add(m);
      }
      return g;
    }
    /** The bowl: orange outside with a green stripe under the rim, cream inside; its floor at BOWL.floor. */
    const BOWL = { r: 0.37, h: 0.11, floor: 0.03 };
    const BOWL_IN = [[0, 0.03], [0.2, 0.03], [0.27, 0.055], [0.337, 0.102]];
    function innerY(rr) {
      if (rr <= BOWL_IN[1][0]) return BOWL.floor;
      for (let i = 2; i < BOWL_IN.length; i++) { const [r0, y0] = BOWL_IN[i - 1], [r1, y1] = BOWL_IN[i]; if (rr <= r1) return y0 + (y1 - y0) * (rr - r0) / (r1 - r0); }
      return BOWL_IN[BOWL_IN.length - 1][1];
    }
    function bowlVessel() {
      const g = new THREE.Group();
      g.name = 'bowl';
      g.add(k.ink(k.lathe([[0, 0], [0.2, 0], [0.215, 0.008], [0.3, 0.06], [0.352, 0.098], [0.37, 0.11]], k.seg(48)), k.toon(C.orange)));
      g.add(k.ink(k.lathe([[0.37, 0.11], [0.356, 0.116], [0.337, 0.102], [0.27, 0.055], [0.2, 0.03], [0, 0.03]], k.seg(48)), k.toon(0xfff1dc), true));
      g.add(k.inkThin(k.lathe([[0.3205, 0.075], [0.345, 0.093]], k.seg(48)).scale(1.012, 1, 1.012), k.toon(C.green)));
      const rim = k.inkThin(new THREE.TorusGeometry(0.364, 0.007, 6, k.seg(48)).rotateX(PI / 2), k.toon(0xf28a3a));
      rim.position.y = 0.112;
      g.add(rim);
      return { g, h: BOWL.floor, top: BOWL.h };
    }
    /** The taco holder: a steel tray; with V rods for each taco once they are folded. */
    const TACOS = { r: 0.16, xs: [-0.36, 0, 0.36], tray: 0.016 };
    function tacoTray(rods) {
      const g = new THREE.Group();
      g.name = 'holder';
      const plate = k.ink(new THREE.BoxGeometry(1.12, TACOS.tray, 0.38), k.toon(C.steel));
      plate.position.y = TACOS.tray / 2;
      g.add(plate);
      [[0, 0.19, 1.12, 0], [0, -0.19, 1.12, 0]].forEach(([x, z, len]) => { const lip = k.inkThin(new THREE.BoxGeometry(len, 0.02, 0.012), k.toon(0xc9d0d6)); lip.position.set(x, TACOS.tray + 0.006, z); g.add(lip); });
      if (rods) {
        // a steel cradle hugging each folded shell near its ends (the holder's zigzag)
        const kap = (PI / 2 + 0.12) / TACOS.r, rodGeo = kept('cradle', () => {
          const pts = [];
          for (let i = 0; i <= 16; i++) { const th = -1.05 + 2.1 * i / 16; pts.push(V(0, (1 - Math.cos(th)) / kap + 0.004 - 0.008 * Math.cos(th), Math.sin(th) / kap + 0.008 * Math.sin(th))); }
          return new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 24, 0.0055, 6, false);
        });
        TACOS.xs.forEach(x => [-0.1, 0.1].forEach(dx => { const m = k.inkThin(rodGeo, k.toon(0xc9d0d6)); m.position.set(x + dx, TACOS.tray, 0); g.add(m); }));
      }
      return g;
    }
    /** A folded (or folding) soft taco shell: t 0 lies flat, t 1 is the half-moon U, open at the top. Its own
     *  geometry (it is animated). setFold(t). */
    function tacoShell(r, colour) {
      const NU = k.low() ? 12 : 18, NS = k.low() ? 8 : 12, pos = [], idx = [];
      for (let j = 0; j <= NS; j++) for (let i = 0; i <= NU; i++) pos.push(0, 0, 0);
      for (let j = 0; j < NS; j++) for (let i = 0; i < NU; i++) { const a = j * (NU + 1) + i, b = a + 1, c = a + NU + 1, d = c + 1; idx.push(a, c, b, b, c, d); }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
      geo.setIndex(idx);
      const mesh = new THREE.Mesh(geo, k.toon(colour, { side: THREE.DoubleSide }));
      const setFold = t => {
        const kappa = t * (PI / 2 + 0.12) / r, p = geo.attributes.position;
        for (let j = 0; j <= NS; j++) for (let i = 0; i <= NU; i++) {
          const u = -r + 2 * r * i / NU, w = Math.sqrt(Math.max(0, r * r - u * u)) * 0.999, v = -w + 2 * w * j / NS;
          let y = 0, z = v;
          if (kappa > 1e-5) { y = (1 - Math.cos(kappa * v)) / kappa; z = Math.sin(kappa * v) / kappa; }
          p.setXYZ(j * (NU + 1) + i, u, y + 0.004, z);
        }
        p.needsUpdate = true;
        geo.computeVertexNormals();
        geo.computeBoundingBox();
        geo.computeBoundingSphere();
      };
      setFold(1);
      return { mesh, geo, setFold };
    }
    /** The checked paper boat the chips come in. */
    const CHECKS = {};
    function checker(cols, rows) {
      const key = cols + 'x' + rows;
      if (CHECKS[key]) return CHECKS[key];
      const data = new Uint8Array(cols * rows * 4);
      for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
        const red = (x + y) % 2 === 0, i = (y * cols + x) * 4;
        data[i] = red ? 0xd0 : 0xff; data[i + 1] = red ? 0x2c : 0xfa; data[i + 2] = red ? 0x20 : 0xf2; data[i + 3] = 255;
      }
      const t = new THREE.DataTexture(data, cols, rows, THREE.RGBAFormat);
      t.minFilter = t.magFilter = THREE.NearestFilter;
      t.colorSpace = THREE.SRGBColorSpace;
      t.needsUpdate = true;
      return (CHECKS[key] = new THREE.MeshToonMaterial({ color: 0xffffff, map: t, gradientMap: k.toon(0xffffff).gradientMap }));
    }
    const BOAT = { w: 0.44, d: 0.3, h: 0.07 };
    function boat() {
      const g = new THREE.Group(), t = 0.01;
      g.name = 'boat';
      const floor = k.ink(new THREE.BoxGeometry(BOAT.w, t, BOAT.d), k.toon(0xfaf4ea));
      floor.position.y = t / 2;
      g.add(floor);
      [[0, BOAT.d / 2, BOAT.w, 0, 9], [0, -BOAT.d / 2, BOAT.w, PI, 9], [BOAT.w / 2, 0, BOAT.d, -PI / 2, 6], [-BOAT.w / 2, 0, BOAT.d, PI / 2, 6]].forEach(([x, z, len, turn, cols]) => {
        const w = new THREE.Group(), side = k.ink(new THREE.BoxGeometry(len, BOAT.h, t), checker(cols, 2));
        side.position.y = BOAT.h / 2;
        w.add(side); w.position.set(x, t, z); w.rotation.y = turn; w.rotateX(0.32);
        g.add(w);
      });
      return { g, h: t, top: BOAT.h + t };
    }
    /** A small round paper cup with something in it (salsa, guacamole). */
    function cup(fillColour, scale, surface) {
      const g = new THREE.Group(), s = scale || 1;
      const geo = k.lathe([[0, 0], [0.06, 0], [0.064, 0.004], [0.08, 0.068], [0.086, 0.072], [0.076, 0.074], [0.072, 0.064], [0.056, 0.01], [0, 0.01]], k.seg(18), s).toNonIndexed();
      geo.computeVertexNormals();
      g.add(k.ink(geo, k.toon(0xfbfaf4)));
      const f = k.fill([[0.056 * s, 0.01 * s], [0.073 * s, 0.062 * s]], 0.9, fillColour, surface !== undefined ? { seg: 18, surface } : { seg: 18 });
      g.add(f.g);
      return { g, h: 0.074 * s, surface: f.h, r: f.r };
    }
    /** The salsa in its cup: chunky (tomato or tomatillo or mango cubes, onion bits, cilantro). */
    function salsaCup(part) {
      const L = k.lookFor(part), c = cup(k.mix(L.colour, 0x000000, 0.1), 1.15, k.mix(L.colour, 0x000000, 0.04)), seed = 'salsa:' + part.ing;
      c.g.name = 'salsa';
      const S = { kind: 'disc', r: c.r * 0.8, y: c.surface + 0.004 };
      c.g.add(scat(PIECE.dice(), part.ing === 'mangoSalsa' ? 0xffb21a : k.mix(L.colour, 0xffffff, 0.12), k.sample(S, k.thin(12, 7), seed + ':a').map(p => Object.assign(p, { s: 0.75 })), { tilt: 0.8 }));
      c.g.add(scat(PIECE.bit(), part.ing === 'mangoSalsa' ? 0xb8325a : 0xf6f2e6, k.sample(S, k.thin(8, 4), seed + ':b').map(p => Object.assign(p, { s: 0.75 })), { tilt: 0.8 }));
      c.g.add(scat(PIECE.dot(), 0x2f7a22, k.sample(Object.assign({}, S, { y: S.y + 0.006 }), k.thin(8, 4), seed + ':c').map(p => Object.assign(p, { s: 0.35 })), { outline: false }));
      const glint = new THREE.Mesh(kept('cglint', () => new THREE.CircleGeometry(0.012, 8).rotateX(-PI / 2)), k.SHINE);
      glint.position.set(-0.03, c.surface + 0.003, -0.025);
      c.g.add(glint);
      c.g.userData.part = part;
      return { g: c.g, h: c.h + 0.01 };
    }
    /** A lime wedge: pale green flesh, dark green rind, standing on its rind. */
    function limeWedge(part) {
      const L = k.lookFor(part), g = new THREE.Group();
      g.name = 'lime';
      const geo = kept('lime', () => {
        const sh = new THREE.Shape();
        sh.moveTo(-0.07, 0);
        sh.absarc(0, 0, 0.07, PI, 0, true);
        sh.lineTo(-0.07, 0);
        const e = new THREE.ExtrudeGeometry(sh, { depth: 0.04, bevelEnabled: true, bevelThickness: 0.006, bevelSize: 0.006, bevelSegments: 2, curveSegments: 10 });
        e.translate(0, 0, -0.02);
        e.rotateX(PI);                        // the round rind down, the flat flesh up
        return e;
      });
      const m = k.ink(geo, [k.toon(0xd6f08e), k.toon(L.colour !== undefined ? k.mix(L.colour, 0x2a6a12, 0.35) : 0x4f9a2a)]);
      m.position.y = 0.07;
      g.add(m);
      // a paler middle and the segment lines on the flesh face (toward the viewer)
      const face = new THREE.Mesh(kept('limeFace', () => new THREE.CircleGeometry(0.045, 12, PI, PI)), k.toon(0xeefac0));
      face.position.set(0, 0.07, 0.0275);
      g.add(face);
      for (let i = 1; i < 4; i++) {
        const a = PI + PI * i / 4, l = new THREE.Mesh(kept('limeSeg', () => new THREE.BoxGeometry(0.052, 0.003, 0.001).translate(0.026, 0, 0)), k.toon(0xbfe07a));
        l.position.set(0, 0.07, 0.0285); l.rotation.z = a;
        g.add(l);
      }
      const wrap = new THREE.Group();
      wrap.add(g);
      wrap.userData.part = part;
      return { g: wrap, h: 0.076 };
    }

    /* ── the rolled burrito ── */
    const ROLL = { L: 0.72, R: 0.136, sq: 0.86, cut: 0.62, foil: 0.47 };
    const ca = Math.cos(ROLL.cut), sa = Math.sin(ROLL.cut), ta = Math.tan(ROLL.cut);
    const YC = ROLL.R * ROLL.sq, CX = ROLL.L / 2 - YC * ta - 0.004;      // the bias cut's plane: through (CX, YC), facing up and +x
    function rollProfile(R, Lp) {
      const pts = [[0, 0], [R * 0.45, 0.004], [R * 0.74, 0.02], [R * 0.9, 0.042], [R * 0.98, 0.072], [R, 0.105]];
      for (let s = 0.135; s < Lp - 0.012; s += 0.026) pts.push([R * (1 + 0.022 * Math.sin(s * 21)), s]);
      pts.push([R, Lp]);
      return pts;
    }
    const PROFILE = rollProfile(ROLL.R, ROLL.L);
    /** A point on (or dr off) the roll's surface: s along it from the closed end, phi round it (0 faces +z, -pi/2 is
     *  the top). The burrito's own frame: along x, centred, resting on y = 0. */
    function rollPoint(s, phi, dr) {
      const r = k.radiusAt(PROFILE, s) + (dr || 0);
      return V(s - ROLL.L / 2, YC - r * Math.sin(phi) * ROLL.sq, r * Math.cos(phi));
    }
    const beyondCut = (p, shift) => (p.x - CX) * ca + (p.y - YC) * sa + (shift || 0) > 0;
    /** The lathe of a roll layer (the tortilla, a second tortilla, the foil), turned into the burrito's frame and cut
     *  on the bias at the open end (shift: the cut moved back along its normal). */
    function rollGeo(key, pts, shift, crinkle) {
      return kept('roll:' + key + ':' + (k.low() ? 'lo' : 'hi'), () => {
        const geo = k.lathe(pts, k.seg(30));
        const p = geo.attributes.position, last = pts[pts.length - 1][1];
        if (crinkle) for (let i = 0; i < p.count; i++) {
          const x = p.getX(i), y = p.getY(i), z = p.getZ(i), a = Math.atan2(x, z);
          const m = 1 + crinkle * k.noise(a * 1.7 + y * 31, 2.3);
          p.setX(i, x * m); p.setZ(i, z * m);
          if (Math.abs(y - last) < 1e-6) p.setY(i, y + 0.014 * k.noise(a * 2.3, 1.1));
        }
        geo.rotateZ(-PI / 2);
        geo.translate(-ROLL.L / 2, 0, 0);
        geo.scale(1, ROLL.sq, 1);
        geo.translate(0, YC, 0);
        for (let i = 0; i < p.count; i++) {
          const v = V(p.getX(i), p.getY(i), p.getZ(i)), d = (v.x - CX) * ca + (v.y - YC) * sa + (shift || 0);
          if (d > 0) p.setX(i, v.x - d / ca);
        }
        geo.computeVertexNormals();
        return geo;
      });
    }
    /** A flat shape in the bias cut's plane: geometry built in xy (x across the burrito, y up the cut), mapped on. */
    function onCut(geo, shift) {
      const p = geo.attributes.position, o = (shift || 0) / ca;
      for (let i = 0; i < p.count; i++) {
        const px = p.getX(i), py = p.getY(i) * ROLL.sq;
        p.setXYZ(i, CX - py * ta - o, YC + py, -px);
      }
      geo.computeVertexNormals();
      return geo;
    }
    const CUT_N = [ca, sa, 0];
    /** What the fillings look like cut across: the colours of what went in, in a disc. */
    function crossSection(made, parts, seed, rIn, shift) {
      const g = new THREE.Group();
      g.name = 'cut';
      const look = id => { const p = parts.find(q => q.ing === id || q.slot === id); return p ? k.lookFor(p) : null; };
      const baseCol = (look('rice') && look('rice').colour) || (look('beans') && look('beans').colour) || 0xe9d2a2;
      g.add(new THREE.Mesh(onCut(new THREE.CircleGeometry(rIn, k.seg(24)), (shift || 0) + 0.0015), k.toon(k.mix(baseCol, 0x8a6a40, 0.08))));
      const R = k.rand(seed + ':cut'), out = (id, piece, colour, n, size) => {
        if (n <= 0) return;
        const pts = [];
        for (let i = 0; i < n; i++) {
          const a = R() * PI * 2, rr = Math.sqrt(R()) * rIn * 0.82, px = Math.cos(a) * rr, py = Math.sin(a) * rr * ROLL.sq;
          const q = V(CX - py * ta - (shift || 0) / ca, YC + py, -px).add(V(CUT_N[0], CUT_N[1], 0).multiplyScalar(0.003));
          pts.push({ p: [q.x, q.y, q.z], nrm: CUT_N, r: R() * PI * 2, t: R(), s: size || 1 });
        }
        g.add(scat(piece(), colour, pts, { outline: 'thin', tilt: 0.4 }));
      };
      parts.forEach(p => {
        const L = k.lookFor(p), sh = L.shape;
        if (sh === 'rice') out('rice', PIECE.rice, L.colour, k.thin(26, 12), 1.1);
        else if (sh === 'beans') out('beans', PIECE.bean, L.colour, 9, 1);
        else if (sh === 'chickenPieces' || sh === 'steakPieces') out('protein', PIECE.cube, L.colour, 5, 0.75);
        else if (sh === 'grilledVeggies') { out('veg', PIECE.dice, 0x3f8f2e, 3, 1); out('veg2', PIECE.dice, 0xd8372a, 3, 1); }
        else if (sh === 'shreddedCheese') out('cheese', () => k.piece('shred'), L.colour, 7, 0.8);
        else if (sh === 'shreddedLettuce') out('lettuce', PIECE.ribbon, L.colour, 4, 0.9);
        else if (sh === 'pico') out('pico', PIECE.dice, L.colour, 5, 0.8);
        else if (sh === 'cornKernels') out('corn', PIECE.kernel, L.colour, 6, 0.9);
        else if (sh === 'sourCream') out('sc', PIECE.dot, L.colour, 3, 0.9);
        else if (sh === 'guacamole') out('guac', PIECE.dot, L.colour, 3, 1.1);
        else if (sh === 'jalapenoRings') out('jal', PIECE.ring, L.colour, 2, 0.6);
      });
      return g;
    }
    /** Press stripes across the roll's top, between s0 and s1 along it, and the stage's crisp marks. */
    function stripesRoll(g, s, s0, s1, dr, seed) {
      const [n, col, th] = STRIPES[s];
      for (let i = 0; i < n; i++) {
        const sAt = s0 + (s1 - s0) * (i + 0.5) / n, pts = [];
        for (let j = 0; j <= 14; j++) {
          const th2 = -1.25 + 2.5 * j / 14, p = rollPoint(sAt + th2 * 0.02, -PI / 2 + th2, dr + 0.0015);
          if (!beyondCut(p, 0.006)) pts.push(p);
        }
        if (pts.length < 3) continue;
        const tube = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 20, th, 5, false), k.toon(col));
        tube.scale.set(1, 1, 1);
        g.add(tube);
      }
    }
    /** Points on the roll's exposed upper surface (for freckles, toasty spots, blisters). */
    function rollSpots(n, s0, s1, dr, seed, lift) {
      const R = k.rand(seed), out = [];
      for (let i = 0, tries = 0; out.length < n && tries < n * 6; tries++) {
        const sAt = s0 + (s1 - s0) * R(), phi = -PI / 2 + (R() - 0.5) * 2.6, p = rollPoint(sAt, phi, dr + (lift || 0.0015));
        if (beyondCut(p, 0.01)) continue;
        const nrm = V(0, -Math.sin(phi), Math.cos(phi)).normalize();
        out.push({ p: [p.x, p.y, p.z], nrm: [nrm.x, nrm.y, nrm.z], r: R() * PI * 2, t: R() });
        i++;
      }
      return out;
    }
    /** The wrapped burrito: { g, h }. o.where 'griddle' draws it bare (it toasts out of its foil). */
    function rolled(made, parts, s, o) {
      const g = new THREE.Group(), seed = (made.recipe || 'b') + ':roll', burst = has(made, 'burst'), inFoil = !(o && o.where === 'griddle');
      g.name = 'burrito';
      const col = tortillaColour(s, 'burrito'), dr2 = burst ? 0.013 : 0;
      const body = k.ink(rollGeo('body', PROFILE, 0, 0), k.toon(col));
      body.name = 'tortilla';
      g.add(body);
      // the cut end: the tortilla's edge (a ring), the fillings inside
      const ring = new THREE.Mesh(onCut(new THREE.RingGeometry(ROLL.R - 0.013, ROLL.R, k.seg(30), 1), 0.0008), k.toon(k.mix(col, 0xb08a50, 0.15)));
      g.add(ring);
      g.add(crossSection(made, parts, seed, ROLL.R - 0.013, 0));
      // the closed end's folds: three creases where the tortilla was tucked in
      [-0.6, 0.15, 0.9].forEach((phi, i) => {
        const pts = [0.012, 0.03, 0.055, 0.085].map(sAt => rollPoint(sAt, phi - PI / 2 + i * 0.1, 0.002));
        g.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 10, 0.003, 4, false), k.toon(k.mix(col, 0x6a4a28, 0.45))));
      });
      let outer = null;
      if (burst) {
        // the second tortilla, a little fatter and a little shorter: the first one's edge peeks out of it
        const OP = rollProfile(ROLL.R + 0.013, ROLL.L);
        outer = new THREE.Group();
        outer.name = 'outer';
        outer.add(k.ink(rollGeo('outer', OP, 0.026, 0), k.toon(k.mix(col, 0xffffff, 0.05))));
        outer.add(new THREE.Mesh(onCut(new THREE.RingGeometry(ROLL.R + 0.001, ROLL.R + 0.013, k.seg(30), 1), 0.0268), k.toon(k.mix(col, 0xb08a50, 0.12))));
        g.add(outer);
      }
      const sFrom = inFoil ? ROLL.foil * ROLL.L : 0.02;
      stripesRoll(outer || g, s, sFrom + 0.02, ROLL.L - 0.02, dr2, seed);
      freckles(outer || g, rollSpots(k.thin(18, 8), sFrom, ROLL.L, dr2, seed + ':fr', 0.0015), k.mix(col, 0x8a5a24, 0.35), 0.4);
      if (s >= 2) freckles(outer || g, rollSpots(s === 2 ? 8 : 14, sFrom, ROLL.L, dr2, seed + ':ts', 0.002), s >= 4 ? 0x120a06 : 0x7a4418, 0.5);
      if (s >= 3) {
        // blistered, crisp: dark bubbles along the top and round the cut edge
        const bl = rollSpots(s === 3 ? 12 : 18, sFrom, ROLL.L, dr2, seed + ':bl', 0.001).map(p => Object.assign(p, { s: 0.8 + p.t * 0.5 }));
        (outer || g).add(scat(PIECE.blister(), s >= 4 ? 0x1a0e08 : 0x8a4a1a, bl, { outline: false }));
      }
      if (inFoil) {
        const FP = rollProfile(ROLL.R + 0.009 + dr2, ROLL.foil * ROLL.L);
        const foil = k.ink(rollGeo('foil' + (burst ? 'b' : ''), FP, 0, 0.045), k.toon(C.foil));
        foil.name = 'foil';
        g.add(foil);
        [0.08, 0.17, 0.24].forEach((sAt, i) => {
          const pts = [-0.9, -0.5, -0.1].map(phi => rollPoint(sAt, phi - 0.4 * i, 0.012 + dr2));
          g.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 8, 0.004, 4, false), k.SHINE));
        });
      }
      if (burst && inFoil) {
        // the spill: a scrap of foil in front with beans, rice and a smear of sour cream on it
        const spill = new THREE.Group();
        spill.name = 'spill';
        const sheet = new THREE.Mesh(kept('scrap', () => {
          const sh = new THREE.Shape(), R = k.rand('scrap');
          for (let i = 0; i < 9; i++) { const a = i / 9 * PI * 2, r = 0.11 * (0.8 + R() * 0.35); if (!i) sh.moveTo(Math.cos(a) * r * 1.5, Math.sin(a) * r); else sh.lineTo(Math.cos(a) * r * 1.5, Math.sin(a) * r); }
          sh.closePath();
          return new THREE.ShapeGeometry(sh).rotateX(-PI / 2);
        }), k.toon(C.foil));
        sheet.position.y = 0.002;
        spill.add(sheet);
        const smear = new THREE.Mesh(kept('smear', () => new THREE.SphereGeometry(0.04, 12, 6, 0, PI * 2, 0, PI / 2).scale(1.4, 0.25, 0.8)), k.toon(0xfbf8ef));
        smear.position.set(0.05, 0.003, 0.01);
        spill.add(smear);
        const bean = parts.find(p => k.lookFor(p).shape === 'beans'), riceP = parts.find(p => k.lookFor(p).shape === 'rice');
        if (bean) spill.add(scat(PIECE.bean(), k.lookFor(bean).colour, [[-0.08, 0.02], [-0.04, -0.03], [-0.1, -0.02], [0.0, 0.04]].map(([x, z], i) => ({ p: [x, 0.008, z], nrm: [0, 1, 0], r: i * 1.3, t: 0.5 })), { tilt: 0.3 }));
        if (riceP) spill.add(scat(PIECE.rice(), k.lookFor(riceP).colour, [[-0.02, 0.0], [-0.06, 0.05], [0.1, -0.03], [-0.12, 0.03], [0.02, -0.04]].map(([x, z], i) => ({ p: [x, 0.006, z], nrm: [0, 1, 0], r: i * 2.1, t: 0.5 })), { tilt: 0.3 }));
        spill.position.set(0.1, 0, 0.21);
        g.add(spill);
      }
      if (s >= 4) smoke(g, 0.26);
      return { g, h: (ROLL.R + dr2) * 2 * ROLL.sq + 0.01, outer };
    }
    /** Burnt: dark smoke rising off it (it sits still with Motion Reduced). */
    function smoke(g, top) {
      for (let i = 0; i < 3; i++) {
        const p = k.puff(0x4f4a48, 0.85);
        p.scale.setScalar(1.6);
        p.position.set((i - 1) * 0.16, top + 0.05 + (i % 2) * 0.05, 0);
        g.add(p);
        k.spin(p, 'rise', { phase: i * 0.6, alpha: 0.85, height: 0.3 });
      }
    }
    /** The giant's pennant: a toothpick with a red flag and a flame on it (no words). */
    function pennant() {
      const g = new THREE.Group();
      g.name = 'pennant';
      const stick = k.inkThin(k.cyl(0.0045, 0.2, 6), k.toon(0xe8d2a0));
      stick.position.y = 0.1;
      const flag = new THREE.Mesh(kept('flag', () => { const s = new THREE.Shape(); s.moveTo(0, 0); s.lineTo(0.11, -0.022); s.lineTo(0, -0.05); s.closePath(); return new THREE.ShapeGeometry(s); }), k.toon(0xd8261a, { side: THREE.DoubleSide }));
      flag.position.set(0.004, 0.198, 0.001);
      const flame = new THREE.Mesh(kept('flame', () => { const s = new THREE.Shape(); s.moveTo(0, 0); s.quadraticCurveTo(0.016, 0.01, 0.008, 0.03); s.quadraticCurveTo(0.004, 0.018, -0.002, 0.024); s.quadraticCurveTo(-0.014, 0.012, 0, 0); return new THREE.ShapeGeometry(s); }), k.toon(0xffc21a, { side: THREE.DoubleSide }));
      flame.position.set(0.028, 0.164, 0.003);
      g.add(stick, flag, flame);
      return g;
    }

    /* ── layouts ── */
    /** The parts, as k.sequence gives them, without the style (the vessel) and with what each slot is. */
    function fillings(made, o) {
      const seq = k.sequence(made, o);
      return seq.parts.filter(p => p.slot !== 'style');
    }
    /** Build one filling part on a region (by its shape), with the kit (so a gross-out's fx land on it). */
    const BASE = { rice: 1, beans: 1 };
    function onRegion(part, Rg, o, extra) {
      return k.food(part, Object.assign({}, o, { region: Rg }, extra || {}));
    }
    /** The burrito: flat on its foil with the band of fillings, or rolled once `wrap` is in made.auto. */
    function burritoLayout(made, o) {
      o = o || {};
      const s = toastIndex(made, o), parts = fillings(made, o), g = new THREE.Group();
      let h;
      if (has(made, 'wrap') || o.where === 'griddle') {
        const b = rolled(made, parts, s, o);
        g.add(b.g);
        h = b.h;
        // a slight turn: the cut end faces the viewer
        b.g.rotation.y = -0.42;
      } else {
        const seed = (made.recipe || 'b') + ':flat';
        const sheet = foilSheet(0.9, 0.86, seed);
        sheet.rotation.y = 0.06;
        g.add(sheet);
        const t = flatTortilla(TORT.r, s, seed, 'burrito');
        t.g.position.y = 0.005;
        g.add(t.g);
        const y0 = 0.005 + TORT.t, G = ground(() => y0);
        const W = { base: [0.3, 0.12], top: [0.29, 0.11] };
        let top = y0;
        parts.forEach((p, i) => {
          const sh = k.lookFor(p).shape, base = sh === 'rice' || sh === 'beans';
          const Rg = base && sh === 'beans' ? band(G, 0, 0, 0.28, 0.105, ':' + i) : base ? band(G, 0, 0, W.base[0], W.base[1], ':' + i) : band(G, 0, 0, W.top[0], W.top[1], ':' + i);
          const b = onRegion(Object.assign({ n: i }, p), Rg, o, { item: made, stage: s });
          if (BASE[p.slot]) b.g.name = p.slot;
          else if (p.slot) b.g.name = p.slot;
          g.add(b.g);
          top = Math.max(top, b.h);
        });
        h = top;
      }
      if (k.giant(made) > 1 || shapeOfRecipe(made) === 'giantBurrito') {
        const pn = pennant();
        if (has(made, 'wrap') || o.where === 'griddle') { pn.position.set(-0.08, ROLL.R * 2 * ROLL.sq - 0.02, 0.02); pn.rotation.z = 0.15; }
        else pn.position.set(-0.32, 0.01, -0.2);
        g.add(pn);
        h = Math.max(h, pn.position.y + 0.2);
      }
      const sc = o.contentScale || 1;
      if (sc !== 1) g.scale.multiplyScalar(sc);
      return { g, h: h * sc };
    }
    const shapeOfRecipe = made => { const R = made && made.recipe && (k.pack().recipes || {})[made.recipe]; return R && R.look && R.look.shape; };
    /** Where a part's loose heap sits in the bowl before `arrange` (seeded by what it is). */
    function looseSpot(id, i) {
      const R = k.rand('loose:' + id), a = i * 2.4 + R() * 0.8, rr = 0.07 + R() * 0.13;
      return [Math.cos(a) * rr, Math.sin(a) * rr];
    }
    /** The bowl: loose heaps, or once arranged every part its own wedge, nothing touching; the sauce across. */
    function bowlLayout(made, o) {
      o = o || {};
      const parts = fillings(made, o), g = new THREE.Group(), v = bowlVessel(), arranged = has(made, 'arrange');
      g.add(v.g);
      const G = ground((x, z) => innerY(Math.hypot(x, z))), from = {};
      const solid = parts.filter(p => k.lookFor(p).shape !== 'hotSauce');
      const sauce = parts.find(p => k.lookFor(p).shape === 'hotSauce');
      let top = BOWL.h;
      if (arranged) {
        const N = Math.max(1, solid.length), step = PI * 2 / N, gap = N > 1 ? 0.016 : 0;
        solid.forEach((p, i) => {
          const a0 = -PI / 2 - step / 2 + i * step, a1 = a0 + step;
          const Rg = N === 1 ? heapAt(G, 0, 0, 0.26, ':' + i) : wedge(G, a0, a1, 0.035, 0.285, gap, ':' + i);
          const b = onRegion(Object.assign({ n: i }, p), Rg, o, { item: made, ringScale: 0.9, dollops: 1, dollopScale: 1.35, scoops: 1, scoopScale: 1.4, share: 1, heap: 0.05, dense: 2.2 });
          if (p.slot) b.g.name = p.slot;
          const [lx, lz] = looseSpot(p.ing, i), am = (a0 + a1) / 2;
          from[p.slot || p.ing] = V(lx - Math.cos(am) * 0.16, 0, lz - Math.sin(am) * 0.16);
          b.g.userData.slideFrom = from[p.slot || p.ing];
          g.add(b.g);
          top = Math.max(top, b.h);
        });
      } else {
        solid.forEach((p, i) => {
          const sh = k.lookFor(p).shape;
          let Rg;
          if (sh === 'rice') Rg = heapAt(G, 0, 0, 0.29, ':' + i);
          else if (sh === 'beans') Rg = heapAt(G, 0.06, 0.03, 0.2, ':' + i);
          else { const [x, z] = looseSpot(p.ing, i); Rg = heapAt(G, x, z, 0.11, ':' + i); }
          const b = onRegion(Object.assign({ n: i }, p), Rg, o, { item: made, dollops: 1, dollopScale: 1.2, scoops: 1, scoopScale: 1.2, heap: sh === 'rice' ? 0.035 : 0.045, dense: 2 });
          if (p.slot) b.g.name = p.slot;
          g.add(b.g);
          top = Math.max(top, b.h);
        });
      }
      if (sauce) {
        const b = onRegion(Object.assign({ n: solid.length }, sauce), band(G, 0, 0, 0.25, 0.2, ':sauce'), o, { item: made, onFood: true, turns: 6 });
        b.g.name = 'sauce';
        g.add(b.g);
        top = Math.max(top, b.h);
      }
      const sc = o.contentScale || 1;
      if (sc !== 1) g.scale.multiplyScalar(sc);
      return { g, h: top * sc, from };
    }
    /** The tacos: three on the holder, open (fillings in a strip) or folded into half-moons in the V rods; on the
     *  griddle, three pressed half-moons in a row. setFold(i, t) folds one (the flourish). */
    const PROTEIN = { chickenPieces: 1, steakPieces: 1, grilledVeggies: 1 };
    function tacosLayout(made, o) {
      o = o || {};
      const parts = fillings(made, o), s = toastIndex(made, o), g = new THREE.Group(), seed = (made.recipe || 't') + ':taco';
      const col = tortillaColour(s, 'tacos'), folded = has(made, 'fold'), griddle = o.where === 'griddle';
      if (griddle) {
        TACOS.xs.forEach((x, i) => g.add(pressed(parts, s, col, seed + i, x)));
        if (s >= 4) smoke(g, 0.06);
        return { g, h: 0.05 };
      }
      g.add(tacoTray(folded && o.foldT === undefined));
      const shells = [], fills = [];
      let top = 0.1;
      TACOS.xs.forEach((x, ti) => {
        const T = new THREE.Group();
        T.position.set(x, TACOS.tray, 0);
        T.name = 'taco' + ti;
        const sh = tacoShell(TACOS.r, col);
        T.add(sh.mesh);
        // the stripes and the toast spots lie on the shell: drawn on the flat disc's coordinates, mapped with it
        const marks = new THREE.Group();
        T.add(marks);
        const G = ground(() => 0.006), F = new THREE.Group();
        F.name = 'fillings';
        parts.forEach((p, i) => {
          const b = onRegion(Object.assign({ n: i }, p), band(G, 0, 0, 0.105, 0.042, ':' + ti + ':' + i), o, Object.assign({ item: made, share: 1 / 3, rings: 2, ringScale: 0.85, dollops: 1, dollopScale: 0.6, scoops: 1, scoopScale: 0.6, sauceR: 0.006, turns: 4, salt: 't' + ti },
            PROTEIN[k.lookFor(p).shape] ? { heap: 0.026, dense: 1.4 } : { dense: 2.2 }));
          F.add(b.g);
        });
        T.add(F);
        const set = t => {
          sh.setFold(t);
          F.position.y = 0.03 * t; F.scale.set(1, 1, 1 - 0.35 * t);
          tacoMarks(marks, s, t, seed + ti);
        };
        set(o.foldT !== undefined ? o.foldT : folded ? 1 : 0);
        shells.push(set); fills.push(F);
        g.add(T);
      });
      top = folded ? 0.17 : 0.08;
      return { g, h: top, setFold: (i, t) => shells[i] && shells[i](t), rods: () => g.add(tacoTray(true)) };
    }
    /** A taco's press stripes on its shell (folded t of the way): lines across the outside of the front wall. */
    function tacoMarks(g, s, t, seed) {
      while (g.children.length) { const c = g.children[0]; g.remove(c); if (c.geometry && !k.isKept(c.geometry)) c.geometry.dispose(); }
      const [n, col, th] = STRIPES[s], r = TACOS.r, kappa = t * (PI / 2 + 0.12) / r;
      const at = (u, v, lift) => {
        let y = 0, z = v;
        if (kappa > 1e-5) { y = (1 - Math.cos(kappa * v)) / kappa; z = Math.sin(kappa * v) / kappa; }
        // outside of the front wall when folded (the normal out of the U: -cos, +sin), the top when flat
        return t > 0.5 ? V(u, y + 0.004 - Math.cos(kappa * v) * lift, z + Math.sin(kappa * v) * lift) : V(u, y + 0.004 + lift, z);
      };
      for (let i = 0; i < n; i++) {
        const u = (i - (n - 1) / 2) * 0.05, w = Math.sqrt(Math.max(0, r * r - u * u)) * 0.9, pts = [];
        for (let j = 0; j <= 10; j++) { const v = t > 0.5 ? w * j / 10 : -w + 2 * w * j / 10; pts.push(at(u + (t > 0.5 ? 0.012 : 0.02) * (j / 10 - 0.5), v, 0.003)); }
        g.add(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 14, th * 0.85, 4, false), k.toon(col)));
      }
      if (s >= 2) {
        const R = k.rand(seed + ':ts'), pts = [];
        for (let i = 0; i < (s === 2 ? 5 : 9); i++) {
          const u = (R() - 0.5) * r * 1.4, w = Math.sqrt(Math.max(0, r * r - u * u)) * 0.85, v = t > 0.5 ? w * (0.2 + R() * 0.75) : (R() * 2 - 1) * w;
          const p = at(u, v, 0.0035);
          const nrm = t > 0.5 ? V(0, -Math.cos(kappa * v), Math.sin(kappa * v)).normalize() : V(0, 1, 0);
          pts.push({ p: [p.x, p.y, p.z], nrm: [nrm.x, nrm.y, nrm.z], r: R() * 6, t: 0.5, s: 0.35 + R() * 0.2 });
        }
        g.add(scat(PIECE.dot(), s >= 4 ? 0x120a06 : 0x7a4418, pts, { outline: false }));
      }
    }
    /** A pressed half-moon taco on the griddle: two tortilla layers with the fillings' colour between, stripes on top. */
    function pressed(parts, s, col, seed, x) {
      const g = new THREE.Group(), r = TACOS.r * 1.05;
      const geo = kept('halfDisc', () => { const sh = new THREE.Shape(); sh.moveTo(-r, 0); sh.absarc(0, 0, r, PI, 0, true); sh.lineTo(-r, 0); const e = new THREE.ExtrudeGeometry(sh, { depth: 0.012, bevelEnabled: false, curveSegments: 16 }); e.rotateX(PI / 2); return e; });
      const filling = parts.find(p => ['chickenPieces', 'steakPieces', 'grilledVeggies'].includes(k.lookFor(p).shape));
      const fcol = filling ? (k.lookFor(filling).shape === 'grilledVeggies' ? 0x4f9a3a : k.lookFor(filling).colour) : 0xd8402c;
      const bottom = k.ink(geo, k.toon(col)); bottom.position.y = 0.012;
      const mid = new THREE.Mesh(geo, k.toon(fcol)); mid.scale.set(0.93, 1, 0.93); mid.position.set(0, 0.024, 0.004);
      const top = k.ink(geo, k.toon(col)); top.position.y = 0.036;
      g.add(bottom, mid, top);
      // bits of filling peeking out round the curved edge
      const R = k.rand(seed + ':peek'), cols = parts.map(p => k.lookFor(p)).filter(L => L.shape !== 'hotSauce' && L.colour !== undefined).map(L => L.colour);
      if (cols.length) {
        const pts = [];
        for (let i = 0; i < 9; i++) { const a = 0.25 + R() * (PI - 0.5); pts.push({ p: [Math.cos(a) * r * 0.97, 0.026, Math.sin(a) * r * 0.97], nrm: [0, 1, 0], r: R() * 6, t: R(), s: 0.9, c: cols[i % cols.length] }); }
        cols.forEach((c, j) => { const mine = pts.filter((_, i) => i % cols.length === j); if (mine.length) g.add(scat(PIECE.dice(), c, mine, { tilt: 0.6 })); });
      }
      const [n, scol, th] = STRIPES[s];
      for (let i = 0; i < n; i++) {
        const u = (i - (n - 1) / 2) * r * 1.4 / Math.max(n, 2), len = Math.sqrt(Math.max(0, r * r - u * u)) * 0.9;
        const bar = new THREE.Mesh(new THREE.BoxGeometry(th * 2.2, th * 0.5, len), k.toon(scol));
        bar.position.set(u, 0.0372, len / 2 + 0.004); bar.rotation.y = 0.25;
        g.add(bar);
      }
      if (s >= 2) freckles(g, k.sample({ kind: 'disc', r: r * 0.6, y: 0.0375 }, s === 2 ? 5 : 9, seed + ':ts').map(p => (p.p[2] = Math.abs(p.p[2]) + 0.02, p)), s >= 4 ? 0x120a06 : 0x7a4418, 0.45);
      g.position.set(x, 0, -0.12);
      g.scale.setScalar(1.15);
      return g;
    }
    /** Chips and salsa: the checked boat of chips, the salsa cup, the guacamole cup, the lime on the rim. */
    function chipsLayout(made, o) {
      o = o || {};
      const seq = k.sequence(made, o), g = new THREE.Group();
      let top = BOAT.h;
      const body = k.food(Object.assign({ n: 0 }, seq.body || { ing: 'chips' }), Object.assign({}, o, { item: made }));
      body.g.position.set(-0.12, 0, 0);
      g.add(body.g);
      top = Math.max(top, body.h);
      let salsa = null;
      seq.parts.forEach((p, i) => {
        const sh = k.lookFor(p).shape;
        if (sh === 'salsaCup') { const b = k.food(Object.assign({ n: i + 1 }, p), Object.assign({}, o, { item: made })); b.g.position.set(0.25, 0, 0.08); g.add(b.g); salsa = b.g; }
        else if (sh === 'guacamole') {
          const c = cup(k.lookFor(p).colour, 1.15);
          c.g.name = 'guacCup';
          const b = onRegion(Object.assign({ n: i + 1 }, p), heapAt(ground(() => c.surface), 0, 0, 0.07, ':gc'), o, { item: made, scoops: 1, scoopScale: 1.05 });
          c.g.add(b.g);
          c.g.position.set(0.43, 0, -0.06);
          g.add(c.g);
          top = Math.max(top, c.surface + 0.05);
        } else if (sh === 'limeWedge') {
          const b = k.food(Object.assign({ n: i + 1 }, p), Object.assign({}, o, { item: made }));
          b.g.position.set(0.04, BOAT.h * 0.75, 0.13); b.g.rotation.set(-0.35, 0.5, 0.2);
          g.add(b.g);
        }
      });
      const sc = (o.contentScale || 1) * (o.where === 'line' ? 1.15 : 1);
      if (sc !== 1) g.scale.multiplyScalar(sc);
      return { g, h: top * sc, salsa };
    }
    /** Which layout: chips by the recipe's body; the rest by the style picked (nothing until one is). */
    function itemLayout(made, o) {
      const style = pickOf(made, 'style');
      if (made.ing === 'chips') return chipsLayout(made, o);
      if (style === 'bowl') return bowlLayout(made, o);
      if (style === 'tacos') return tacosLayout(made, o);
      if (style === 'burrito') return burritoLayout(made, o);
      return { g: new THREE.Group(), h: 0 };
    }

    /* ── shapes: one builder per look.shape ── */
    const nothing = () => ({ g: new THREE.Group(), h: 0 });
    const shapes = {
      // The bodies draw nothing: the style picked is the vessel (their looks carry the ramps for the dial).
      burritoBody: nothing, tacoBody: nothing, bowlBody: nothing,
      /** The basket of chips: the checked paper boat heaped with triangular chips, salt specks on them. */
      chipBasket(part) {
        const b = boat(), g = b.g, R = k.rand('chips:' + (part.n || 0)), n = k.thin(36, 26), list = [[], []];
        for (let i = 0; i < n; i++) {
          const a = R() * PI * 2, rr = Math.sqrt(R()), x = Math.cos(a) * rr * BOAT.w * 0.4, z = Math.sin(a) * rr * BOAT.d * 0.38;
          const y = b.h + 0.02 + (1 - rr * rr) * 0.13 * (0.6 + 0.4 * R());
          list[i % 2].push({ p: [x, y, z], nrm: [0, 1, 0], r: R() * PI * 2, t: R(), s: 0.95 + R() * 0.2 });
        }
        g.add(scat(PIECE.chip(), 0xf2c46a, list[0], { tilt: 2.4 }), scat(PIECE.chip(), 0xe2a446, list[1], { tilt: 2.4 }));
        const salt = list[0].concat(list[1]).filter((_, i) => i % 2 === 0).map(p => ({ p: [p.p[0] + 0.01, p.p[1] + 0.012, p.p[2]], nrm: [0, 1, 0], r: 0, t: 0.5, s: 0.25 }));
        g.add(scat(PIECE.dot(), 0xffffff, salt, { outline: false }));
        return { g, h: b.top + 0.04 };
      },
      flourTortilla(part, o) {
        const s = o && o.stage !== undefined ? clamp(o.stage | 0, 0, 4) : 0, g = new THREE.Group();
        g.add(foilSheet(0.9, 0.86, 'alone'));
        const t = flatTortilla(TORT.r, s, 'alone', 'burrito');
        t.g.position.y = 0.005;
        g.add(t.g);
        return { g, h: 0.005 + TORT.t };
      },
      burritoBowl: () => { const b = bowlVessel(); return { g: b.g, h: BOWL.floor }; },
      softTacos(part, o) {
        const s = o && o.stage !== undefined ? clamp(o.stage | 0, 0, 4) : 0, g = new THREE.Group();
        g.add(tacoTray(false));
        TACOS.xs.forEach(x => { const t = flatTortilla(TACOS.r, s, 'taco' + x, 'tacos'); t.g.position.set(x, TACOS.tray, 0); g.add(t.g); });
        return { g, h: TACOS.tray + TORT.t };
      },
      rice, beans,
      chickenPieces: (part, o) => meats.chicken(part, o),
      steakPieces: (part, o) => meats.steak(part, o),
      grilledVeggies: (part, o) => meats.veggies(part, o),
      shreddedCheese: (part, o) => toppings.cheese(part, o),
      shreddedLettuce: (part, o) => toppings.lettuce(part, o),
      pico: (part, o) => toppings.pico(part, o),
      cornKernels: (part, o) => toppings.corn(part, o),
      sourCream, guacamole,
      jalapenoRings: jalapenos,
      dicedOnions: (part, o) => toppings.onions(part, o),
      /** On the food a zigzag drizzle; on its own, the bottle it waits in. */
      hotSauce: (part, o) => (o && (o.region || o.onFood) ? drizzle(part, o) : sauceBottle(part)),
      salsaCup,
      limeWedge,
    };

    /* ── the line: fillings wait in a steel pan (the kit's tin) and are tipped on ── */
    const TIN = {
      rice: L => ({ piece: PIECE.rice(), mat: k.toon(L.colour), n: 90, size: 1.3, tilt: 1 }),
      beans: L => ({ piece: PIECE.bean(), mat: k.toon(L.colour), n: 40, size: 1.05, tilt: 1 }),
      shreddedCheese: L => ({ piece: 'shred', mat: k.toon(L.colour), n: 80, size: 1.15, tilt: 1.3 }),
      shreddedLettuce: L => ({ piece: PIECE.ribbon(), mat: k.toon(L.colour), n: 40, size: 1.1, tilt: 1.2 }),
      pico: L => ({ piece: PIECE.dice(), mat: k.toon(L.colour), n: 36, size: 1, tilt: 1 }),
      cornKernels: L => ({ piece: PIECE.kernel(), mat: k.toon(L.colour), n: 50, size: 1.1, tilt: 1 }),
      sourCream: L => ({ piece: dollopGeo(), mat: k.toon(L.colour), n: 6, size: 1.25, tilt: 0.3 }),
      guacamole: L => ({ piece: scoopGeo(0), mat: k.toon(L.colour), n: 7, size: 1.1, tilt: 0.4 }),
      jalapenoRings: L => ({ piece: PIECE.ring(), mat: k.toon(L.colour), n: 16, size: 1.1, tilt: 1 }),
      dicedOnions: L => ({ piece: PIECE.onion(), mat: k.toon(L.colour), n: 36, size: 1, tilt: 1 }),
    };
    /** A filling's pan: the same piece and colour, drawn 1.2 times up (small next to the burrito on the counter). */
    function tinOf(part) {
      const L = k.lookFor(part), T = TIN[L.shape];
      const b = k.tin(part, T ? T(L) : undefined);
      const hp = b.g.getObjectByName('heap');
      if (hp && L.shape === 'pico') hp.add(k.heap(PIECE.bit(), k.toon(0xf6f2e6), { n: k.thin(14, 7), r: 0.1, h: 0.09, seed: 'tinpico' }).g);
      if (hp && L.shape === 'shreddedLettuce') hp.add(k.heap(PIECE.ribbon(), k.toon(0xc8ee8e), { n: k.thin(18, 9), r: 0.1, h: 0.09, seed: 'tinlet', tilt: 1.2 }).g);
      if (hp && L.shape === 'jalapenoRings') hp.add(k.heap(PIECE.ringFlesh(), k.toon(0xd9eaa0), { n: k.thin(10, 5), r: 0.09, h: 0.095, seed: 'tinjal' }).g);
      b.g.scale.setScalar(1.2);
      b.h *= 1.2;
      return b;
    }
    const lines = {
      tin: { incoming: part => Object.assign(tinOf(part), { rest: 0.045 }), add: c => k.tip(c) },
    };
    const applies = { rice: 'tin', beans: 'tin', shreddedCheese: 'tin', shreddedLettuce: 'tin', pico: 'tin', cornKernels: 'tin', sourCream: 'tin', guacamole: 'tin', jalapenoRings: 'tin', dicedOnions: 'tin' };

    /* ── gross-out fx that follow the food (the kit's otherwise) ── */
    const kitFx = name => (k.module('kit').fx || {})[name];
    const fx = {
      /** A hair lies along the food's own surface (the beans' band), not across its bounding box's top. */
      hair(g, v, box, c) {
        // a dark hair on black beans cannot be seen: on dark food it is a pale (grey-blond) one
        const L = c && c.part ? k.lookFor(c.part.userData && c.part.userData.part ? c.part.userData.part : c.part) : null;
        const dark = L && L.colour !== undefined && new THREE.Color(L.colour).getHSL({}).l < 0.3;
        if (typeof v !== 'number') v = dark ? 0xeadcb8 : 0x1a1410;
        const Rg = c && c.o && c.o.region;
        if (!Rg) return kitFx('hair')(g, v, box, c);
        const [x0, x1, z0, z1] = Rg.span, cz = (z0 + z1) / 2, d = (z1 - z0) / 2, pts = [], R = k.rand('hair:' + ((c.part && c.part.ing) || ''));
        for (let i = 0; i <= 16; i++) {
          const x = x0 + (x1 - x0) * (0.18 + 0.64 * i / 16), z = cz + Math.sin(i * 0.8 + R() * 0.6) * d * 0.4;
          pts.push(V(x, Rg.G.at(x, z) + 0.012, z));
        }
        g.add(k.fxPart(new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 48, 0.0055, 5, false), k.toon(v))));
      },
      /** Spots on the food's own upper surface (the brown guacamole's scoops), not floating at its box's top. */
      spots(g, v, box, c) {
        const S = k.surfaceOf(g, 0.5);
        if (S.count < 12) return kitFx('spots')(g, v, box, c);
        const o = typeof v === 'object' ? v : { colour: typeof v === 'number' ? v : 0x7fae3a };
        const pts = k.onSurface(S, o.n || 9, 'spots:' + ((c.part && c.part.ing) || '') + ':' + ((c.part && c.part.n) || 0), 0.004).map(p => Object.assign(p, { s: 0.6 + p.t * 0.7 }));
        g.add(k.fxPart(scat(kept('spot', () => new THREE.CircleGeometry(0.02, 10).rotateX(-PI / 2)), o.colour, pts, { outline: false })));
      },
    };

    /* ── flourishes ── */
    const autos = {
      /** The flat tortilla's sides fold in over the band, it rolls up from the near edge, and the foil folds round
       *  its closed end. */
      burritoWrap(c, e, made) {
        if (pickOf(made, 'style') !== 'burrito') return popIt(c, made);
        const after = without(made, ['burst']);

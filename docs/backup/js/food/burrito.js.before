        count(n, share) { return Math.max(1, Math.round(n * (area / 0.1) * (share || 1))); },
        raise(h) { G.add(h, f); },
        /** A smooth mound of height h over the region, on the ground (top only: it meets the ground at its edge). */
        mound(h, mat, res) {

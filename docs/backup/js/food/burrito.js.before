    }
    /** Six jalapeno rings, spread out so they can be counted (Coach Bev does): green rings with pale seeded middles. */
    function jalapenos(part, o) {
      const L = k.lookFor(part), Rg = regionOf(part, o), g = new THREE.Group(), seed = seedOf(part, o);
      g.name = 'jalapenos';
      const n = o && o.rings !== undefined ? o.rings : 6;
      const pts = Rg.points(n, seed, 0.11, 0.35, 0.008).map(p => Object.assign(p, { s: (o && o.ringScale) || 1.15 }));
      g.add(scat(PIECE.ring(), L.colour, pts, { tilt: 0.25 }));
      g.add(scat(PIECE.ringFlesh(), 0xd9eaa0, pts.map(p => Object.assign({}, p, { p: [p.p[0], p.p[1] + 0.001, p.p[2]] })), { tilt: 0.25, outline: false }));
      const seeds = [];
      pts.forEach((p, i) => { for (let j = 0; j < 3; j++) { const a = j * 2.1 + i; seeds.push({ p: [p.p[0] + Math.cos(a) * 0.008 * p.s, p.p[1] + 0.004, p.p[2] + Math.sin(a) * 0.008 * p.s], nrm: [0, 1, 0], r: a, t: 0.5, s: 0.32 }); } });
      g.add(scat(PIECE.dot(), 0xfff6d8, seeds, { outline: false }));
      Rg.raise(0.006);
      return { g, h: Rg.top() + 0.01 };
    }
    const toppings = {
      cheese: (part, o) => {
        const s = toastIndex(o && o.item, o), L = k.lookFor(part), melt = s >= 2;
        return pieces('cheese', part, o, [{ piece: () => k.piece('shred'), colour: melt ? k.mix(L.colour, 0xffd25a, 0.4) : L.colour, n: 70, d: 0.016, tilt: melt ? 0.6 : 1.3, size: melt ? 1.15 : 1.05, minF: 0.25, lift: melt ? -0.003 : 0 }], 0.008);
      },
      lettuce: (part, o) => pieces('lettuce', part, o, [
        { piece: PIECE.ribbon, colour: k.lookFor(part).colour, n: 26, d: 0.03, tilt: 1.0 },
        { piece: PIECE.ribbon, colour: 0xc8ee8e, n: 14, d: 0.03, tilt: 1.0 }], 0.012),
      pico: (part, o) => pieces('pico', part, o, [
        { piece: PIECE.dice, colour: k.lookFor(part).colour, n: 26, d: 0.03, tilt: 0.8 },
        { piece: PIECE.bit, colour: 0xf6f2e6, n: 12, d: 0.03, tilt: 0.8 },
        { piece: PIECE.dot, colour: 0x2f7a22, n: 10, d: 0.04, tilt: 0.2, outline: false, size: 0.4, lift: 0.012 }], 0.01),
      corn: (part, o) => pieces('corn', part, o, [{ piece: PIECE.kernel, colour: k.lookFor(part).colour, n: 34, d: 0.022, tilt: 0.7 }], 0.008),
      onions: (part, o) => pieces('onions', part, o, [
        { piece: PIECE.onion, colour: k.lookFor(part).colour, n: 16, d: 0.026, tilt: 0.8 },
        { piece: PIECE.onion, colour: 0xd9c7ea, n: 8, d: 0.026, tilt: 0.8 }], 0.008),
    };

    /* ── the hot sauce: a zigzag drizzle that follows the food's surface; the bottle with its chili marks ── */
    /** A drizzle across a region's span, on its ground: a tube grown along its length by setDrawRange. */
    function drizzle(part, o) {
      const L = k.lookFor(part), Rg = regionOf(part, o), g = new THREE.Group();
      g.name = 'sauce';
      const [x0, x1, z0, z1] = Rg.span, w = (x1 - x0) / 2, d = (z1 - z0) / 2, cx = (x0 + x1) / 2, cz = (z0 + z1) / 2;
      const turns = (o && o.turns) || 5, raw = [];
      for (let i = 0; i <= turns; i++) raw.push([cx - w * 0.82 + (2 * w * 0.82) * i / turns, cz + (i % 2 ? 0.6 : -0.6) * d]);
      let pts = raw;
      for (let it = 0; it < 3; it++) {
        const q = [pts[0]];
        for (let i = 0; i < pts.length - 1; i++) { const a = pts[i], b = pts[i + 1]; q.push([a[0] * 0.75 + b[0] * 0.25, a[1] * 0.75 + b[1] * 0.25], [a[0] * 0.25 + b[0] * 0.75, a[1] * 0.25 + b[1] * 0.75]); }
        q.push(pts[pts.length - 1]); pts = q;

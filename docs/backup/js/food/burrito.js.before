      g.add(tube, capA, capB);
      const glints = [0.12, 0.33, 0.52, 0.71, 0.9].map(u => { const m = new THREE.Mesh(kept('glint', () => new THREE.SphereGeometry(0.006, 6, 4).scale(2, 0.6, 1)), k.SHINE); m.position.copy(curve.getPointAt(u)).add(V(0, r * 0.55, 0)); g.add(m); return m; });
      g.userData.drizzle = {

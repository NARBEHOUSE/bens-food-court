      g.add(scat(PIECE.dot(), k.mix(L.colour, 0x2a4a10, 0.45), k.onSurface(S, k.thin(10 * n, 4), seed + ':fl', 0.003).map(p => Object.assign(p, { s: 0.3 + p.t * 0.2 })), { outline: false }));
      g.add(scat(PIECE.dot(), 0xe9f2c0, k.onSurface(S, k.thin(5 * n, 2), seed + ':on', 0.003).map(p => Object.assign(p, { s: 0.22 })), { outline: false }));

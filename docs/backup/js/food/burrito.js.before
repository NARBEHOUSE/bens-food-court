      Rg.points(n, seed, 0.16, 0.4, 0).forEach((p, i) => {
        const s = (o && o.dollopScale) || 1;
        const shadow = new THREE.Mesh(kept('shadow', () => new THREE.CircleGeometry(0.066, 16).rotateX(-PI / 2)), k.toon(0xb9c3d6));
        shadow.position.set(p.p[0] + 0.008, p.p[1] + 0.002, p.p[2] + 0.01); shadow.scale.setScalar(s);
        const d = k.ink(dollopGeo(), k.toon(L.colour));
        d.position.set(p.p[0], p.p[1] - 0.003, p.p[2]); d.rotation.y = p.r; d.scale.setScalar(s);
        const gloss = new THREE.Mesh(kept('gloss', () => new THREE.SphereGeometry(0.012, 8, 6).scale(1.4, 0.5, 0.8)), k.SHINE);
        gloss.position.set(p.p[0] - 0.016 * s, p.p[1] + 0.038 * s, p.p[2] + 0.018 * s);
        g.add(shadow, d, gloss);
      });
      Rg.raise(0.012);
      return { g, h: Rg.top() + 0.06 };
    }
    /** Guacamole: lumpy green scoops with darker flecks (each its own mesh, so a brown one's spots land on it). */
    const scoopGeo = i => kept('scoop:' + i + ':' + (k.low() ? 'lo' : 'hi'), () => {
      const geo = new THREE.SphereGeometry(0.052, k.seg(16), k.seg(10), 0, PI * 2, 0, PI / 2), p = geo.attributes.position, R = k.rand('scoop' + i);
      const b = [R() * 6, R() * 6, R() * 6];
      for (let j = 0; j < p.count; j++) {
        const x = p.getX(j), y = p.getY(j), z = p.getZ(j), a = Math.atan2(z, x);
        const m = 1 + 0.12 * Math.sin(a * 4 + b[0]) * Math.cos(y * 40 + b[1]) + 0.06 * Math.sin(a * 7 + b[2]);
        p.setXYZ(j, x * m, y * 0.72 * m, z * m);
      }
      geo.computeVertexNormals();
      return geo;
    });
    function guacamole(part, o) {
      const L = k.lookFor(part), Rg = regionOf(part, o), g = new THREE.Group(), seed = seedOf(part, o);
      g.name = 'guacamole';
      const n = o && o.scoops ? o.scoops : Math.max(1, Math.min(3, Math.round(Rg.area / 0.045)));
      const s = (o && o.scoopScale) || 1;
      Rg.points(n, seed, 0.16, 0.4, -0.004).forEach((p, i) => {
        const m = k.ink(scoopGeo(i % 3), k.toon(L.colour));
        m.position.set(p.p[0], p.p[1], p.p[2]); m.rotation.y = p.r; m.scale.setScalar(s * (0.9 + p.t * 0.2));
        m.name = 'scoop';
        g.add(m);

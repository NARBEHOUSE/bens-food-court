      for (let i = 0; i <= 90; i++) { const p = curve0.getPointAt(i / 90); p.y = Rg.G.at(p.x, p.z) + r * 0.7; dense.push(p); }
      const curve = new THREE.CatmullRomCurve3(dense, false, 'centripetal');
      const SEG = 120, RAD = 6, geo = new THREE.TubeGeometry(curve, SEG, r, RAD, false);

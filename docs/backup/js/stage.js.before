/** Ben's Burger Bar - the 2D stage (DESIGN.md "Look and feel: 2.5D", "No floating UI").
 *
 *  The station's backdrop, the customer (big, behind the counter), Mitch, the real objects
 *  the choices live on (the ticket wheel, the "Back in 5" sign, the register, the bell)
 *  and the line's own controls (enamel push-buttons, the grill dial's plates, the
 *  spatula, order slips). A character never animates: a new pose pops in, with a squash
 *  and a bounce on Full motion and a plain cut on Reduced. Pictures are only asked for
 *  when the art manifest says they exist.
 */
(function () {
  'use strict';
  const pack = BBPacks.diner, W = BB.words;
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const art = () => (window.BBArt && BBArt.diner) || { cast: {}, backdrops: [], props: [] };
  const reduced = () => document.body.dataset.motion === 'reduced';
  const wait = ms => new Promise(r => setTimeout(r, ms));

  function castSrc(folder, pose) {
    const A = art().cast[folder] || [];
    const p = A.includes(pose) ? pose : A.includes('neutral') ? 'neutral' : null;
    return p ? 'packs/diner/art/cast/' + folder + '/' + p + '.webp' : null;
  }
  const propSrc = name => ((art().props || []).includes(name) ? 'packs/diner/art/props/' + name + '.webp' : null);

  function init() {
    [['back5', 'back5'], ['register', 'register'], ['bell', 'bell']].forEach(([id, p]) => {
      const img = $(id).querySelector('img'), src = propSrc(p);
      if (src) img.src = src;
      else { img.remove(); $(id).classList.add('noart'); }
    });
    buildWheel();
    window.addEventListener('resize', () => drawWheel());
    // A new text size changes the ticket's width (applied to the page first, so wait a moment).
    if (BB.save && BB.save.onChange) BB.save.onChange(() => setTimeout(drawWheel, 0));
  }

  /* ── scenes ─────────────────────────────────────────────────────────────── */
  let scene = null;
  /** Go to a station's set: the backdrop and the 3D camera change together, behind a quick fade. */
  async function setScene(name) {
    if (scene === name) return;
    const first = scene === null;
    scene = name;
    const fade = $('fade');
    if (!first && !reduced()) { fade.classList.add('on'); await wait(170); }
    document.body.dataset.scene = name;
    const bd = (pack.backdrops || {})[name];
    $('backdrop').style.backgroundImage = bd && art().backdrops.includes(bd) ? 'url("packs/diner/art/backdrops/' + bd + '.webp")' : '';
    if (BB.world && BB.world.goTo) BB.world.goTo(name);
    drawWheel();
    if (!first && !reduced()) { await wait(30); fade.classList.remove('on'); await wait(150); }
    // A ticket that went up while the wheel was out of sight (at the counter) comes round now.
    if (wheel.pending && wheelShown()) { wheel.pending = null; spinWheel('in'); }
  }

  /* ── characters ─────────────────────────────────────────────────────────── */
  const shown = { customer: null, mitch: null };
  function pop(el) {
    if (reduced()) return;
    el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop');
  }
  /** The customer at the counter in a pose, or nobody (folder null). */
  function customer(folder, pose) {
    const el = $('customer');
    if (!folder) { el.classList.remove('on'); shown.customer = null; return; }
    const src = castSrc(folder, pose);
    const key = folder + '/' + pose;
    if (!src) { el.classList.remove('on'); return; }
    if (shown.customer !== key) { el.src = src; shown.customer = key; pop(el); }
    el.classList.add('on');
  }
  /** Mitch in a pose, sliding in; null slides him out. */
  function mitch(pose) {
    const el = $('mitch');
    if (!pose) { el.classList.remove('on'); shown.mitch = null; return; }
    const src = castSrc(pack.manager.art, pose);
    if (!src) return;
    if (shown.mitch !== pose) { el.src = src; if (shown.mitch) pop(el); shown.mitch = pose; }
    el.classList.add('on');
  }

  /* ── the ticket wheel ───────────────────────────────────────────────────── */
  // A diner order wheel seen from the front (DESIGN.md "Where things sit"): a steel ring hung flat from the
  // ceiling, clips round its edge, in the kitchen's top-left corner and partly off the screen. The order
  // hangs from the front clip. It turns left to right: a new ticket comes round from the left, and Ticket
  // turns it once all the way round. The counter has no wheel. Drawn here, not painted, so the words on the
  // ticket stay sharp at every text size; geometry() is plain numbers, for the Node layout check.
  const CLIPS = 8, STEP = Math.PI * 2 / CLIPS, SVG = 'http://www.w3.org/2000/svg';
  const wheel = { theta: 0, anim: 0, order: null, pending: null };
  const wheelShown = () => !!scene && scene !== 'counter';
  function buildWheel() {
    const el = $('wheel');
    el.innerHTML = '';
    ['back', 'front'].forEach(k => { const s = document.createElementNS(SVG, 'svg'); s.setAttribute('class', k); s.setAttribute('aria-hidden', 'true'); el.appendChild(s); });
    for (let i = 0; i < CLIPS; i++) {
      const s = document.createElement('div');
      s.className = 'slot';
      s.innerHTML = '<i class="clip"></i>' + (i === 0 ? '<div id="ticket" style="display:none"></div>' : '');
      el.appendChild(s);
    }
  }
  /** Where everything on the wheel is, for a window w x h, a text size and the wheel's turn theta (radians). */
  function geometry(w, h, text, theta) {
    const vw = w / 100, vh = h / 100;
    const tw = Math.min(22 * vw, 40 * vh) * ({ large: 1.12, xlarge: 1.25 }[text] || 1);   // a ticket's width
    const R = tw * 1.05;                                                                  // the ring, centre to rim
    const g = { tw, R, ry: R * 0.09, cx: tw / 2 + Math.max(12, 1.4 * vw), cy: 4.5 * vh };
    g.slots = Array.from({ length: CLIPS }, (_, i) => {
      const phi = theta + i * STEP, cz = Math.cos(phi);
      return { phi, cz, x: g.cx + g.R * Math.sin(phi), y: g.cy + g.ry * cz, scale: 1 + 0.08 * (cz - 1),
        paper: Math.max(0, Math.min(1, (cz - 0.05) / 0.3)), shade: 0.62 + 0.38 * Math.max(0, cz) };
    });
    return g;
  }
  function drawWheel() {
    const el = $('wheel');
    if (!el || !wheelShown()) return;
    const g = geometry(window.innerWidth, window.innerHeight, document.body.dataset.text, wheel.theta);
    el.style.setProperty('--tw', g.tw + 'px');
    el.querySelectorAll('.slot').forEach((s, i) => {
      const p = g.slots[i], left = (p.x - g.tw / 2).toFixed(1) + 'px', top = p.y.toFixed(1) + 'px';
      s.style.width = g.tw + 'px';
      // Square on (the order at rest) is a plain move, so the words are drawn crisp.
      s.style.transform = p.cz > 0.9999 ? `translate(${left}, ${top})`
        : `translate(${left}, ${top}) scale(${p.scale.toFixed(3)}) perspective(${Math.round(g.tw * 3.2)}px) rotateY(${p.phi.toFixed(4)}rad)`;
      s.style.zIndex = String(50 + Math.round(49 * p.cz));
      s.style.filter = p.cz > 0.995 ? '' : `brightness(${p.shade.toFixed(3)})`;
      if (i === 0) $('ticket').style.opacity = p.paper.toFixed(3);
    });
    // The rod up to the ceiling, the ring, its spokes and the hub: the back half behind the clips, the front half in front.
    const { cx, cy, R, ry } = g, sw = Math.max(5, R * 0.035), ink = '#1b120e', steel = '#d6dce1', dark = '#9aa4ad';
    const w = Math.ceil(cx + R + sw * 2), h = Math.ceil(cy + ry + sw * 2);
    const arc = (sweep, col, width, dy) => `<path d="M ${cx - R} ${cy + (dy || 0)} A ${R} ${ry} 0 0 ${sweep} ${cx + R} ${cy + (dy || 0)}" fill="none" stroke="${col}" stroke-width="${width}" stroke-linecap="round"/>`;
    const spoke = (p, col, width) => `<line x1="${cx}" y1="${cy}" x2="${p.x.toFixed(1)}" y2="${p.y.toFixed(1)}" stroke="${col}" stroke-width="${width}" stroke-linecap="round"/>`;
    const spokes = list => list.map(p => spoke(p, ink, sw * 0.5 + 4)).join('') + list.map(p => spoke(p, dark, sw * 0.5)).join('');
    const back = el.querySelector('svg.back'), front = el.querySelector('svg.front');
    [back, front].forEach(s => { s.setAttribute('width', w); s.setAttribute('height', h); s.setAttribute('viewBox', `0 0 ${w} ${h}`); });
    back.innerHTML = `<rect x="${cx - R * 0.025}" y="-20" width="${R * 0.05}" height="${cy + 20}" fill="${steel}" stroke="${ink}" stroke-width="3"/>` +
      arc(1, ink, sw + 6) + arc(1, dark, sw) + spokes(g.slots.filter(p => p.cz < 0)) +
      `<ellipse cx="${cx}" cy="${cy}" rx="${R * 0.075}" ry="${R * 0.045}" fill="${steel}" stroke="${ink}" stroke-width="3"/>` +
      spokes(g.slots.filter(p => p.cz >= 0));
    front.innerHTML = arc(0, ink, sw + 6) + arc(0, steel, sw) + arc(0, '#fff', sw * 0.25, -sw * 0.22).replace('stroke="#fff"', 'stroke="#fff" stroke-opacity=".75"');
  }
  /** Turn the wheel: 'in' brings a new ticket round from the left, 'turn' takes it once all the way round. */
  function spinWheel(kind) {
    cancelAnimationFrame(wheel.anim);
    wheel.anim = 0;
    if (reduced() || !wheelShown()) { wheel.theta = 0; turning(false); drawWheel(); return; }
    // A turn starts from wherever the wheel is, so pressing Ticket mid-spin never makes it jump.
    const from = kind === 'in' ? -3 * STEP : wheel.theta - Math.PI * 2, ms = kind === 'in' ? 1100 : 1600, t0 = performance.now();
    const ease = kind === 'in'
      ? t => 1 + 1.9 * Math.pow(t - 1, 3) + 0.9 * Math.pow(t - 1, 2)          // slows, a touch past the front, settles
      : t => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    wheel.theta = from;
    turning(true);
    drawWheel();
    const tick = now => {
      const t = Math.min(1, (now - t0) / ms);
      wheel.theta = t < 1 ? from * (1 - ease(t)) : 0;
      drawWheel();
      wheel.anim = t < 1 ? requestAnimationFrame(tick) : 0;
      if (t >= 1) turning(false);
    };
    wheel.anim = requestAnimationFrame(tick);
  }
  /** While the wheel turns, the scan's corner brackets wait (ui.js): they would chase the order round the back. */
  const turning = on => document.body.classList.toggle('wheelTurning', !!on);
  /** The order on the wheel (null takes it down). active: the item being made. spin: a new order comes round,
   *  the same one turns once (Ticket); a new one that goes up while the wheel is out of sight comes round later. */
  function ticket(order, active, spin) {
    const el = $('ticket');
    if (!el) return;
    if (!order) { el.innerHTML = ''; el.style.display = 'none'; wheel.order = null; wheel.pending = null; return; }
    const fresh = order !== wheel.order;
    wheel.order = order;
    el.style.display = '';
    // Each item spelt out (words.js "the ticket"): the name, the patties and how done, then everything that
    // goes on, in the order the line brings it. With more than one item, the one being made is spelt out
    // and the others wait as their names, so the ticket stays small enough to read.
    const many = order.items.length > 1;
    el.innerHTML = '<div class="who">' + esc(order.ticket.customer.name) + '</div><ol>' +
      order.items.map((it, i) => {
        const sp = W.spelled(pack, it.spec), open = !many || i === active || active < 0;
        return '<li' + (i === active && many ? ' class="now"' : '') + '><b>' + esc(sp.head) + '</b>' +
          (open ? (sp.cooked.length ? '<span class="cooked">' + esc(sp.cooked.join(', ')) + '</span>' : '') +
            '<span class="on">' + esc(W.onWords(sp)) + '</span>' : '') + '</li>';
      }).join('') + '</ol>';
    el.classList.toggle('many', many);
    if (spin && wheelShown()) return spinWheel(fresh ? 'in' : 'turn');
    if (spin && fresh) wheel.pending = 'in';
    if (fresh && !spin) { cancelAnimationFrame(wheel.anim); wheel.anim = 0; wheel.theta = 0; turning(false); }
    drawWheel();
  }
  /** The scan's Ticket target: the order on the wheel. */
  const ticketEl = () => $('ticket');

  /* ── the line's controls ───────────────────────────────────────────────── */
  /** Draw the answers. list: [{ id, kind, label, icon, cls, marks, swatch }]. -> { id: element } */
  function controls(list, bare) {
    const box = $('controls');
    box.innerHTML = '';
    box.classList.toggle('bare', !!bare);
    const out = {};
    for (const c of list) {
      const el = document.createElement('div');
      el.className = 'ctl ' + c.kind + (c.cls ? ' ' + c.cls : '');
      el.dataset.id = c.id;
      if (c.kind === 'btn') el.innerHTML = (c.icon ? '<span class="ic">' + c.icon + '</span>' : '') + '<span class="lb">' + esc(c.label) + '</span>';
      else if (c.kind === 'plate') {
        el.innerHTML = '<span class="marks">' + '<i></i>'.repeat(c.marks || 0) + '</span>' +
          '<span class="sw" style="background:#' + (c.swatch || 0x999999).toString(16).padStart(6, '0') + '"></span><span class="lb">' + esc(c.label) + '</span>';
      } else if (c.kind === 'spatula') {
        const src = propSrc('spatula');
        el.innerHTML = (src ? '<img alt="" src="' + src + '">' : '<span class="ic">🍳</span>') + '<span class="lb">' + esc(c.label) + '</span>';
      } else el.innerHTML = (c.icon ? '<span class="ic">' + c.icon + '</span>' : '') + '<span class="lb">' + esc(c.label) + '</span>';
      box.appendChild(el);
      out[c.id] = el;
    }
    return out;
  }
  const clearControls = () => { $('controls').innerHTML = ''; };

  /** The real objects that are choices on some screens. */
  function show(prop, on) { $(prop).classList.toggle('on', !!on); return $(prop); }

  /* ── the Timed gauge ────────────────────────────────────────────────────── */
  function gauge(stages, s, want) {
    const g = $('gauge');
    if (!stages) { g.classList.remove('on'); g.innerHTML = ''; return; }
    g.innerHTML = stages.map((st, i) => '<span class="' + (i === s ? 'now ' : '') + (st === want ? 'want' : '') + '">' + esc(W.stage(pack, st)) + '</span>').join('');
    g.classList.add('on');
  }

  /* ── speech bubbles, the receipt, the corner count ─────────────────────── */
  function bubble(kind, name, text) {
    const b = $('bubble');
    if (!text) { b.classList.remove('on'); return; }
    b.className = 'on ' + kind;
    b.querySelector('b').textContent = name;
    b.querySelector('span').textContent = BB.script.clean(text);
  }
  function receipt(r) {
    const el = $('receipt');
    if (!r) { el.classList.remove('on'); el.innerHTML = ''; return; }
    const stars = '<div class="stars">' + [1, 2, 3].map(i => '<span' + (i > r.stars ? ' class="off"' : '') + '>★</span>').join('') + '</div>';
    const lines = r.mistakes.length ? '<ul>' + r.mistakes.map(m => '<li>' + esc(W.mistake(pack, m)) + '</li>').join('') + '</ul>'
      : '<p>Everything as ordered.</p>';
    el.innerHTML = '<h2>' + esc(r.name) + '</h2>' + stars + lines + '<div class="tip">Tip: ' + r.tip + ' coins' + (r.favourite ? ' (a favourite!)' : '') + '</div>';
    el.classList.add('on');
  }
  function hud(text) { $('hud').textContent = text || ''; }

  BB.stage = { init, setScene, customer, mitch, ticket, ticketEl, controls, clearControls, show, gauge, bubble, receipt, hud, get scene() { return scene; },
    /** For the Node layout check. */ wheelGeometry: geometry, get wheelTheta() { return wheel.theta; } };
})();

/** Ben's Burger Bar - what things are called.
 *
 *  Every spoken label and every ticket line is built here from the pack's names, so speech
 *  always says what is on screen. A customer says an order the way people do (said(): "no
 *  onions"), and as parts ("Bacon Cheeseburger" · "medium" · "no onions"), which is how their
 *  recorded voices say any order (DESIGN.md "Voices and the script"); the ticket spells out
 *  everything that goes on (ticket(), item()).
 */
(function (root, factory) {
  if (typeof module === 'object' && module.exports) module.exports = factory();
  else (root.BB = root.BB || {}).words = factory();
})(typeof window === 'undefined' ? globalThis : window, function () {
  'use strict';

  const lower = s => String(s).toLowerCase();
  const cap = s => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
  const name = (pack, id) => ((pack.ingredients[id] || {}).name || (pack.stations[id] || {}).name || (pack.recipes[id] || {}).name || id);
  const plural = (pack, id) => (pack.ingredients[id] && pack.ingredients[id].plural) || name(pack, id);
  const stage = (pack, id) => pack.stageNames[id] || id;
  const NUMBER = ['no', 'one', 'two', 'three', 'four', 'five', 'six'];
  const ORDINAL = ['', 'a', 'a second', 'a third', 'a fourth', 'a fifth'];
  function sizeName(pack, ingId, id) {
    const I = pack.ingredients[ingId];
    const z = I && I.sizes ? pack.sizeSets[I.sizes].find(x => x.id === id) : null;
    return z ? z.name : id;
  }
  function list(words) {
    if (words.length < 2) return words.join('');
    return words.slice(0, -1).join(', ') + ' and ' + words[words.length - 1];
  }
  const countOf = (spec, ing) => spec.parts.filter(p => p.ing === ing).length;

  /* ── orders ─────────────────────────────────────────────────────────────── */
  function head(pack, spec, many) {
    const R = pack.recipes[spec.recipe];
    const flavour = spec.parts.find(p => p.flavour);
    let h = R.item.nameFrom === 'flavour' && flavour ? name(pack, flavour.ing) : (many ? R.plural || R.name : R.name);
    if (spec.size) h = sizeName(pack, spec.ing, spec.size) + ' ' + lower(h);
    return h;
  }
  /** The details after the name: doneness, then what is held or added. */
  function details(pack, spec) {
    const bits = [];
    const dones = [];
    if (spec.done) dones.push(spec.done);
    spec.parts.forEach(p => { if (p.done && !dones.includes(p.done)) dones.push(p.done); });
    dones.forEach(d => bits.push(lower(stage(pack, d))));
    if (spec.with) bits.push(spec.with.length ? 'with just ' + list(spec.with.map(h => lower(name(pack, h)))) : 'plain');
    else {
      (spec.holds || []).forEach(h => bits.push('no ' + lower(plural(pack, h))));
      (spec.adds || []).forEach(h => bits.push('add ' + lower(name(pack, h))));
    }
    return bits;
  }
  /** Identical items side by side are said once with a count ("Two Cheeseburgers, medium"). */
  function groups(t) {
    const out = [];
    t.items.forEach((spec, i) => {
      const last = out[out.length - 1];
      if (last && JSON.stringify(last.spec) === JSON.stringify(spec)) { last.n += 1; last.items.push(i); }
      else out.push({ spec, n: 1, items: [i] });
    });
    return out;
  }
  /** The order as the customer says it, the way people order: the menu name, how done, what is
   *  held or added ("Bacon Cheeseburger, medium, no onions."). The ticket spells it out. */
  function said(pack, t) {
    const words = groups(t).map(g => (g.n > 1 ? cap(NUMBER[g.n] || String(g.n)) + ' ' + head(pack, g.spec, true) : head(pack, g.spec)) +
      [''].concat(details(pack, g.spec)).join(', '));
    return list(words) + '.';
  }

  /* ── the ticket: everything spelt out ───────────────────────────────────── */
  // "No onions" only makes sense if you know what a Bacon Cheeseburger comes with, so the ticket
  // never leans on that: it lists the patties and everything that goes on, in the order the line
  // brings them, and "add what's on the ticket, skip what isn't" always works (DESIGN.md "The ticket").
  /** Everything the line can add, in the order it asks (toppings, then salt, ice...). */
  function lineOrder(pack) {
    const order = [];
    Object.values(pack.stations).forEach(st => st.steps.forEach(x => { if (x.kind === 'add' && !order.includes(x.ing)) order.push(x.ing); }));
    return order;
  }
  /** An item spelt out: { head: its name, cooked: [how many of each cooked thing and how done], on: [the words for
   *  everything that goes on it, in the line's order] }. */
  function spelled(pack, spec) {
    const cooked = [], byIng = {};
    spec.parts.forEach(p => { const I = pack.ingredients[p.ing]; if (I && I.stages) (byIng[p.ing] = byIng[p.ing] || []).push(p); });
    Object.keys(byIng).forEach(ing => {
      const n = byIng[ing].length, d = byIng[ing][0].done;
      cooked.push(NUMBER[n] + ' ' + lower(n === 1 ? name(pack, ing) : plural(pack, ing)) + (d ? ', ' + lower(stage(pack, d)) : ''));
    });
    if (spec.done) cooked.push(lower(stage(pack, spec.done)));
    const order = lineOrder(pack);
    const on = [...new Set(spec.parts.map(p => p.ing))].filter(ing => order.includes(ing) && !(pack.ingredients[ing] || {}).stages)
      .sort((a, b) => order.indexOf(a) - order.indexOf(b)).map(ing => lower(name(pack, ing)));
    return { head: head(pack, spec), cooked, on };
  }
  /** What goes on, in words: "with cheese, lettuce and tomato", or "nothing else on it". */
  const onWords = sp => (sp.on.length ? 'with ' + list(sp.on) : 'nothing else on it');
  /** One item as the ticket has it: "Cheeseburger: one patty, medium, with cheese, lettuce and tomato". */
  function item(pack, spec) {
    const sp = spelled(pack, spec);
    return sp.head + ': ' + sp.cooked.concat([onWords(sp)]).join(', ');
  }
  /** The ticket read out: one sentence an item (identical ones together, "each"). */
  function ticket(pack, t) {
    return groups(t).map(g => {
      const sp = spelled(pack, g.spec);
      const h = g.n > 1 ? cap(NUMBER[g.n] || String(g.n)) + ' ' + head(pack, g.spec, true) + ', each' : sp.head;
      return h + ': ' + sp.cooked.concat([onWords(sp)]).join(', ') + '.';
    }).join(' ');
  }
  /** The ticket as recordable parts: [{ id, text }] (text to speech says ticket() instead). */
  function orderParts(pack, t) {
    const parts = [];
    groups(t).forEach((g, k) => {
      if (k) parts.push({ id: 'and', text: 'and' });
      const spec = g.spec, R = pack.recipes[spec.recipe];
      if (g.n > 1) parts.push({ id: 'count.' + g.n, text: cap(NUMBER[g.n]) });
      if (spec.size) parts.push({ id: 'size.' + spec.size, text: sizeName(pack, spec.ing, spec.size) });
      const flavour = spec.parts.find(p => p.flavour);
      if (R.item.nameFrom === 'flavour' && flavour) parts.push({ id: 'flavour.' + flavour.ing, text: name(pack, flavour.ing) });
      else parts.push(g.n > 1 ? { id: 'recipes.' + spec.recipe, text: R.plural || R.name } : { id: 'recipe.' + spec.recipe, text: R.name });
      const dones = [];
      if (spec.done) dones.push(spec.done);
      spec.parts.forEach(p => { if (p.done && !dones.includes(p.done)) dones.push(p.done); });
      dones.forEach(d => parts.push({ id: 'done.' + d, text: lower(stage(pack, d)) }));
      if (spec.with) {
        if (!spec.with.length) parts.push({ id: 'plain', text: 'plain' });
        else {
          parts.push({ id: 'withJust', text: 'with just' });
          spec.with.forEach((h, i) => {
            if (i && i === spec.with.length - 1) parts.push({ id: 'and', text: 'and' });
            parts.push({ id: 'ing.' + h, text: lower(name(pack, h)) });
          });
        }
      } else {
        (spec.holds || []).forEach(h => parts.push({ id: 'no.' + h, text: 'no ' + lower(plural(pack, h)) }));
        (spec.adds || []).forEach(h => parts.push({ id: 'add.' + h, text: 'add ' + lower(name(pack, h)) }));
      }
    });
    return parts;
  }

  /** Every part any order of these recipes can need, so a voice can be recorded once and
   *  say any order. -> [{ id, text }] */
  function allOrderParts(pack, recipes) {
    const out = new Map();
    const add = (id, text) => { if (!out.has(id)) out.set(id, text); };
    add('and', 'and'); add('plain', 'plain'); add('withJust', 'with just');
    [2, 3].forEach(n => add('count.' + n, cap(NUMBER[n])));
    for (const rid of recipes || Object.keys(pack.recipes)) {
      const R = pack.recipes[rid], T = R.item;
      const pickNames = [];
      const each = v => (v && typeof v === 'object' && v.pick ? (pickNames.push(v.pick), pack.picks[v.pick].fancy || pack.picks[v.pick].values) : [v]);
      if (T.nameFrom === 'flavour') {
        T.parts.forEach(p => { if (p.ing && typeof p.ing === 'object') each(p.ing).forEach(f => add('flavour.' + f, name(pack, f))); });
      } else { add('recipe.' + rid, R.name); add('recipes.' + rid, R.plural || R.name); }
      if (T.size) each(T.size).forEach(z => add('size.' + z, sizeName(pack, T.ing, z)));
      if (T.done) each(T.done).forEach(d => add('done.' + d, lower(stage(pack, d))));
      T.parts.forEach(p => {
        if (p.done) each(p.done).forEach(d => add('done.' + d, lower(stage(pack, d))));
        if (typeof p.ing !== 'string') return;
        if (p.opt === 'in') add('no.' + p.ing, 'no ' + lower(plural(pack, p.ing)));
        if (p.opt === 'out') add('add.' + p.ing, 'add ' + lower(name(pack, p.ing)));
        if (p.opt) add('ing.' + p.ing, lower(name(pack, p.ing)));
      });
    }
    return [...out].map(([id, text]) => ({ id, text }));
  }

  /* ── what was made (the review) ─────────────────────────────────────────── */
  /** How a bad ingredient is said: "the green cheese", "tomato with a hair on it". */
  function grossSay(pack, ing, eventId) {
    const E = (pack.gross || []).find(g => g.id === eventId);
    return E ? E.say.replace('{name}', lower(name(pack, ing))) : lower(name(pack, ing));
  }
  /** The item as made, in plain words: "Cheeseburger: one patty, medium, with cheese,
   *  lettuce and ketchup." A description, never a verdict. */
  function made(pack, m, spec) {
    const R = pack.recipes[m.recipe];
    let h = R.name;
    const flavour = m.parts.find(p => p.flavour);
    if (R.item.nameFrom === 'flavour') h = flavour ? name(pack, flavour.ing) : 'Empty cup';
    if (m.size) h = sizeName(pack, m.ing, m.size) + ' ' + lower(h);
    const bits = [];
    const cooked = {};
    m.parts.forEach(p => { if (p.done !== undefined) (cooked[p.ing] = cooked[p.ing] || []).push(p); });
    // A cookable the recipe uses but none were made: "no patty".
    const usual = spec ? [...new Set(pack.recipes[spec.recipe].item.parts.map(p => p.ing).filter(x => typeof x === 'string' && pack.ingredients[x] && pack.ingredients[x].stages))] : [];
    usual.forEach(ing => { if (!cooked[ing]) bits.push('no ' + lower(name(pack, ing))); });
    Object.keys(cooked).forEach(ing => {
      const n = cooked[ing].length, d = cooked[ing][0].done;
      bits.push(NUMBER[n] + ' ' + lower(n === 1 ? name(pack, ing) : plural(pack, ing)) + (d ? ', ' + lower(stage(pack, d)) : ''));
    });
    if (m.done) bits.push(lower(stage(pack, m.done)));
    const rest = [];
    m.parts.forEach(p => {
      if (p.done !== undefined || p.layer || p.flavour) return;
      const said = p.gross ? grossSay(pack, p.ing, p.gross) : lower(name(pack, p.ing));
      if (!rest.includes(said)) rest.push(said);
    });
    bits.push(rest.length ? 'with ' + list(rest) : 'nothing else on it');
    return h + ': ' + bits.join(', ') + '.';
  }

  /* ── the line's labels ──────────────────────────────────────────────────── */
  /** What is said when a step comes up: on a fresh phase it is spoken before the scan
   *  starts; later steps are announced by their highlighted answer's own label. */
  function prompt(pack, q, o) {
    const st = q.station ? name(pack, q.station) : '';
    if (q.kind === 'review') return 'Here it is.';
    if (q.kind === 'add') {
      const what = q.gross ? grossSay(pack, q.ing, q.gross.event) : lower(name(pack, q.ing));
      if (q.max > 1) return (q.fresh ? st + '. ' : '') + 'Add ' + (q.offer === 1 ? 'a ' + lower(name(pack, q.ing)) : ORDINAL[q.offer] + ' ' + lower(name(pack, q.ing))) + '?';
      return (q.fresh ? st + '. ' : '') + cap(what) + '.';
    }
    if (q.kind === 'cook') {
      const what = 'the ' + lower(q.count > 1 ? plural(pack, q.ing) : name(pack, q.ing));
      return q.timed ? cap(what) + ' ' + (q.count > 1 ? 'are' : 'is') + ' cooking. Take it off when it is right.'
        : 'Cook ' + what + '. How done?';
    }
    if (q.kind === 'pick') {
      if (q.of === 'size') return (q.fresh ? st + '. ' : '') + 'What size?';
      if (q.of === 'flavour') return 'Which one?';
      return (q.fresh ? st + '. ' : '') + list(q.options.filter(x => x.value).map(x => name(pack, x.value))) + '?';
    }
    return '';
  }
  /** An answer's label on screen and what the scan says for it. */
  function option(pack, q, opt, o) {
    const id = opt.id;
    if (q.kind === 'add') {
      const thing = q.gross ? grossSay(pack, q.ing, q.gross.event) : lower(name(pack, q.ing));
      if (id === 'add') {
        if (q.max > 1) return { label: 'Add', say: 'Add ' + (q.offer === 1 ? 'a ' + thing : ORDINAL[q.offer] + ' ' + thing) };
        return { label: 'Add', say: 'Add ' + thing };
      }
      if (id === 'skip') return { label: q.max > 1 && q.have > 0 ? 'Done' : 'Skip', say: q.max > 1 && q.have > 0 ? 'Done, ' + NUMBER[q.have] + ' ' + lower(q.have === 1 ? name(pack, q.ing) : plural(pack, q.ing)) : 'Skip ' + thing };
      if (id === 'swap') return { label: 'Swap It', say: 'Swap ' + thing + ' for a fresh one' };
    }
    if (q.kind === 'cook') {
      if (id === 'takeOff') return { label: 'Take It Off', say: 'Take it off. ' + stage(pack, q.stage) };
      return { label: stage(pack, opt.value), say: stage(pack, opt.value) };
    }
    if (q.kind === 'pick') {
      if (id === 'more') return { label: 'More…', say: 'More choices' };
      const v = opt.value;
      const label = q.of === 'size' ? (o ? sizeName(pack, o.items[q.item].spec.ing, v) : cap(String(v))) : name(pack, v);
      return { label, say: label };
    }
    if (q.kind === 'review') {
      if (id === 'serve') return { label: 'Ring It Up', say: 'Serve it. Ring it up' };
      if (id === 'redo') return { label: 'Redo…', say: 'Redo something' };
      if (opt.row) return { label: itemName(pack, o, opt.item), say: 'Redo the ' + lower(itemName(pack, o, opt.item)) };
      const S = pack.stations[opt.station];
      const label = S.redo || 'Redo the ' + S.name;
      const many = o && o.items.length > 1;
      return { label: many ? label + ' (' + (opt.item + 1) + ')' : label, say: label + (many ? ', item ' + (opt.item + 1) : '') };
    }
    return { label: id, say: id };
  }
  function itemName(pack, o, i) {
    const spec = o.items[i].spec;
    return 'Item ' + (i + 1) + ': ' + head(pack, spec);
  }

  /* ── the receipt ────────────────────────────────────────────────────────── */
  function mistake(pack, m) {
    const N = cap(name(pack, m.ing || ''));
    switch (m.kind) {
      case 'extra': return N + ': not wanted';
      case 'missing': return N + ': left off';
      case 'count': return cap(plural(pack, m.ing)) + ': wanted ' + m.want + ', got ' + m.got;
      case 'done': return N + ': wanted ' + lower(stage(pack, m.want)) + ', got ' + lower(stage(pack, m.got));
      case 'pick': return (m.of === 'size' ? 'Size' : m.of === 'flavour' ? 'Drink' : 'Order') + ': wanted ' +
        lower(m.of === 'size' ? m.want : name(pack, m.want)) + ', got ' + lower(m.got ? (m.of === 'size' ? m.got : name(pack, m.got)) : 'nothing');
      case 'gross': return N + ': ' + grossSay(pack, m.ing, m.event).replace(/^the /, '');
      default: return N;
    }
  }

  return { lower, cap, name, plural, stage, list, sizeName, item, ticket, said, spelled, onWords, groups, orderParts, allOrderParts, made, grossSay, prompt, option, mistake, NUMBER };
});

        if (q.options.some(x => x.row)) names.push('more');
        if (q.options.some(x => x.id === 'done')) names.push('Done');
        const what = q.repeat && q.have > 0 ? cap(ordinal(q.have + 1)) + ' ' + lower(slotName(pack, q.slot)) : slotName(pack, q.slot);
        return lead + what + ': ' + list(names, true) + '?';
      }
      if (q.of === 'size') return lead + 'What size?';
      if (q.of === 'flavour') return 'Which one?';
      return lead + list(q.options.filter(x => x.value).map(x => name(pack, x.value)), true) + '?';   // one of them: "Fries or Onion Rings?"
    }
    return '';
  }
  /** An answer's label on screen and what the scan says for it. */
  function option(pack, q, opt, o) {
    const id = opt.id;
    if (q.kind === 'add') {
      const thing = q.gross ? grossSay(pack, q.ing, q.gross.event) : lower(name(pack, q.ing));
      if (id === 'add') {
        if (q.max > 1) return { label: 'Add', say: 'Add ' + (q.offer === 1 ? 'a ' + thing : ordinal(q.offer) + ' ' + thing) };
        return { label: 'Add', say: 'Add ' + thing };
      }
      if (id === 'skip') return { label: q.max > 1 && q.have > 0 ? 'Done' : 'Skip', say: q.max > 1 && q.have > 0 ? 'Done, ' + number(q.have) + ' ' + lower(q.have === 1 ? name(pack, q.ing) : plural(pack, q.ing)) : 'Skip ' + thing };
      if (id === 'swap') return { label: 'Swap It', say: 'Swap ' + thing + ' for a fresh one' };
    }
    if (q.kind === 'cook') {
      const set = setOf(pack, q);
      if (id === 'takeOff') return set && set.stop ? { label: set.stop, say: cap(lower(set.stop)) + '. ' + stage(pack, q.stage) } : { label: 'Take It Off', say: 'Take it off. ' + stage(pack, q.stage) };
      return { label: stage(pack, opt.value), say: stage(pack, opt.value) };
    }
    if (q.kind === 'pick') {
      if (id === 'more' || id.startsWith('more:')) return { label: 'More…', say: 'More choices' };
      if (q.of === 'slot') {
        if (id === 'done') return { label: 'Done', say: 'Done, ' + repeatSay(pack, q.slot, q.picked || []) };
        const bad = q.gross ? grossPick(pack, q.slot, q.gross.value, q.gross.event) : null;
        if (id === 'swap') return { label: 'Swap It', say: 'Swap ' + bad + ' for a fresh one' };
        if (bad && opt.value === q.gross.value) return { label: cap(bad), say: cap(bad) };
        const label = valueName(pack, q.slot, opt.value);
        return { label, say: label };
      }
      const v = opt.value;
      const label = q.of === 'size' ? (o ? sizeName(pack, o.items[q.item].spec.ing, v) : cap(String(v))) : name(pack, v);
      return { label, say: label };
    }
    if (q.kind === 'review') {
      if (id === 'serve') return { label: 'Ring It Up', say: 'Serve it. Ring it up' };
      if (id === 'redo') return { label: 'Redo…', say: 'Redo something' };
      if (id === 'more' || id.startsWith('more:')) return { label: 'More…', say: 'More to redo' };
      if (opt.row) return { label: itemName(pack, o, opt.item), say: 'Redo the ' + lower(itemName(pack, o, opt.item)) };
      const S = pack.stations[opt.station];
      const label = S.redo || 'Redo the ' + S.name;
      const many = o && o.items.length > 1;
      return { label: many ? label + ' (' + (opt.item + 1) + ')' : label, say: label + (many ? ', item ' + (opt.item + 1) : '') };
    }
    return { label: id, say: id };
  }
  function itemName(pack, o, i) {
    const spec = o.items[i].spec;
    return 'Item ' + (i + 1) + ': ' + head(pack, spec);
  }

  /* ── the receipt, and the words for the script's blanks ────────────────── */
  function mistake(pack, m) {
    if (m.slot !== undefined) {
      const S = cap(slotName(pack, m.slot));
      switch (m.kind) {
        case 'pick': return S + ': wanted ' + lower(valueName(pack, m.slot, m.want)) + ', got ' + (m.got === null || m.got === undefined ? 'nothing' : lower(valueName(pack, m.slot, m.got)));
        case 'count': return cap(slotPlural(pack, m.slot)) + ': wanted ' + m.want + ', got ' + m.got;
        case 'gross': return S + ': ' + grossPick(pack, m.slot, m.value, m.event).replace(/^the /, '');
        default: return S;
      }
    }
    const N = cap(name(pack, m.ing || ''));
    switch (m.kind) {
      case 'extra': return N + ': not wanted';
      case 'missing': return N + ': left off';
      case 'count': return cap(plural(pack, m.ing)) + ': wanted ' + m.want + ', got ' + m.got;
      case 'done': return N + ': wanted ' + lower(stage(pack, m.want)) + ', got ' + lower(stage(pack, m.got));
      case 'pick': return (m.of === 'size' ? 'Size' : m.of === 'flavour' ? 'Drink' : 'Order') + ': wanted ' +
        lower(m.of === 'size' ? m.want : name(pack, m.want)) + ', got ' + lower(m.got ? (m.of === 'size' ? m.got : name(pack, m.got)) : 'nothing');
      case 'gross': return N + ': ' + grossSay(pack, m.ing, m.event).replace(/^the /, '');
      default: return N;
    }
  }
  /** The words for a mistake's or a tutorial warning's blanks, lower case, ready for a line:
   *  { ing, ings, slot, want, got, value, count }, only those that apply. A slot pick gives
   *  {slot} and {want} (I said {want} {slot}: I said white sauce); a cook step or a
   *  doneness gives stages; a count gives numbers in words. */
  function blanks(pack, m) {
    const out = {};
    if (m.ing) { out.ing = lower(name(pack, m.ing)); out.ings = lower(plural(pack, m.ing)); }
    const counted = m.kind === 'count' || m.kind === 'tooMany' || m.kind === 'tooFew';
    if (m.slot !== undefined) {
      out.slot = lower(slotName(pack, m.slot));
      if (counted) { out.count = number(m.want); out.want = number(m.want); }
      else {
        if (m.want !== undefined && m.want !== null) out.want = lower(valueName(pack, m.slot, m.want));
        if (m.got !== undefined && m.got !== null) out.got = lower(valueName(pack, m.slot, m.got));
        if (m.value !== undefined && m.value !== null) out.value = lower(valueName(pack, m.slot, m.value));
      }
      return out;
    }
    const word = v => (m.kind === 'done' ? lower(stage(pack, v)) : m.of === 'size' ? lower(v) : lower(name(pack, v)));
    if (counted) { out.count = number(m.want); out.want = number(m.want); if (m.got !== undefined) out.got = number(m.got); }
    else {
      if (m.want !== undefined && m.want !== null) out.want = word(m.want);
      if (m.got !== undefined && m.got !== null) out.got = word(m.got);
    }
    return out;
  }

  return { lower, cap, name, plural, stage, list, sizeName, item, ticket, said, spelled, onWords, groups, orderParts, allOrderParts, made, grossSay, prompt, option, mistake, NUMBER,
    ORDINAL, number, ordinal, slotName, slotPlural, valueName, valueSay, repeatSay, grossPick, blanks, lineSteps };
});

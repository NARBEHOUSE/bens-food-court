      hasCount: steps.some(st => (st.kind === 'add' && (st.max || 1) > 1) || (st.kind === 'pick' && !!st.repeat)),
      hasCook: steps.some(st => st.kind === 'cook'),
      cookAsks: steps.some(st => st.kind === 'cook' && !((setOf(st) || {}).simple === 'auto')),
      hasPick: steps.some(st => st.kind === 'pick'),

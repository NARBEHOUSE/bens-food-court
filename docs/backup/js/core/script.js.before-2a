    const sets = pack.stageSets || {};
    const setOf = st => (st.stages ? sets[st.stages] : st.ing && pack.ingredients[st.ing] ? sets[pack.ingredients[st.ing].stages] : null);
    const lv = n => Object.assign({}, ((pack.levels || {})[n]) || {});

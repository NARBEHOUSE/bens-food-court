/** Ben's Food Court - the cast's lines that work at ANY restaurant (FOODCOURT-BUILD.md 5.5; docs/api/script.md is the
 *  format; docs/api/cast-script.md says what is here, who has what, and what pack scripts still write).
 *
 *  Only four moments live here: greet, smalltalk, goodbye and mention. A restaurant's script is its own lines plus
 *  these, for the people who come there (BB.script.merge), all counted as the speaker's own. So every line here works at
 *  all seven restaurants: it names no food and nothing of one restaurant's (a mention names the restaurant it is ABOUT,
 *  which is never the one it is said in).
 *    greet      as they walk up; the order follows straight after, so a greeting is one short breath
 *    smalltalk  once an order, after the last station, before the review: about their own lives
 *    goodbye    after the reaction and any complaints (three stars or one), before the receipt: true after either
 *    mention    cross-court gossip, at most once a shift, only about another OPEN restaurant. about: the pack id.
 *               {about} is how a sentence names it (BBCourt `said`: "the Smoothie Shack", "Ben's Sushi"), so it always
 *               sits mid-sentence and never takes 's. Each speaker has one about every restaurant they visit, true to
 *               what they do there (the proposal's "Regulars across the court"), and some about places they don't.
 *  Who: every customer who is not a restaurant's own local. The five who are at every restaurant (marge gus bev vernon
 *  sal) have 6 or more greet, smalltalk and goodbye lines; dale priya oakes tasha reginald kai 4 or more. Locals' lines
 *  live in their own pack (a pack that brings a local in as a cameo writes that visitor's lines in its own script).
 *  Ids: <moment>.c<n> (greet.c1), unique per speaker. Pack scripts never use .c<n>, so the two never collide.
 *  Clip ids: <speaker>/cast:<id> (gus/cast:greet.c1).
 *  delivery: how the final voice pass should say it. [sigh]-style tags are kept for the recording and dropped for
 *  text to speech and captions.
 *
 *  Tone (spec 0.5, DESIGN.md "Writing tone"): adult and dry; the joke is on the customer, never the player; nothing
 *  about speed or skill; nobody hurries anyone; PG; the humour is personality, never accent or background.
 */
(function (root, data) {
  if (typeof module === 'object' && module.exports) module.exports = data;
  else (root.BBScripts = root.BBScripts || {}).cast = data;
})(typeof window === 'undefined' ? globalThis : window, { format: 3, lines: [

  /* ── Marge: warm, unhurried, has seen everything twice (bingo, thirty years on a school bus, forty years married) ── */
  { id: 'greet.c1', who: 'marge', moment: 'greet', text: "Hi, hon. I've just come from bingo, and I'm feeling lucky.", delivery: 'warm, a little pleased with herself' },
  { id: 'greet.c2', who: 'marge', moment: 'greet', text: 'Hello, sweetie. I parked the way I used to park the bus: across three spaces.', delivery: 'warm, not one bit sorry' },
  { id: 'greet.c3', who: 'marge', moment: 'greet', text: 'Hi, hon. Same as always, except my hip.', delivery: 'warm, a touch creaky' },
  { id: 'greet.c4', who: 'marge', moment: 'greet', text: 'Evening, hon. The girls at bingo say hello. Two of them, anyway.', delivery: 'warm, gossipy' },
  { id: 'greet.c5', who: 'marge', moment: 'greet', text: 'Hi, sweetie. Found my reading glasses. They were on my head.', delivery: 'warm, laughing at herself' },
  { id: 'greet.c6', who: 'marge', moment: 'greet', text: 'Hello, hon. Is it Tuesday? It feels like a Tuesday.', delivery: 'warm, pleasantly vague' },
  { id: 'smalltalk.c1', who: 'marge', moment: 'smalltalk', text: 'I won forty dollars at bingo last week. Then I spent fifty celebrating.', delivery: 'warm, conspiratorial' },
  { id: 'smalltalk.c2', who: 'marge', moment: 'smalltalk', text: 'Thirty years on a school bus, hon. I can still hear a whisper from twelve rows back.', delivery: 'warm, matter-of-fact' },
  { id: 'smalltalk.c3', who: 'marge', moment: 'smalltalk', text: 'I was married forty years. He never once guessed my order. I loved him anyway.', delivery: 'fond, dry' },
  { id: 'smalltalk.c4', who: 'marge', moment: 'smalltalk', text: "The girls at bingo think I've got a fella. I don't, hon. I've got a punch card.", delivery: 'warm, sly' },
  { id: 'smalltalk.c5', who: 'marge', moment: 'smalltalk', text: "My grandson wants me to get a smartphone. I told him, hon, I've got a landline and a long memory.", delivery: 'warm, unbothered' },
  { id: 'smalltalk.c6', who: 'marge', moment: 'smalltalk', text: "Same bus route for thirty years, and I never got lost once. I've got lost in this mall twice today.", delivery: 'warm, amused at herself' },
  { id: 'smalltalk.c7', who: 'marge', moment: 'smalltalk', text: "These glasses are on a chain so I can't lose them. Now I lose the chain.", delivery: 'warm, rueful' },
  { id: 'goodbye.c1', who: 'marge', moment: 'goodbye', text: 'Bye, hon. Same time tomorrow.', delivery: 'warm' },
  { id: 'goodbye.c2', who: 'marge', moment: 'goodbye', text: "Bye-bye, sweetie. I'm off to tell the girls everything.", delivery: 'warm, gossipy' },
  { id: 'goodbye.c3', who: 'marge', moment: 'goodbye', text: "Take care, hon. Mind the step. There isn't one. I just always say that.", delivery: "warm, an old bus driver's habit" },
  { id: 'goodbye.c4', who: 'marge', moment: 'goodbye', text: 'Everybody stay seated until the bus comes to a full stop. Sorry, hon. Habit.', delivery: 'warm and automatic, then sheepish' },
  { id: 'goodbye.c5', who: 'marge', moment: 'goodbye', text: "Bye, sweetie. Wear a coat. I don't care what it's like out.", delivery: 'warm, motherly' },
  { id: 'goodbye.c6', who: 'marge', moment: 'goodbye', text: "I'll be back, hon. I always come back. It's the hip. I can't get far.", delivery: 'warm, laughing at herself' },
  // mentions: what she has there (the proposal's table); the diner and pizza are both "the usual, hon"
  { id: 'mention.c1', who: 'marge', moment: 'mention', about: 'smoothie', text: "Strawberry banana at {about}. It's the only fruit pair I trust. The others look like they're up to something.", delivery: 'warm, faintly suspicious' },
  { id: 'mention.c2', who: 'marge', moment: 'mention', about: 'burrito', text: 'Bean and cheese at {about}. The girls say live a little. I live plenty, hon. With beans.', delivery: 'warm, unbothered' },
  { id: 'mention.c3', who: 'marge', moment: 'mention', about: 'pizza', text: "Plain cheese at {about}. My husband said I had no sense of adventure. I married him, didn't I?", delivery: 'warm, dry' },
  { id: 'mention.c4', who: 'marge', moment: 'mention', about: 'diner', text: "At {about} I just say 'the usual' and they know. Like a good marriage, hon. Less snoring.", delivery: 'warm, fond' },
  { id: 'mention.c5', who: 'marge', moment: 'mention', about: 'cafe', text: "Coffee, cream and two sugars at {about}. Same as the bus depot, only nobody's yelling about the heater.", delivery: 'warm, nostalgic' },
  { id: 'mention.c6', who: 'marge', moment: 'mention', about: 'icecream', text: 'Vanilla in a cup at {about}. Cones are for people who trust gravity, hon.', delivery: 'warm, knowing' },
  { id: 'mention.c7', who: 'marge', moment: 'mention', about: 'sushi', text: "I told them at {about}, nothing raw, hon. I raised three kids. I've had enough surprises.", delivery: 'warm, firm' },

  /* ── Gus: deep, friendly, a Western drawl (not slow); eleven hours of interstate behind him; Delores is his rig ── */
  { id: 'greet.c1', who: 'gus', moment: 'greet', text: 'Howdy, buddy. Parked the rig out back. Took up the whole loading dock.', delivery: 'easy, friendly drawl' },
  { id: 'greet.c2', who: 'gus', moment: 'greet', text: "Evenin'. Just me and my appetite. We've been drivin' all day.", delivery: 'warm drawl' },
  { id: 'greet.c3', who: 'gus', moment: 'greet', text: "Well, howdy. Rig's parked, belly's empty, life is good.", delivery: 'contented drawl' },
  { id: 'greet.c4', who: 'gus', moment: 'greet', text: "Hey there, buddy. Three states this mornin', and this one's my favorite.", delivery: 'friendly, amused' },
  { id: 'greet.c5', who: 'gus', moment: 'greet', text: "Mornin'. Or evenin'. Been on the road so long, I can't tell anymore.", delivery: 'cheerful, road-weary' },
  { id: 'greet.c6', who: 'gus', moment: 'greet', text: 'Hey, buddy. Smelled this place from the interstate. Took the exit on faith.', delivery: 'warm, appreciative' },
  { id: 'smalltalk.c1', who: 'gus', moment: 'smalltalk', text: "My rig's got a name. Delores. She's a good girl. Needs new brakes, but don't we all.", delivery: 'fond drawl' },
  { id: 'smalltalk.c2', who: 'gus', moment: 'smalltalk', text: 'Drove through four states today, buddy. Every gift shop sold the same spoon.', delivery: 'amused drawl' },
  { id: 'smalltalk.c3', who: 'gus', moment: 'smalltalk', text: 'I talk to the cows on long drives. They never talk back. Best listeners on the road.', delivery: 'easy, sincere' },
  { id: 'smalltalk.c4', who: 'gus', moment: 'smalltalk', text: "I tip big 'cause my mama waited tables thirty years. She'd haunt me otherwise.", delivery: 'warm, a little sheepish' },
  { id: 'smalltalk.c5', who: 'gus', moment: 'smalltalk', text: 'Got me a CB radio handle. Big Hungry. Earned it fair and square.', delivery: 'proud drawl' },
  { id: 'smalltalk.c6', who: 'gus', moment: 'smalltalk', text: "Saw a moose in Montana once, wearin' a traffic cone. Nobody believes me. The moose does.", delivery: 'deadpan drawl' },
  { id: 'smalltalk.c7', who: 'gus', moment: 'smalltalk', text: "Been married to the road twenty years. Road never calls. But it's always there.", delivery: 'warm, philosophical' },
  { id: 'goodbye.c1', who: 'gus', moment: 'goodbye', text: 'Thank ya kindly, buddy. Back on the road.', delivery: 'warm drawl' },
  { id: 'goodbye.c2', who: 'gus', moment: 'goodbye', text: 'Alright, partner. Leave the porch light on.', delivery: 'friendly drawl' },
  { id: 'goodbye.c3', who: 'gus', moment: 'goodbye', text: 'See ya next time through, buddy. I always come back through.', delivery: 'warm drawl' },
  { id: 'goodbye.c4', who: 'gus', moment: 'goodbye', text: "Gotta run, buddy. Well. Gotta drive. Same thing, sittin' down.", delivery: 'amused drawl' },
  { id: 'goodbye.c5', who: 'gus', moment: 'goodbye', text: "Delores and I thank ya. She's the truck.", delivery: 'fond drawl' },
  { id: 'goodbye.c6', who: 'gus', moment: 'goodbye', text: "Big Hungry, signin' off. Ten-four, buddy.", delivery: 'playful, like a CB radio' },
  // mentions: two of everything, everywhere ("one for now, one for the road")
  { id: 'mention.c1', who: 'gus', moment: 'mention', about: 'smoothie', text: 'Two smoothies at {about}, same deal. The second one made it as far as Tulsa.', delivery: 'fond drawl' },
  { id: 'mention.c2', who: 'gus', moment: 'mention', about: 'burrito', text: "Two burritos at {about}. One for now, one for the road. Both of 'em were for now.", delivery: 'sheepish drawl' },
  { id: 'mention.c3', who: 'gus', moment: 'mention', about: 'pizza', text: 'Two larges at {about}, one for the road. Had to seat-belt it in.', delivery: 'proud drawl' },
  { id: 'mention.c4', who: 'gus', moment: 'mention', about: 'diner', text: "I always get two at {about}. One for now, one for the road. The road's never once said thank you.", delivery: 'warm drawl, amused' },
  { id: 'mention.c5', who: 'gus', moment: 'mention', about: 'cafe', text: 'Two coffees and a dozen donuts at {about}. They asked if it was for the office. My office has eighteen wheels.', delivery: 'warm drawl, pleased' },
  { id: 'mention.c6', who: 'gus', moment: 'mention', about: 'icecream', text: 'Two cones at {about}, one for the road. Do not take ice cream on the road, buddy. Learned that in Arizona.', delivery: 'rueful drawl' },
  { id: 'mention.c7', who: 'gus', moment: 'mention', about: 'sushi', text: "Got two of every roll at {about}. Turns out that's a lot of rolls. Still workin' through 'em in the cab.", delivery: 'cheerful drawl' },

  /* ── Coach Bev: low, butch and booming; every moment is the fourth quarter (caps are her emphasis) ─────────── */
  { id: 'greet.c1', who: 'bev', moment: 'greet', text: 'Coach Bev, reporting for LUNCH!', delivery: 'booming, like roll call' },
  { id: 'greet.c2', who: 'bev', moment: 'greet', text: 'HELLO! Just ran drills with my team, and I am EMPTY!', delivery: 'booming' },
  { id: 'greet.c3', who: 'bev', moment: 'greet', text: 'Big news! My team lost by forty! We are CELEBRATING the effort!', delivery: 'booming, sincerely proud' },
  { id: 'greet.c4', who: 'bev', moment: 'greet', text: 'Whew! Two practices today! I could eat a WHISTLE!', delivery: 'booming, out of breath' },
  { id: 'greet.c5', who: 'bev', moment: 'greet', text: 'Whoo! I skipped breakfast for cardio, and I REGRET IT!', delivery: 'booming, rueful' },
  { id: 'greet.c6', who: 'bev', moment: 'greet', text: 'Hello! Coach Bev! Practice went GREAT! Nobody cried! Well. One.', delivery: 'booming, then a quick aside' },
  { id: 'smalltalk.c1', who: 'bev', moment: 'smalltalk', text: "My team ran laps today! I ran with them! Then I sat down and supervised! That's LEADERSHIP!", delivery: 'booming, proud' },
  { id: 'smalltalk.c2', who: 'bev', moment: 'smalltalk', text: "I coach Little League, junior hockey and the senior center's water polo! The seniors are the MEANEST!", delivery: 'booming, impressed' },
  { id: 'smalltalk.c3', who: 'bev', moment: 'smalltalk', text: 'I blew my whistle at a pigeon this morning! It did NOT respect the whistle!', delivery: 'booming, offended' },
  { id: 'smalltalk.c4', who: 'bev', moment: 'smalltalk', text: "My clipboard's got the whole season on it! Also a grocery list! Also a horse I drew!", delivery: 'booming, then a little bashful' },
  { id: 'smalltalk.c5', who: 'bev', moment: 'smalltalk', text: "Our team motto is 'Leave it all on the field!' We left a shoe on the field! Still LOOKING!", delivery: 'booming, puzzled' },
  { id: 'smalltalk.c6', who: 'bev', moment: 'smalltalk', text: 'I named my car Hail Mary! After my favorite play! It does NOT start in the cold!', delivery: 'booming, fond' },
  { id: 'goodbye.c1', who: 'bev', moment: 'goodbye', text: 'Alright! Hit the showers! Not you! ME!', delivery: 'booming' },
  { id: 'goodbye.c2', who: 'bev', moment: 'goodbye', text: "Thanks! I'm putting this on the TEAM BUDGET!", delivery: 'booming, sneaky' },
  { id: 'goodbye.c3', who: 'bev', moment: 'goodbye', text: "That's the whistle! See you next SEASON! Which is Thursday!", delivery: 'booming' },
  { id: 'goodbye.c4', who: 'bev', moment: 'goodbye', text: 'Cool-down lap! Around the whole food court! TWICE!', delivery: 'booming, already jogging off' },
  { id: 'goodbye.c5', who: 'bev', moment: 'goodbye', text: '[whistle] Bev OUT!', delivery: 'one sharp whistle, then booming' },
  { id: 'goodbye.c6', who: 'bev', moment: 'goodbye', text: "I'll be back! Coaches always come back! It's in the CONTRACT!", delivery: 'booming, cheerful' },
  // mentions: what she orders there, and the counting (pickles at the Burger Bar, jalapeños at Ben's Burritos)
  { id: 'mention.c1', who: 'bev', moment: 'mention', about: 'smoothie', text: 'Protein shake at {about}! Three gulps! Personal best! EVERY time!', delivery: 'booming, triumphant' },
  { id: 'mention.c2', who: 'bev', moment: 'mention', about: 'burrito', text: "At {about}, I count the jalapeños OUT LOUD! The guy next to me joined in! Now it's a DRILL!", delivery: 'booming, counting energy' },
  { id: 'mention.c3', who: 'bev', moment: 'mention', about: 'pizza', text: "Meat lover's at {about}! The only pizza with a full ROSTER!", delivery: 'booming, proud' },
  { id: 'mention.c4', who: 'bev', moment: 'mention', about: 'diner', text: 'At {about}, I count the pickles OUT LOUD! Every pickle is a REP!', delivery: 'booming, counting energy' },
  { id: 'mention.c5', who: 'bev', moment: 'mention', about: 'cafe', text: 'Black coffee at {about}! No cream! No sugar! No EXCUSES!', delivery: 'booming, drill-sergeant rhythm' },
  { id: 'mention.c6', who: 'bev', moment: 'mention', about: 'icecream', text: "Sundae at {about}, for the TEAM! The team wasn't there! It was a MOTIVATIONAL sundae!", delivery: 'booming, unashamed' },
  { id: 'mention.c7', who: 'bev', moment: 'mention', about: 'sushi', text: 'Spicy tuna at {about}! Used the chopsticks! First try! I gave MYSELF a medal!', delivery: 'booming, proud' },

  /* ── Vernon: foppish, fussy, refined, with theatrical sighs; eleven followers hang on every word ──────────── */
  { id: 'greet.c1', who: 'vernon', moment: 'greet', text: '[sigh] Good afternoon. I come on behalf of my readers. All eleven.', delivery: 'haughty and fussy, a theatrical sigh first' },
  { id: 'greet.c2', who: 'vernon', moment: 'greet', text: "Vernon. Of the blog. You'll have heard.", delivery: 'haughty, assuming' },
  { id: 'greet.c3', who: 'vernon', moment: 'greet', text: "Good evening. I've cleared my schedule. It was already clear.", delivery: 'haughty, then a flicker of self-pity' },
  { id: 'greet.c4', who: 'vernon', moment: 'greet', text: "Good afternoon. I've just been unfollowed. I'll be ordering through my grief.", delivery: 'wounded, dignified' },
  { id: 'greet.c5', who: 'vernon', moment: 'greet', text: "[sigh] I'm here. Someone should write that down. I will.", delivery: 'haughty and fussy' },
  { id: 'greet.c6', who: 'vernon', moment: 'greet', text: 'Ah. Good evening. My followers sent me. Well. One of them did.', delivery: 'haughty, deflating' },
  { id: 'smalltalk.c1', who: 'vernon', moment: 'smalltalk', text: 'My blog had twelve followers this morning. Now it has eleven. I know who it was. Gerald.', delivery: 'wounded, icy' },
  { id: 'smalltalk.c2', who: 'vernon', moment: 'smalltalk', text: "I'm writing a memoir. It's called 'Hm.' It's mostly sighs.", delivery: 'refined, completely serious' },
  { id: 'smalltalk.c3', who: 'vernon', moment: 'smalltalk', text: 'I once gave a napkin four stars. Absorbent, yet humble. A remarkable napkin.', delivery: 'refined, reverent' },
  { id: 'smalltalk.c4', who: 'vernon', moment: 'smalltalk', text: "My mother reads every post. She comments, 'Nice, dear.' I have asked her to be more critical.", delivery: 'fussy, long-suffering' },
  { id: 'smalltalk.c5', who: 'vernon', moment: 'smalltalk', text: 'People ask how I stay so refined. I fold my arms. It keeps the refinement in.', delivery: 'haughty, confiding' },
  { id: 'smalltalk.c6', who: 'vernon', moment: 'smalltalk', text: '[sigh] My readers want a podcast. I said no. Some sighs are meant to be read.', delivery: 'a theatrical sigh, then firm' },
  { id: 'goodbye.c1', who: 'vernon', moment: 'goodbye', text: 'My verdict goes up at midnight. Eleven people will be awake for it.', delivery: 'haughty, then faintly hopeful' },
  { id: 'goodbye.c2', who: 'vernon', moment: 'goodbye', text: '[sigh] Farewell. I must go and feel things in writing.', delivery: 'a theatrical sigh, grand' },
  { id: 'goodbye.c3', who: 'vernon', moment: 'goodbye', text: "Good evening. Do not follow me. Unless it's on the blog.", delivery: 'haughty, then hopeful' },
  { id: 'goodbye.c4', who: 'vernon', moment: 'goodbye', text: 'Until next time. There is always a next time. It is my only hobby.', delivery: 'dignified, a little sad' },
  { id: 'goodbye.c5', who: 'vernon', moment: 'goodbye', text: "I'll see myself out. Elegantly. Watch.", delivery: 'haughty, theatrical' },
  { id: 'goodbye.c6', who: 'vernon', moment: 'goodbye', text: '[sigh] Adieu. My readers await. Two of them, realistically.', delivery: 'a theatrical sigh, deflating' },
  // mentions: exact everywhere ("I will know"); at Ben's Sushi he judges beside Chef Hiro
  { id: 'mention.c1', who: 'vernon', moment: 'mention', about: 'smoothie', text: "My blend at {about} is very specific. It's on a laminated card, in my wallet, next to my heart.", delivery: 'fussy, proud' },
  { id: 'mention.c2', who: 'vernon', moment: 'mention', about: 'burrito', text: 'At {about} I have a bowl, nothing touching. Food should have boundaries. So should people.', delivery: 'fussy, firm' },
  { id: 'mention.c3', who: 'vernon', moment: 'mention', about: 'pizza', text: 'At {about}: thin crust, light, cut in eight. Not seven. Not nine. Eight. I will know.', delivery: 'precise, haughty' },
  { id: 'mention.c4', who: 'vernon', moment: 'mention', about: 'diner', text: 'My blog began at {about}. When I branched out, I lost a follower. He came back. They always do.', delivery: 'refined, faintly triumphant' },
  { id: 'mention.c5', who: 'vernon', moment: 'mention', about: 'cafe', text: 'Oat latte, extra hot, at {about}. Hot enough to have opinions. Like me.', delivery: 'haughty, pleased' },
  { id: 'mention.c6', who: 'vernon', moment: 'mention', about: 'icecream', text: 'One scoop at {about}. Exactly one. A second scoop is how standards melt.', delivery: 'precise, grave' },
  { id: 'mention.c7', who: 'vernon', moment: 'mention', about: 'sushi', text: "I dined at {about} beside Chef Hiro. We judged in silence. The best conversation I've had all year.", delivery: 'reverent, refined' },

  /* ── Sal: gruff, loud, a bit crude; sells hot dogs out front and never eats them; pigeons, doctor, brother-in-law ─ */
  { id: 'greet.c1', who: 'sal', moment: 'greet', text: "Ay. Sal. From the cart out front. Don't tell the pigeons I'm in here.", delivery: 'gruff, conspiratorial' },
  { id: 'greet.c2', who: 'sal', moment: 'greet', text: "Yo. My cousin's watchin' my cart. He's eatin' the inventory.", delivery: 'gruff, resigned' },
  { id: 'greet.c3', who: 'sal', moment: 'greet', text: "Ay, how ya doin'? Don't answer. I'm starvin'.", delivery: 'loud, friendly' },
  { id: 'greet.c4', who: 'sal', moment: 'greet', text: "Ay. Day off. Know where I'm spendin' it? Ten feet from my own cart.", delivery: 'gruff, rueful' },
  { id: 'greet.c5', who: 'sal', moment: 'greet', text: "Yo. Somebody tell my doctor I'm at the gym.", delivery: 'gruff, sly' },
  { id: 'greet.c6', who: 'sal', moment: 'greet', text: 'Ay. Pigeons chased me in here. True story.', delivery: 'gruff, a little shaken' },
  { id: 'smalltalk.c1', who: 'sal', moment: 'smalltalk', text: "Worst part of sellin' hot dogs? The pigeons. They know my schedule better than I do.", delivery: 'gruff, aggrieved' },
  { id: 'smalltalk.c2', who: 'sal', moment: 'smalltalk', text: 'My doctor says I gotta cut back. I said, cut back on what? He said, yes.', delivery: 'gruff, indignant' },
  { id: 'smalltalk.c3', who: 'sal', moment: 'smalltalk', text: "My brother-in-law wants to open a second cart. I said, you can't even open a jar.", delivery: 'gruff, scornful' },
  { id: 'smalltalk.c4', who: 'sal', moment: 'smalltalk', text: 'I ride the subway every day. Saw a guy get a full shave on the train. Got off cleaner than me.', delivery: 'gruff, impressed' },
  { id: 'smalltalk.c5', who: 'sal', moment: 'smalltalk', text: "My cart's got a little umbrella. Stuck shut thirty years. I get rained on with dignity.", delivery: 'gruff, proud' },
  { id: 'smalltalk.c6', who: 'sal', moment: 'smalltalk', text: "I'm gonna tell ya a secret. I don't even like hot dogs. Don't tell nobody. Bad for business.", delivery: 'voice lowered, then gruff' },
  { id: 'goodbye.c1', who: 'sal', moment: 'goodbye', text: "Alright, I'm out. Them pigeons ain't gonna yell at themselves.", delivery: 'gruff' },
  { id: 'goodbye.c2', who: 'sal', moment: 'goodbye', text: 'Ay, thanks. Back to the cart. Wish me luck. Actually, wish the cart luck.', delivery: 'gruff, resigned' },
  { id: 'goodbye.c3', who: 'sal', moment: 'goodbye', text: "That's it, I'm goin'. My cousin's still got the cart. There's probably nothin' left.", delivery: 'gruff, dreading it' },
  { id: 'goodbye.c4', who: 'sal', moment: 'goodbye', text: "See ya. Don't tell my doctor I was here. Or my wife. Or the pigeons.", delivery: 'gruff, conspiratorial' },
  { id: 'goodbye.c5', who: 'sal', moment: 'goodbye', text: 'Alright. Gonna walk this off. All the way to the cart. Ten feet.', delivery: 'gruff, groaning' },
  { id: 'goodbye.c6', who: 'sal', moment: 'goodbye', text: 'Later. If anybody asks, I was never here.', delivery: 'gruff, sly' },
  // mentions: never lettuce, anywhere; refuses at the Smoothie Shack, then orders anyway
  { id: 'mention.c1', who: 'sal', moment: 'mention', about: 'smoothie', text: "I walked into {about}. Said I wasn't orderin' nothin'. Then I ordered somethin'. Don't tell nobody.", delivery: 'gruff, embarrassed' },
  { id: 'mention.c2', who: 'sal', moment: 'mention', about: 'burrito', text: "Steak at {about}, no lettuce. I checked twice. Lettuce hides in a burrito. It's sneaky.", delivery: 'gruff, suspicious' },
  { id: 'mention.c3', who: 'sal', moment: 'mention', about: 'pizza', text: 'Pepperoni at {about}. My favorite after bacon. Bacon knows. We talked.', delivery: 'gruff, sincere' },
  { id: 'mention.c4', who: 'sal', moment: 'mention', about: 'diner', text: 'Bacon cheeseburger at {about}. No lettuce. The lettuce knows better than to show its face.', delivery: 'gruff, satisfied' },
  { id: 'mention.c5', who: 'sal', moment: 'mention', about: 'cafe', text: "Black coffee at {about}. No foam, no little leaf. It's coffee, not a paintin'.", delivery: 'gruff, scornful' },
  { id: 'mention.c6', who: 'sal', moment: 'mention', about: 'icecream', text: 'Chocolate at {about}. No rabbit food. Nobody ever put lettuce on ice cream. But you gotta say it.', delivery: 'gruff, principled' },
  { id: 'mention.c7', who: 'sal', moment: 'mention', about: 'sushi', text: 'Asked at {about} if they got a hot dog roll. Chef Hiro gave me a look. I gave it right back.', delivery: 'gruff, unrepentant' },

  /* ── Dale: wiry mechanic, gravelly drawl, never in a hurry; the onion-ring guy (the Burger Bar) ──────────────── */
  { id: 'greet.c1', who: 'dale', moment: 'greet', text: "Evenin'. Just pulled a transmission. Earned this.", delivery: 'slow, gravelly drawl' },
  { id: 'greet.c2', who: 'dale', moment: 'greet', text: "Hey there. Don't mind the grease. It don't come off.", delivery: 'slow, unbothered' },
  { id: 'greet.c3', who: 'dale', moment: 'greet', text: "Howdy. Got a car up on my lift. It'll keep.", delivery: 'slow drawl' },
  { id: 'greet.c4', who: 'dale', moment: 'greet', text: 'Hey. Smells good in here. Better than brake fluid.', delivery: 'slow, appreciative' },
  { id: 'smalltalk.c1', who: 'dale', moment: 'smalltalk', text: 'Fella said his car made a funny noise. I fixed it. Turned up his radio.', delivery: 'slow, dry' },
  { id: 'smalltalk.c2', who: 'dale', moment: 'smalltalk', text: "I can hear what's wrong with any engine. Can't tell what's wrong with my knees.", delivery: 'slow, rueful' },
  { id: 'smalltalk.c3', who: 'dale', moment: 'smalltalk', text: "Thirty-one years under cars. Folks ask if I'm tired. I'm lyin' down most of the day.", delivery: 'slow, dry' },
  { id: 'smalltalk.c4', who: 'dale', moment: 'smalltalk', text: "Wife says I smell like motor oil. I say it's cologne. She says that's the problem.", delivery: 'slow, amused' },
  { id: 'smalltalk.c5', who: 'dale', moment: 'smalltalk', text: "Real nice classic parked out front. Been thinkin' about it all day. Well. The carburetor.", delivery: 'slow, dreamy' },
  { id: 'goodbye.c1', who: 'dale', moment: 'goodbye', text: "Alright. Back to the garage. Somebody's carburetor's cryin'.", delivery: 'slow drawl' },
  { id: 'goodbye.c2', who: 'dale', moment: 'goodbye', text: 'Thank ya. Same time next week. Same grease.', delivery: 'slow, warm' },
  { id: 'goodbye.c3', who: 'dale', moment: 'goodbye', text: 'Drive careful, now. I mean it. I see what happens.', delivery: 'slow, serious' },
  { id: 'goodbye.c4', who: 'dale', moment: 'goodbye', text: 'Take it easy. Check your tire pressure.', delivery: 'slow, kindly' },
  // mentions: he comes only to the Burger Bar (spec 5.4), so his diner line waits for a second restaurant; the rest
  // are what a mechanic notices walking past (each place's machines, as drawn)
  { id: 'mention.c1', who: 'dale', moment: 'mention', about: 'smoothie', text: 'Them blenders at {about} sound like a bad alternator. I offered to take a look.', delivery: 'slow, professional' },
  { id: 'mention.c2', who: 'dale', moment: 'mention', about: 'burrito', text: "They keep a fire extinguisher next to the hottest sauce at {about}. Smart. I'd keep two.", delivery: 'slow, approving' },
  { id: 'mention.c3', who: 'dale', moment: 'mention', about: 'pizza', text: 'Asked at {about} if they do onion rings. Got real quiet in there.', delivery: 'slow, dry' },
  { id: 'mention.c4', who: 'dale', moment: 'mention', about: 'diner', text: "Onion rings at {about}, extra crispy. I'd marry 'em, but they're already rings.", delivery: 'slow, fond' },
  { id: 'mention.c5', who: 'dale', moment: 'mention', about: 'cafe', text: 'That espresso machine at {about} hisses like a busted radiator hose. Itches me to fix it.', delivery: 'slow, itching to fix it' },
  { id: 'mention.c6', who: 'dale', moment: 'mention', about: 'icecream', text: "Shake machine at {about} hums real sweet. Two-horse motor, I'd guess. I'd guess right.", delivery: 'slow, admiring' },
  { id: 'mention.c7', who: 'dale', moment: 'mention', about: 'sushi', text: "Little conveyor belt at {about}. Real nice. Squeaks on the left side. I'd tighten that.", delivery: 'slow, professional' },

  /* ── Priya: night-shift nurse, dry and quick, running on no sleep; the Cafe's most loyal regular ──────────── */
  { id: 'greet.c1', who: 'priya', moment: 'greet', text: "Hi. I've been awake since yesterday. Don't ask which part.", delivery: 'dry, quick, running on fumes' },
  { id: 'greet.c2', who: 'priya', moment: 'greet', text: "Hey. Twelve-hour shift. I'm on hour fourteen.", delivery: 'dry, quick' },
  { id: 'greet.c3', who: 'priya', moment: 'greet', text: "Hi. This is my lunch break. It's four in the morning. Don't make it weird.", delivery: 'dry, daring you to comment' },
  { id: 'greet.c4', who: 'priya', moment: 'greet', text: "Hello. Yes, these are scrubs. No, I won't look at your rash.", delivery: 'dry, quick, heading it off' },
  { id: 'greet.c5', who: 'priya', moment: 'greet', text: "Hi. If I fall asleep standing up, just leave me. I'm fine.", delivery: 'dry, half asleep' },
  { id: 'smalltalk.c1', who: 'priya', moment: 'smalltalk', text: "Someone asked if I'm a real nurse. I said no, I just like the pants.", delivery: 'dry, quick' },
  { id: 'smalltalk.c2', who: 'priya', moment: 'smalltalk', text: "I haven't seen the sun in four days. I hear it's nice.", delivery: 'dry, wistful' },
  { id: 'smalltalk.c3', who: 'priya', moment: 'smalltalk', text: 'My patients call me the night nurse. My houseplants call me, who are you?', delivery: 'dry, quick' },
  { id: 'smalltalk.c4', who: 'priya', moment: 'smalltalk', text: 'People ask what keeps me going on nights. Spite. And about four minutes of sleep.', delivery: 'dry, quick' },
  { id: 'smalltalk.c5', who: 'priya', moment: 'smalltalk', text: "I've been awake so long I can hear colors. Mostly beige.", delivery: 'dry, slightly glazed' },
  { id: 'goodbye.c1', who: 'priya', moment: 'goodbye', text: 'Thanks. Back to the ward. Stay healthy. I mean that professionally.', delivery: 'dry, quick' },
  { id: 'goodbye.c2', who: 'priya', moment: 'goodbye', text: "Okay. Bye. Drink some water. All of you. That's an order.", delivery: 'dry, automatic' },
  { id: 'goodbye.c3', who: 'priya', moment: 'goodbye', text: "Gotta go. Somebody's about to press the call button for a blanket.", delivery: 'dry, resigned' },
  { id: 'goodbye.c4', who: 'priya', moment: 'goodbye', text: "Bye. If you need me, I'll be asleep. Don't need me.", delivery: 'dry, quick' },
  // mentions: she comes only to the Cafe (spec 5.4), so her Cafe line waits for a second restaurant; the Burger Bar
  // one is her old quirk there (breakfast at dinner time, not up for discussion)
  { id: 'mention.c1', who: 'priya', moment: 'mention', about: 'smoothie', text: 'Somebody brought a green smoothie from {about} into the break room. We monitored it overnight. Stable condition.', delivery: 'dry, clinical' },
  { id: 'mention.c2', who: 'priya', moment: 'mention', about: 'burrito', text: 'A burrito from {about} got me through a double shift. I sent it a thank-you card.', delivery: 'dry, sincere' },
  { id: 'mention.c3', who: 'priya', moment: 'mention', about: 'pizza', text: 'I brought pizza from {about} to the night shift once. Fourteen nurses, four minutes. Nothing left but the box.', delivery: 'dry, quick' },
  { id: 'mention.c4', who: 'priya', moment: 'mention', about: 'diner', text: "I order breakfast at {about} at nine at night, and I don't want to talk about it.", delivery: 'dry, closing the subject' },
  { id: 'mention.c5', who: 'priya', moment: 'mention', about: 'cafe', text: "I've been to {about} more this month than I've been home. Home doesn't have a giant donut on the roof.", delivery: 'dry, quick' },
  { id: 'mention.c6', who: 'priya', moment: 'mention', about: 'icecream', text: "Tried eating ice cream from {about} on my break. Got paged twice. It's soup now. Good soup.", delivery: 'dry, resigned' },
  { id: 'mention.c7', who: 'priya', moment: 'mention', about: 'sushi', text: 'Ate at {about} at three in the morning. Chef Hiro was there, judging. At three in the morning. Respect.', delivery: 'dry, impressed' },

  /* ── Professor Oakes: food science, tweed and a bow tie; nasal, nerdy, slightly too fast; a new reason to hate
        onions at every menu that has them (here, "a certain bulb": these lines name no food) ──────────────────── */
  { id: 'greet.c1', who: 'oakes', moment: 'greet', text: "Good afternoon. I've just come from a faculty meeting, so anything is an improvement.", delivery: 'nasal, nerdy, a little too fast' },
  { id: 'greet.c2', who: 'oakes', moment: 'greet', text: "Hello. Professor Oakes, food science. Please don't ask me about food science. I will answer.", delivery: 'nasal, too fast, a warning' },
  { id: 'greet.c3', who: 'oakes', moment: 'greet', text: "Greetings. I've brought three pens in case of emergency. There has never been an emergency.", delivery: 'nasal, earnest' },
  { id: 'greet.c4', who: 'oakes', moment: 'greet', text: "Hello! Fun fact: this is my fourth meal today. I'm conducting a study. On myself.", delivery: 'nasal, delighted' },
  { id: 'smalltalk.c1', who: 'oakes', moment: 'smalltalk', text: 'My new paper is forty pages on a certain bulb. The peer reviewers wept. Which proves my point.', delivery: 'nasal, too fast, vindicated' },
  { id: 'smalltalk.c2', who: 'oakes', moment: 'smalltalk', text: "My students call me Professor Oakes. Behind my back, they call me The Bow Tie. I've never been prouder.", delivery: 'nasal, touched' },
  { id: 'smalltalk.c3', who: 'oakes', moment: 'smalltalk', text: 'I spent a whole semester measuring the crunch of autumn leaves. The results were, frankly, crunchy.', delivery: 'nasal, nerdy, thrilled' },
  { id: 'smalltalk.c4', who: 'oakes', moment: 'smalltalk', text: "Did you know the average tongue has ten thousand taste buds? I've named about forty.", delivery: 'nasal, confiding' },
  { id: 'smalltalk.c5', who: 'oakes', moment: 'smalltalk', text: 'I keep one pocket protector for my pens and a second one for my feelings.', delivery: 'nasal, earnest' },
  { id: 'goodbye.c1', who: 'oakes', moment: 'goodbye', text: "Thank you. I'll be citing this visit in a footnote.", delivery: 'nasal, nerdy' },
  { id: 'goodbye.c2', who: 'oakes', moment: 'goodbye', text: 'Farewell! I have office hours. Nobody ever comes. I go anyway.', delivery: 'nasal, cheerful' },
  { id: 'goodbye.c3', who: 'oakes', moment: 'goodbye', text: 'Goodbye. Remember, correlation is not causation. Unless it is.', delivery: 'nasal, too fast' },
  { id: 'goodbye.c4', who: 'oakes', moment: 'goodbye', text: 'Splendid. Off to the lab. Well, the library. Well, my car.', delivery: 'nasal, deflating' },
  // mentions: a fresh reason at each menu with onions (pico doesn't count, spec 2.3), and his relief at two without
  { id: 'mention.c1', who: 'oakes', moment: 'mention', about: 'burrito', text: "At {about}, I learned pico de gallo contains onion. For my own peace, I've reclassified it as salsa.", delivery: 'nasal, too fast, rattled' },
  { id: 'mention.c2', who: 'oakes', moment: 'mention', about: 'pizza', text: "At {about}, the onions go translucent in the oven. I don't trust food I can see through.", delivery: 'nasal, suspicious' },
  { id: 'mention.c3', who: 'oakes', moment: 'mention', about: 'diner', text: 'At {about}, my case against onions is acoustic. They crunch in a minor key.', delivery: 'nasal, too fast, certain' },
  { id: 'mention.c4', who: 'oakes', moment: 'mention', about: 'cafe', text: "I inspected {about} for onions. Not a single one. I've sent them a thank-you note, with footnotes.", delivery: 'nasal, grateful' },
  { id: 'mention.c5', who: 'oakes', moment: 'mention', about: 'icecream', text: "I visited {about} purely to confirm there are no onions in ice cream. There are none. I've never felt so safe.", delivery: 'nasal, deeply relieved' },

  /* ── Tasha: teenage skateboarder, flat and deadpan; pretends not to care (Smoothie Shack, Ice Cream Emporium) ─── */
  { id: 'greet.c1', who: 'tasha', moment: 'greet', text: "Hey. I'm here, I guess.", delivery: 'flat, deadpan' },
  { id: 'greet.c2', who: 'tasha', moment: 'greet', text: "Sup. Left my board by the door. If it's gone, it's fine. It's not fine.", delivery: 'flat, then a flicker of worry' },
  { id: 'greet.c3', who: 'tasha', moment: 'greet', text: "Hi. I'm not excited. This is just my face.", delivery: 'flat, deadpan' },
  { id: 'greet.c4', who: 'tasha', moment: 'greet', text: "Hey. My friends are at the skate park. I'm here. By choice. Mostly.", delivery: 'flat, deadpan' },
  { id: 'smalltalk.c1', who: 'tasha', moment: 'smalltalk', text: 'Landed a kickflip today. Nobody saw. Whatever. It counts.', delivery: 'flat, secretly proud' },
  { id: 'smalltalk.c2', who: 'tasha', moment: 'smalltalk', text: 'My mom wants me to get a job. I said I already have one. Being unimpressed.', delivery: 'flat, deadpan' },
  { id: 'smalltalk.c3', who: 'tasha', moment: 'smalltalk', text: "Fell off my board three times today. On purpose. It's called practice.", delivery: 'flat, defensive' },
  { id: 'smalltalk.c4', who: 'tasha', moment: 'smalltalk', text: "Everyone at the park says I'm too cool to care. Correct.", delivery: 'flat, deadpan' },
  { id: 'smalltalk.c5', who: 'tasha', moment: 'smalltalk', text: 'My skate video has forty views. Thirty-nine are me.', delivery: 'flat, deadpan' },
  { id: 'goodbye.c1', who: 'tasha', moment: 'goodbye', text: 'Later. Or whatever.', delivery: 'flat' },
  { id: 'goodbye.c2', who: 'tasha', moment: 'goodbye', text: "Okay. Bye. Don't tell anyone I said bye.", delivery: 'flat, deadpan' },
  { id: 'goodbye.c3', who: 'tasha', moment: 'goodbye', text: 'Peace. Gonna go fall off something.', delivery: 'flat, almost cheerful' },
  { id: 'goodbye.c4', who: 'tasha', moment: 'goodbye', text: 'Cool. See you. I mean, probably.', delivery: 'flat, deadpan' },
  // mentions: her two (smoothies, shakes), plus two places she pretends not to go
  { id: 'mention.c1', who: 'tasha', moment: 'mention', about: 'smoothie', text: "I go to {about} every day. Because it's on the way. Also, it's good.", delivery: 'flat, giving up the act' },
  { id: 'mention.c2', who: 'tasha', moment: 'mention', about: 'pizza', text: "My skate crew goes to {about}. I don't sit with them. I sit near them.", delivery: 'flat, deadpan' },
  { id: 'mention.c3', who: 'tasha', moment: 'mention', about: 'diner', text: 'I used to hang out at {about}. Then I got into smoothies. Character growth.', delivery: 'flat, deadpan' },
  { id: 'mention.c4', who: 'tasha', moment: 'mention', about: 'icecream', text: "The shakes at {about} are okay. I've had like forty. For research.", delivery: 'flat, deadpan' },

  /* ── Reginald: self-declared food critic, scarf in all weather; theatrical, sweeping (a visitor from level 4) ─── */
  { id: 'greet.c1', who: 'reginald', moment: 'greet', text: 'Good evening. Reginald. Critic. The scarf is load-bearing.', delivery: 'theatrical, sweeping' },
  { id: 'greet.c2', who: 'reginald', moment: 'greet', text: 'Ah, good afternoon. Do not mind me. I am merely here to experience everything.', delivery: 'theatrical, gracious' },
  { id: 'greet.c3', who: 'reginald', moment: 'greet', text: 'Greetings. I come with an open mind, an empty stomach and a fresh notebook.', delivery: 'theatrical, sweeping' },
  { id: 'greet.c4', who: 'reginald', moment: 'greet', text: "Good evening. Yes, it's me. No, I won't sign anything. Unless you insist.", delivery: 'theatrical, hoping you insist' },
  { id: 'smalltalk.c1', who: 'reginald', moment: 'smalltalk', text: 'People ask how I became a critic. I simply began. Loudly. In public.', delivery: 'theatrical, confiding' },
  { id: 'smalltalk.c2', who: 'reginald', moment: 'smalltalk', text: 'This scarf has been to forty-one restaurants. It has opinions of its own.', delivery: 'theatrical, fond' },
  { id: 'smalltalk.c3', who: 'reginald', moment: 'smalltalk', text: 'I once reviewed a glass of water. Three stars. Wet, but lacking ambition.', delivery: 'theatrical, grave' },
  { id: 'smalltalk.c4', who: 'reginald', moment: 'smalltalk', text: 'My young protégé, Kai, says my reviews are too long. Kai is ten. Kai is also right.', delivery: 'theatrical, rueful' },
  { id: 'smalltalk.c5', who: 'reginald', moment: 'smalltalk', text: 'A critic must suffer for his art. Today I suffered a draft near the escalator.', delivery: 'theatrical, wounded' },
  { id: 'goodbye.c1', who: 'reginald', moment: 'goodbye', text: 'I shall now retire to compose my thoughts. All four thousand of them.', delivery: 'theatrical, grand' },
  { id: 'goodbye.c2', who: 'reginald', moment: 'goodbye', text: 'Farewell. Watch for my review. It arrives in installments.', delivery: 'theatrical' },
  { id: 'goodbye.c3', who: 'reginald', moment: 'goodbye', text: 'Adieu! My scarf and I must away.', delivery: 'theatrical, a sweeping exit' },
  { id: 'goodbye.c4', who: 'reginald', moment: 'goodbye', text: 'Good night. I go now where a critic is truly alone: the parking garage.', delivery: 'theatrical, melancholy' },
  // mentions: whatever is newest, reviewed at length (the crowned coffee bean hangs in the Cafe's counter picture)
  { id: 'mention.c1', who: 'reginald', moment: 'mention', about: 'smoothie', text: 'At {about}, the newest blend had no name. I named it. Modestly. After myself.', delivery: 'theatrical, pleased' },
  { id: 'mention.c2', who: 'reginald', moment: 'mention', about: 'burrito', text: 'At {about}, I called a burrito a novel you can hold. Kai called it big. We are both correct.', delivery: 'theatrical, magnanimous' },
  { id: 'mention.c3', who: 'reginald', moment: 'mention', about: 'pizza', text: 'My review of {about} ran in three parts. Part two was the crust alone.', delivery: 'theatrical, grave' },
  { id: 'mention.c4', who: 'reginald', moment: 'mention', about: 'diner', text: 'At {about}, I once reviewed a single French fry. Four thousand words. The fry has since retired.', delivery: 'theatrical, reverent' },
  { id: 'mention.c5', who: 'reginald', moment: 'mention', about: 'cafe', text: 'At {about} hangs a portrait of a crowned coffee bean. I wrote to it. It has not written back.', delivery: 'theatrical, wounded' },
  { id: 'mention.c6', who: 'reginald', moment: 'mention', about: 'icecream', text: 'At {about}, I reviewed a sundae in five courses. The cherry was dessert.', delivery: 'theatrical, satisfied' },
  { id: 'mention.c7', who: 'reginald', moment: 'mention', about: 'sushi', text: 'I sat beside Chef Hiro at {about}. He nodded once. I have been writing about that nod for a month.', delivery: 'theatrical, awed' },

  /* ── Kai: ten, notebook under one arm, Reginald's biggest fan; bright, very serious, gets to the point ──────── */
  { id: 'greet.c1', who: 'kai', moment: 'greet', text: "Hello. I'm Kai. I review food. I keep it short.", delivery: 'bright, very serious' },
  { id: 'greet.c2', who: 'kai', moment: 'greet', text: 'Hi. Reginald says a critic arrives quietly. So: hi.', delivery: 'bright, whispering the last word' },
  { id: 'greet.c3', who: 'kai', moment: 'greet', text: 'Good evening. I have my notebook and two pencils. One is a backup.', delivery: 'bright, very serious' },
  { id: 'greet.c4', who: 'kai', moment: 'greet', text: "Hello. My mom is in the shoe store. I'm working.", delivery: 'bright, very serious' },
  { id: 'smalltalk.c1', who: 'kai', moment: 'smalltalk', text: 'Reginald writes four thousand words. I write four. My readers like mine better. Both of them.', delivery: 'bright, very serious' },
  { id: 'smalltalk.c2', who: 'kai', moment: 'smalltalk', text: "I gave my school cafeteria two stars. Now I'm in charge of the newsletter.", delivery: 'bright, proud' },
  { id: 'smalltalk.c3', who: 'kai', moment: 'smalltalk', text: "My notebook has stars, smiley faces, and one frowny face. I'm saving it for something special.", delivery: 'bright, very serious' },
  { id: 'smalltalk.c4', who: 'kai', moment: 'smalltalk', text: "When I grow up, I want a scarf like Reginald's. Mom says not in summer.", delivery: 'bright, a little let down' },
  { id: 'smalltalk.c5', who: 'kai', moment: 'smalltalk', text: "My review of my sister's birthday party was two words. Too loud.", delivery: 'bright, very serious' },
  { id: 'goodbye.c1', who: 'kai', moment: 'goodbye', text: "Thank you. Review coming soon. It's short.", delivery: 'bright, very serious' },
  { id: 'goodbye.c2', who: 'kai', moment: 'goodbye', text: 'Goodbye. I have homework. And a review. Review first.', delivery: 'bright, very serious' },
  { id: 'goodbye.c3', who: 'kai', moment: 'goodbye', text: 'Bye. Reginald says always leave them wanting more. So: bye.', delivery: 'bright, very serious' },
  { id: 'goodbye.c4', who: 'kai', moment: 'goodbye', text: "Okay. I have to go find my mom. She's in shoes.", delivery: 'bright, very serious' },
  // mentions: Reginald's reviews, cut to the point
  { id: 'mention.c1', who: 'kai', moment: 'mention', about: 'smoothie', text: 'My review of {about}: cold, pink, brain freeze, worth it.', delivery: 'bright, very serious' },
  { id: 'mention.c2', who: 'kai', moment: 'mention', about: 'burrito', text: "At {about}, Reginald called the burrito a novel you can hold. I called it big. Mine's easier to read.", delivery: 'bright, very serious' },
  { id: 'mention.c3', who: 'kai', moment: 'mention', about: 'pizza', text: 'My review of {about}: round, hot, ten out of ten. Reginald said it lacked mystery.', delivery: 'bright, very serious' },
  { id: 'mention.c4', who: 'kai', moment: 'mention', about: 'diner', text: 'I reviewed {about} in two words. Big burger. Reginald said add more words. I added very.', delivery: 'bright, very serious' },
  { id: 'mention.c5', who: 'kai', moment: 'mention', about: 'cafe', text: "I'm not allowed coffee, so at {about} I reviewed a donut. Circle. Delicious. The hole is efficient.", delivery: 'bright, very serious' },
  { id: 'mention.c6', who: 'kai', moment: 'mention', about: 'icecream', text: "My review of {about}: cold, correct. Reginald says that's not a review. It's a weather report.", delivery: 'bright, very serious' },
  { id: 'mention.c7', who: 'kai', moment: 'mention', about: 'sushi', text: "I tried {about}. Chef Hiro nodded at me. I wrote it down. That's my first nod.", delivery: 'bright, very proud' },
] });

/** Ben's Food Court - the court's lines (FOODCOURT-BUILD.md 5.5 and 6.2; docs/api/script.md is the format;
 *  docs/api/cast-script.md says what is here and how the page should play it).
 *
 *  Mitch (back on the court, in his shirt and tie):
 *    court.return {goal}   when the goal has changed (once a session at least). {goal} is BB.courtRules.nextGoal().goal:
 *                          a lower-case clause with no full stop ("get all three to three stars and the Smoothie Shack
 *                          opens", "get all seven fully busy"), so every line puts it mid-sentence. Never said when the
 *                          goal is '' (all seven at five stars and fully busy).
 *    court.unlock {name}   a restaurant opened (after the announcer). {name}: the full name, "Ben's Smoothie Shack".
 *    court.goldSign {name} a gold sign went up (after the announcer).
 *    court.celebrate       the grand celebration, after the cheers.
 *    court.promoted        then the ASST. tape comes off his badge (the `promoted` pose).
 *  pa, the mall announcer (voice only): court.announce.open {name}, court.announce.gold {name}. Warm, a touch
 *    over-formal, and short (one breath, well inside the 10 s speech cap).
 *  shopper: court.chatter, captions only, never spoken. Each line is true at any point in the game: it names only the
 *    three restaurants open from the start, or nobody, and never the player.
 *  court.cheer: one each for every customer in the cast (regulars, visitors, locals), at the grand celebration. Short,
 *    because they come one after another.
 *  Ids: <moment>.<n> without the "court." (return.1, cheer.1). Clip ids: <speaker>/court:<id> (mitch/court:return.1).
 *  delivery: how the final voice pass should say it ([peels tape]-style tags are dropped for TTS and captions).
 *
 *  Tone (spec 0.5): adult and dry; the joke is on Mitch, the shoppers and the customers, never the player; nothing about
 *  speed or skill; PG.
 */
(function (root, data) {
  if (typeof module === 'object' && module.exports) module.exports = data;
  else (root.BBScripts = root.BBScripts || {}).court = data;
})(typeof window === 'undefined' ? globalThis : window, { format: 3, lines: [

  /* ── Mitch: back on the court, the next goal ({goal} sits mid-sentence) ─────────────────────────────────── */
  { id: 'return.1', who: 'mitch', moment: 'court.return', text: 'Back on the floor! Next up: {goal}.', delivery: 'upbeat, a little too confident' },
  { id: 'return.2', who: 'mitch', moment: 'court.return', text: 'Team meeting. The team is you. The agenda: {goal}.', delivery: 'upbeat, mock-official' },
  { id: 'return.3', who: 'mitch', moment: 'court.return', text: 'Corporate called. Corporate is my mom. She says {goal}.', delivery: 'eager, then a quick aside' },
  { id: 'return.4', who: 'mitch', moment: 'court.return', text: 'I updated the progress board. It updates itself, but I watched. Anyway: {goal}.', delivery: 'proud, then sheepish' },
  { id: 'return.5', who: 'mitch', moment: 'court.return', text: 'Big-picture time. I love big-picture time. Here it is: {goal}.', delivery: 'eager, building it up' },
  { id: 'return.6', who: 'mitch', moment: 'court.return', text: "My headset says {goal}. It isn't plugged in. I just know things.", delivery: 'confident, conspiratorial' },
  { id: 'return.7', who: 'mitch', moment: 'court.return', text: "Here's the plan, and I made it myself: {goal}. I'll handle the pointing.", delivery: 'upbeat, proud' },
  { id: 'return.8', who: 'mitch', moment: 'court.return', text: "Five-year plan, condensed: {goal}. I'm having it printed on a mug.", delivery: 'eager' },

  /* ── Mitch: a restaurant opens; a gold sign goes up ({name} is the full name) ───────────────────────────── */
  { id: 'unlock.1', who: 'mitch', moment: 'court.unlock', text: "{name} is open! New restaurant, new uniform. I've been practicing in the mirror.", delivery: 'thrilled' },
  { id: 'unlock.2', who: 'mitch', moment: 'court.unlock', text: 'Look at that shutter go! {name}! Same badge, same tape, whole new outfit.', delivery: 'thrilled, admiring' },
  { id: 'unlock.3', who: 'mitch', moment: 'court.unlock', text: "{name} is officially open. I cut the ribbon. There wasn't a ribbon. I cut the air.", delivery: 'proud, then deadpan' },
  { id: 'unlock.4', who: 'mitch', moment: 'court.unlock', text: "Grand opening at {name}! I've already memorized the menu. Mostly the pictures.", delivery: 'eager' },
  { id: 'goldSign.1', who: 'mitch', moment: 'court.goldSign', text: "A gold sign on {name}! I'd like to thank my mom, who is also corporate.", delivery: 'thrilled, then an aside' },
  { id: 'goldSign.2', who: 'mitch', moment: 'court.goldSign', text: "Look at that gold sign on {name}. I'm not crying. It's just very shiny.", delivery: 'choked up, insisting he is fine' },
  { id: 'goldSign.3', who: 'mitch', moment: 'court.goldSign', text: "Five stars for {name}! I'm putting a gold star on my badge. Right next to the tape.", delivery: 'proud' },
  { id: 'goldSign.4', who: 'mitch', moment: 'court.goldSign', text: "{name} has its gold sign! I'm standing next to it in every photo from now on.", delivery: 'giddy' },

  /* ── Mitch: the grand celebration, then the promotion (the tape comes off) ──────────────────────────────── */
  { id: 'celebrate.1', who: 'mitch', moment: 'court.celebrate', text: "All seven restaurants! Five stars each! Fireworks! I didn't approve the fireworks, but I'm allowing them.", delivery: 'overjoyed, then mock-stern' },
  { id: 'celebrate.2', who: 'mitch', moment: 'court.celebrate', text: "Seven gold signs. The greatest day in food court history. I checked. I'm the historian.", delivery: 'overjoyed, proud' },
  { id: 'celebrate.3', who: 'mitch', moment: 'court.celebrate', text: "Every restaurant at five stars. I had a speech. I'm too emotional. Here's the speech: wow.", delivery: 'choked up, then beaming' },
  { id: 'promoted.1', who: 'mitch', moment: 'court.promoted', text: 'Corporate says I can take the tape off? [peels tape] Manager. It was right under there the whole time.', delivery: 'disbelief, then awe' },
  { id: 'promoted.2', who: 'mitch', moment: 'court.promoted', text: "The tape is coming off. [peels tape] Hello. Manager Mitch. I'm keeping the tape, for the scrapbook.", delivery: 'ceremonial, then emotional' },
  { id: 'promoted.3', who: 'mitch', moment: 'court.promoted', text: "[peels tape] Manager. I'd like to thank my mom, the board of directors, and also my mom.", delivery: 'emotional, grateful' },

  /* ── the announcer: warm, slightly over-formal mall public address ──────────────────────────────────────── */
  { id: 'open.1', who: 'pa', moment: 'court.announce.open', text: 'Attention, shoppers. The management is delighted to announce the grand opening of {name}. Please proceed calmly, and hungrily.', delivery: 'smooth, bright, over-formal' },
  { id: 'open.2', who: 'pa', moment: 'court.announce.open', text: 'Good day, valued shoppers. {name} is now open for business. Strollers, scooters and pretzels are all welcome.', delivery: 'warm, over-formal' },
  { id: 'open.3', who: 'pa', moment: 'court.announce.open', text: 'Attention, please. The shutter is up at {name}. The Grand Opening banner is decorative, and is not a snack.', delivery: 'smooth, gently stern' },
  { id: 'open.4', who: 'pa', moment: 'court.announce.open', text: 'Courtesy announcement. {name} is now open. Please do not hold the doors. They are shutters. They go up.', delivery: 'smooth, patient' },
  { id: 'gold.1', who: 'pa', moment: 'court.announce.gold', text: 'Attention, shoppers. {name} has five stars and a gold sign. Please admire it from a respectful distance.', delivery: 'smooth, over-formal' },
  { id: 'gold.2', who: 'pa', moment: 'court.announce.gold', text: 'Good news, shoppers. {name} has earned its gold sign. Please do not take it home. It is bolted on.', delivery: 'warm, then firm' },
  { id: 'gold.3', who: 'pa', moment: 'court.announce.gold', text: 'Attention, please. A gold sign now hangs at {name}. Sunglasses are available at the kiosk on level two.', delivery: 'smooth, bright' },
  { id: 'gold.4', who: 'pa', moment: 'court.announce.gold', text: 'Special announcement. {name} now has five stars. Congratulations from the management, and also from the parking garage.', delivery: 'over-formal, sincere' },

  /* ── shoppers: overheard chatter, captions only (never spoken, never over the highlighted storefront) ────── */
  { id: 'chatter.1', who: 'shopper', moment: 'court.chatter', text: 'Is that the hot-dog man? Eating in the food court? His cart is right outside.', delivery: 'caption only, never recorded' },
  { id: 'chatter.2', who: 'shopper', moment: 'court.chatter', text: "That security guard on the tiny scooter has passed me four times. I think he's showing off.", delivery: 'caption only, never recorded' },
  { id: 'chatter.3', who: 'shopper', moment: 'court.chatter', text: 'I just asked a planter if this seat was taken. Long day.', delivery: 'caption only, never recorded' },
  { id: 'chatter.4', who: 'shopper', moment: 'court.chatter', text: "The Cafe has a giant donut on its roof. I'm not even hungry. I just respect it.", delivery: 'caption only, never recorded' },
  { id: 'chatter.5', who: 'shopper', moment: 'court.chatter', text: 'A man at the Burger Bar just reviewed his lunch out loud. For his eleven followers. None of them were there.', delivery: 'caption only, never recorded' },
  { id: 'chatter.6', who: 'shopper', moment: 'court.chatter', text: "There's a man at the Pizza Parlor arguing with a pineapple. In song.", delivery: 'caption only, never recorded' },
  { id: 'chatter.7', who: 'shopper', moment: 'court.chatter', text: "I came in for socks. I'm leaving with no socks and a very full stomach.", delivery: 'caption only, never recorded' },
  { id: 'chatter.8', who: 'shopper', moment: 'court.chatter', text: "Who puts a progress board in a food court? I'm weirdly invested now.", delivery: 'caption only, never recorded' },
  { id: 'chatter.9', who: 'shopper', moment: 'court.chatter', text: 'A lady just called me hon, and I feel ten years younger.', delivery: 'caption only, never recorded' },
  { id: 'chatter.10', who: 'shopper', moment: 'court.chatter', text: 'Is that a coach blowing a whistle at a pigeon?', delivery: 'caption only, never recorded' },
  { id: 'chatter.11', who: 'shopper', moment: 'court.chatter', text: "That trucker ordered two of everything. One for the road. Sir, the road doesn't eat.", delivery: 'caption only, never recorded' },
  { id: 'chatter.12', who: 'shopper', moment: 'court.chatter', text: 'Every time I walk past, that man in the headset is pointing at something.', delivery: 'caption only, never recorded' },
  { id: 'chatter.13', who: 'shopper', moment: 'court.chatter', text: 'My lunch break ended an hour ago. I live here now.', delivery: 'caption only, never recorded' },
  { id: 'chatter.14', who: 'shopper', moment: 'court.chatter', text: 'My kid wants to eat at all seven. Today.', delivery: 'caption only, never recorded' },
  { id: 'chatter.15', who: 'shopper', moment: 'court.chatter', text: "My doctor said eat more greens, so I'm sitting next to the plants.", delivery: 'caption only, never recorded' },
  { id: 'chatter.16', who: 'shopper', moment: 'court.chatter', text: "I love a food court. It's a mall, but just the important parts.", delivery: 'caption only, never recorded' },


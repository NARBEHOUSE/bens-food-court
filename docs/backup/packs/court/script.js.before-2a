  { id: 'cheer.1', who: 'jitters', moment: 'court.cheer', text: "Gold-signs-everywhere-gold-signs! I need to sit down! I can't sit down!", delivery: 'very fast, wired' },
  { id: 'cheer.1', who: 'hiro', moment: 'court.cheer', text: 'I will allow myself one smile. There. It is done.', delivery: 'calm, low, quietly funny' },
  { id: 'cheer.1', who: 'dennis', moment: 'court.cheer', text: 'Is it safe to cheer? It is? Okay. Hooray! Quietly! Hooray!', delivery: 'anxious, then thrilled' },

  // regulars at every restaurant
  { id: 'cheer.1', who: 'marge', moment: 'court.cheer', text: "Oh, hon, look at all that gold! I'm telling the girls at bingo!", delivery: 'delighted, warm' },
  { id: 'cheer.1', who: 'gus', moment: 'court.cheer', text: 'Seven for seven! Somebody honk the horn on my rig!', delivery: 'joyful drawl, a big laugh' },
  { id: 'cheer.1', who: 'bev', moment: 'court.cheer', text: 'CHAMPIONSHIP SEASON! Everybody gets a TROPHY! I brought ONE!', delivery: 'firm, like a coach, triumphant' },
  { id: 'cheer.1', who: 'vernon', moment: 'court.cheer', text: "[sigh] Fine. It's magnificent. I may have to write something nice. Brace yourselves.", delivery: 'grudging, secretly moved' },
  { id: 'cheer.1', who: 'sal', moment: 'court.cheer', text: "Ay! Look at all them gold signs! Even the pigeons are clappin'!", delivery: 'gruff, delighted' },
  // recurring regulars
  { id: 'cheer.1', who: 'dale', moment: 'court.cheer', text: "Well, I'll be. Shinier than a fresh chrome bumper.", delivery: 'slow, impressed' },
  { id: 'cheer.1', who: 'priya', moment: 'court.cheer', text: "I stayed awake for this. That's the highest honor I've got.", delivery: 'dry, quietly sincere' },

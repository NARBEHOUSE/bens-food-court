        queue: [[27, 36], [26.8, 40], [26.6, 44], [26.4, 48], [26.2, 52]],
        seats: [[38.3, 36.6], [38.4, 41.0], [43.8, 36.6], [43.9, 41.0]],
        passing: [[21, 36.5, 29.5, 36.5], [27.5, 38, 27.5, 50]],
      },
      diner: {

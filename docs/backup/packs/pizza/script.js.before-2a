/** Ben's Pizza Parlor - every line about this restaurant's food (FOODCOURT-BUILD.md 5.5; docs/api/script.md is the
 *  format; docs/api/packs/pizza.md section 12 says who must have what; docs/api/packs/pizza-script.md is this file
 *  in words, for the content agents after it).
 *
 *  What is here: Mitch's lines in his pizza uniform (the shift, the tutorial at every station, every warning, every
 *  gross-out, the Timed heads-up, the one-liners, the Pizza Party), the 'customer' fallbacks for every F moment, the
 *  locals' full sets (Tony, Pam), the cameo's (Breeze, the Smoothie Shack's surfer, here as a level-4 visitor), and
 *  every regular's and visitor's lines about the pizza (reactions, favourites, dislikes, odd orders, complaints).
 *  greet, smalltalk and goodbye for everyone who is not a local or the cameo come from packs/cast/script.js and are
 *  merged in; the few here for them are restaurant-flavoured extras.
 *
 *  A line is { id, who, moment, text, each?, delivery? }. Ids are <moment>.<n>, unique per speaker (the cast script
 *  uses .c<n>, so the two never collide). Clip ids: <speaker>/pizza:<id>[.<value>] (tony/pizza:react.3.1,
 *  vernon/pizza:complain.pick.1.sauce.white). `each` names the one blank whose value changes the words (one
 *  recording per value): {ing}/{ings} on Add moments, {want} on stage and pick moments. A pick line uses {slot} and
 *  {want} together ("for the {slot}, I said {want}"), never "{want} {slot}", because the None sauce would read "none
 *  sauce"; with each: 'want' its clip is per slot and value. No line starts with a lower-cased blank. [sigh]-style
 *  tags are kept for the recording and dropped for text to speech and captions. delivery: for the final voice pass.
 *
 *  Tone (spec 0.5, DESIGN.md "Writing tone"): adult and dry; the joke is on the customer, the food or Mitch, never
 *  the player; nothing about speed or skill; nobody hurries anyone; PG; the humour is personality, never accent or
 *  background (Tony's is grandeur and passion, not where he is from). Customer rules (spec 0.6): a gag is one line of
 *  8 seconds or less over a normal order; "for twelve" and "two larges" are said, never made.
 */
(function (root, data) {
  if (typeof module === 'object' && module.exports) module.exports = data;
  else (root.BBScripts = root.BBScripts || {}).pizza = data;
})(typeof window === 'undefined' ? globalThis : window, { format: 3, lines: [

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     MITCH, in the flour-dusted apron and the pizza-box hat
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */

  /* ── the shift ─────────────────────────────────────────────────────────────────────────────────────────────── */
  { id: 'shift.start.1', who: 'mitch', moment: 'shift.start', text: "Doors are open. The oven's hot, the dough's proofed, and there's flour somewhere on me I can't reach.", delivery: 'upbeat, scratching at the flour' },
  { id: 'shift.start.2', who: 'mitch', moment: 'shift.start', text: "Pizza Parlor, day shift. The customer is always right. Unless it's Tony, and then he's just loud.", delivery: 'cheerful, the Tony part confided' },
  { id: 'shift.start.3', who: 'mitch', moment: 'shift.start', text: "Let's go. Corporate called. Corporate is my mom. She asked if we do gluten-free. We don't. Don't tell her.", delivery: 'eager, a nervous aside at the end' },
  { id: 'shift.start.4', who: 'mitch', moment: 'shift.start', text: "Doors open! Crust, sauce, cheese, toppings, oven, cut. Six things. I can count to six. I've been practising.", delivery: 'brisk, proud of the counting' },
  { id: 'shift.start.5', who: 'mitch', moment: 'shift.start', text: "Shift's on. If you hear singing, that's Tony. If you hear screaming, that's also Tony.", delivery: 'upbeat, matter-of-fact' },
  { id: 'shift.end.1', who: 'mitch', moment: 'shift.end', text: "That's the shift. Nobody got pineapple by accident. Tony sent a thank-you note. It was a song.", delivery: 'relieved, fond' },
  { id: 'shift.end.2', who: 'mitch', moment: 'shift.end', text: "Doors are locked, oven's off. I'm keeping the hat on. It's load-bearing now.", delivery: 'tired, a little proud' },
  { id: 'shift.end.3', who: 'mitch', moment: 'shift.end', text: "Great shift. I supervised the oven. The oven didn't need it. I needed it.", delivery: 'cheerful, a confession' },
  { id: 'shift.end.4', who: 'mitch', moment: 'shift.end', text: "Shift's over. I'm going home smelling like garlic. My mom will know. She always knows.", delivery: 'resigned, affectionate' },

  /* ── the uniform: the first shift here in a session ────────────────────────────────────────────────────────── */
  { id: 'uniform.1', who: 'mitch', moment: 'uniform', text: 'Yes, the hat is a pizza box. A real one. Corporate calls it branding. Corporate is my mom, and she has a glue gun.', delivery: 'pre-empting the question, deadpan' },
  { id: 'uniform.2', who: 'mitch', moment: 'uniform', text: 'The apron was clean this morning. Then the flour found it. The flour always finds it. The flour is patient.', delivery: 'ominous, about flour' },
  { id: 'uniform.3', who: 'mitch', moment: 'uniform', text: "Pizza-box hat, flour apron, and the tie stays. The tie is who I am. The hat is who I'm becoming.", delivery: 'earnest, a little grand' },

  /* ── gross-outs, said as the bad one comes down the line (all on Add steps: {ing}) ─────────────────────────── */
  { id: 'gross.hair.1', who: 'mitch', moment: 'gross.hair', each: 'ing', text: "There's a hair in the {ing}. Nobody here has hair that long. Swap it.", delivery: 'alarmed, then suspicious' },
  { id: 'gross.hair.2', who: 'mitch', moment: 'gross.hair', each: 'ing', text: 'Hair in the {ing}. Long one. Curly. I have questions. Swap it first.', delivery: 'grossed out, peering closer' },
  { id: 'gross.hair.3', who: 'mitch', moment: 'gross.hair', each: 'ing', text: 'That {ing} came with a hair. The hair is not on the ticket. Swap it.', delivery: 'brisk, disgusted' },
  { id: 'gross.mouldy.1', who: 'mitch', moment: 'gross.mouldy', each: 'ings', text: 'Those {ings} are green. That is not a colour they come in. Swap them.', delivery: 'horrified, certain' },
  { id: 'gross.mouldy.2', who: 'mitch', moment: 'gross.mouldy', each: 'ings', text: 'Whoa. Those {ings} have a beard. Swap them out.', delivery: 'a recoil, then quick' },
  { id: 'gross.mouldy.3', who: 'mitch', moment: 'gross.mouldy', each: 'ings', text: 'Why are the {ings} fuzzy? No. Nope. Get fresh ones.', delivery: 'squeamish, backing away' },
  { id: 'gross.fly.1', who: 'mitch', moment: 'gross.fly', each: 'ing', text: "There's a fly on the {ing}. He's not a topping. Swap it.", delivery: 'sharp, then flat' },
  { id: 'gross.fly.2', who: 'mitch', moment: 'gross.fly', each: 'ing', text: "Fly on the {ing}! He doesn't work here. Swap it before he asks for a shift.", delivery: 'alarmed, then a grumble' },
  { id: 'gross.fly.3', who: 'mitch', moment: 'gross.fly', each: 'ing', text: 'That {ing} has a passenger. Swap it. The fly stays here. With me. Great.', delivery: 'resigned, muttering the end' },

  /* ── Timed: one stage before the ticket's ──────────────────────────────────────────────────────────────────── */
  { id: 'nearly.1', who: 'mitch', moment: 'nearly', each: 'want', text: "Nearly {want}. That's the one on the ticket.", delivery: 'quick, a little nervous' },
  { id: 'nearly.2', who: 'mitch', moment: 'nearly', each: 'want', text: 'Heads up. Almost {want}. Just saying.', delivery: 'quick, a little nervous' },

  /* ── Mitch: the mistake, read after the customer's complaint (voicecut, 2026-11-10): one line per value, his voice only ── */
  { id: 'mistake.extra.1', who: 'mitch', moment: 'mistake.extra', each: 'ings', text: 'The ticket said no {ings}.', delivery: 'flat, reading it off the ticket' },
  { id: 'mistake.unasked.1', who: 'mitch', moment: 'mistake.unasked', each: 'ings', text: 'Nobody ordered {ings}.', delivery: 'flat, reading it off the ticket' },
  { id: 'mistake.missing.1', who: 'mitch', moment: 'mistake.missing', each: 'ing', text: 'The ticket said {ing}. That got left off.', delivery: 'flat, reading it off the ticket' },
  { id: 'mistake.done.1', who: 'mitch', moment: 'mistake.done', each: 'want', text: 'The ticket said {want}.', delivery: 'flat, reading it off the ticket' },
  { id: 'mistake.pick.1', who: 'mitch', moment: 'mistake.pick', each: 'wanted', text: 'The ticket said {wanted}.', delivery: 'flat, reading it off the ticket' },
  { id: 'mistake.more.1', who: 'mitch', moment: 'mistake.more', text: "And more. It's all on the receipt. Long receipt. Good paper, at least.", delivery: 'resigned, dry' },

  /* ── one-liners after a customer's reaction (Hints and Jokes only) ─────────────────────────────────────────── */
  { id: 'after.3.1', who: 'mitch', moment: 'after.3', text: "Another happy customer. I'll take the credit. I'll take the box, too. We reuse those.", delivery: 'smug, then practical' },
  { id: 'after.3.2', who: 'mitch', moment: 'after.3', text: "Beautiful. I'd hug you, but the apron's all flour. Also, HR.", delivery: 'warm, then a quick aside' },
  { id: 'after.3.3', who: 'mitch', moment: 'after.3', text: 'See? Pizza, done right. I was here for it. Mostly standing. Standing counts.', delivery: 'pleased with himself' },
  { id: 'after.1.1', who: 'mitch', moment: 'after.1', text: "We'll call that a learning experience. For the pizza.", delivery: 'diplomatic, strained' },
  { id: 'after.1.2', who: 'mitch', moment: 'after.1', text: "I'm going to stand behind the oven and pretend I didn't see that.", delivery: 'quiet, already moving' },
  { id: 'after.1.3', who: 'mitch', moment: 'after.1', text: "Okay. The oven's fine. The crust's fine. Something else happened. Moving on.", delivery: 'brisk, not looking at it' },
  { id: 'after.gross.1', who: 'mitch', moment: 'after.gross', text: 'In fairness, I did point at it.', delivery: 'defensive, small' },
  { id: 'after.gross.2', who: 'mitch', moment: 'after.gross', text: "That one's going on a review site. With a photo. Zoomed in.", delivery: 'grim, resigned' },

  /* ── the tutorial: Tony's pepperoni pizza and garlic knots, with a fly on the pepperoni ─────────────────────── */
  { id: 'tutorial.intro.1', who: 'mitch', moment: 'tutorial.intro', text: "First day at the Pizza Parlor? Great. I'm Mitch. Assistant manager, and today, also the dough guy. One order together, nice and slow.", delivery: 'friendly, welcoming' },
  { id: 'tutorial.intro.2', who: 'mitch', moment: 'tutorial.intro', text: "Welcome to the Pizza Parlor. I'm Mitch. Yes, the hat's a pizza box. We'll get to that. First, one pizza, together.", delivery: 'friendly, heading off the hat question' },
  { id: 'tutorial.ticket.1', who: 'mitch', moment: 'tutorial.ticket', text: "That's the ticket, up on the wheel. Tony's pepperoni pizza and garlic knots. Forget the order, pick Ticket, and you hear it again.", delivery: 'clear, pointing up' },
  { id: 'tutorial.ticket.2', who: 'mitch', moment: 'tutorial.ticket', text: "There's the ticket on the wheel. Everything Tony wants, in order. Pick Ticket any time and it reads itself again.", delivery: 'clear, helpful' },
  { id: 'tutorial.prep.1', who: 'mitch', moment: 'tutorial.prep', text: "The prep table. Pick the crust, the dough does a little show, then pick the sauce. After that the cheese and every topping come down the line, one at a time. On the ticket, Add. Not on the ticket, Skip.", delivery: 'teaching, steady' },
  { id: 'tutorial.prep.2', who: 'mitch', moment: 'tutorial.prep', text: "This is where a pizza starts. Crust first, then sauce, then the toppings come to you one by one. Add what the ticket says. Skip what it doesn't.", delivery: 'teaching, steady' },
  { id: 'tutorial.oven.1', who: 'mitch', moment: 'tutorial.oven', text: "The oven. The pizza goes in on the peel. That's the big paddle. I named it. Don't ask what.", delivery: 'proud of the oven, cagey about the name' },
  { id: 'tutorial.oven.2', who: 'mitch', moment: 'tutorial.oven', text: 'This is the oven. Brick, hot, older than me. The pizza slides in on the peel and bakes to whatever the ticket says.', delivery: 'teaching, a little reverent' },
  { id: 'tutorial.cook.oven.1', who: 'mitch', moment: 'tutorial.cook.oven', text: "Now, how baked? Tony said golden. Pick Golden. The oven does the baking, I do the watching. It's a system.", delivery: 'teaching, pleased with the system' },
  { id: 'tutorial.cook.oven.2', who: 'mitch', moment: 'tutorial.cook.oven', text: "How baked? Light, golden or crispy. The ticket says golden. In Timed cooking you'd watch it and Pull It Out yourself. Today, just pick.", delivery: 'teaching, clear' },
  { id: 'tutorial.cut.1', who: 'mitch', moment: 'tutorial.cut', text: 'The cutting board. Tony wants eight slices. Pick 8, and the wheel rolls right through.', delivery: 'teaching, brisk' },
  { id: 'tutorial.cut.2', who: 'mitch', moment: 'tutorial.cut', text: 'Cutting board. Four, six or eight slices. He said eight. The wheel does the cutting. I do the counting.', delivery: 'teaching, counting on his fingers' },
  { id: 'tutorial.knotBasket.1', who: 'mitch', moment: 'tutorial.knotBasket', text: 'The knot basket. The knots are out of the oven. Now garlic butter, then parmesan, then pick the dip. Tony wants marinara.', delivery: 'teaching, steady' },
  { id: 'tutorial.knotBasket.2', who: 'mitch', moment: 'tutorial.knotBasket', text: 'Knot basket. Garlic butter, Add. Parmesan, Add. Then the dip. The ticket says marinara. It usually does.', delivery: 'teaching, a shrug at the end' },
  { id: 'tutorial.gross.1', who: 'mitch', moment: 'tutorial.gross', text: 'When something comes down the line looking wrong, like that pepperoni with a passenger, pick Swap It and you get a fresh one.', delivery: 'teaching, a grimace at the fly' },
  { id: 'tutorial.gross.2', who: 'mitch', moment: 'tutorial.gross', text: 'See that? A fly on the pepperoni. Swap It brings a clean one. Skip sends it away, and Tony still wants pepperoni. So: Swap It.', delivery: 'teaching, firm on the last two words' },
  { id: 'tutorial.review.1', who: 'mitch', moment: 'tutorial.review', text: "Here's the pizza. If something's wrong, redo it now. If it's right, ring it up.", delivery: 'teaching, clear' },
  { id: 'tutorial.review.2', who: 'mitch', moment: 'tutorial.review', text: "And there it is. Have a look. Wrong? Redo it. Right? Ring it up. Tony's been humming the whole time. It's opera. It's always opera.", delivery: 'teaching, a glance at Tony' },
  { id: 'tutorial.serve.1', who: 'mitch', moment: 'tutorial.serve', text: "And that's the job. Get something wrong and the customer will tell you. Tony tells you in song. Ready for a real shift?", delivery: 'wrapping up, encouraging' },
  { id: 'tutorial.serve.2', who: 'mitch', moment: 'tutorial.serve', text: "That's one order, start to finish. Every pizza goes the same way. The customers don't. Ready for a real shift?", delivery: 'wrapping up, dry' },

  /* ── tutorial warnings, before a mistake lands (he = Tony) ─────────────────────────────────────────────────── */
  { id: 'tutorial.warn.extra.1', who: 'mitch', moment: 'tutorial.warn.extra', each: 'ings', text: 'Hold on. No {ings} on this one. Check the ticket.', delivery: 'a quick stop, helpful' },
  { id: 'tutorial.warn.extra.2', who: 'mitch', moment: 'tutorial.warn.extra', each: 'ings', text: "Wait. He didn't want {ings}. That's the wrong one.", delivery: 'a quick stop, helpful' },
  { id: 'tutorial.warn.unasked.1', who: 'mitch', moment: 'tutorial.warn.unasked', each: 'ing', text: "Hold on, the ticket has no {ings}. Skip anything that isn't on it.", delivery: 'a quick stop, helpful' },
  { id: 'tutorial.warn.unasked.2', who: 'mitch', moment: 'tutorial.warn.unasked', each: 'ings', text: 'Wait, no {ings} on the ticket. Skip it.', delivery: 'quick, light' },
  { id: 'tutorial.warn.missing.1', who: 'mitch', moment: 'tutorial.warn.missing', each: 'ing', text: 'Wait, he wants {ing} on that. Add it.', delivery: 'a quick stop, helpful' },
  { id: 'tutorial.warn.missing.2', who: 'mitch', moment: 'tutorial.warn.missing', each: 'ing', text: "Hold on. The ticket says {ing}. Add it, or he'll notice. He notices everything.", delivery: 'quick, a wary glance at Tony' },
  { id: 'tutorial.warn.done.1', who: 'mitch', moment: 'tutorial.warn.done', each: 'want', text: 'Close, but he said {want}.', delivery: 'gentle correction' },
  { id: 'tutorial.warn.done.2', who: 'mitch', moment: 'tutorial.warn.done', each: 'want', text: 'Hold on. The ticket says {want}. Pick {want}.', delivery: 'gentle correction' },
  { id: 'tutorial.warn.pick.1', who: 'mitch', moment: 'tutorial.warn.pick', each: 'wanted', text: 'Hold on. He said {wanted}.', delivery: 'gentle correction' },
  { id: 'tutorial.warn.pick.2', who: 'mitch', moment: 'tutorial.warn.pick', each: 'wanted', text: 'Not that one. The ticket says {wanted}.', delivery: 'gentle correction, reading it off' },
  { id: 'tutorial.warn.gross.1', who: 'mitch', moment: 'tutorial.warn.gross', each: 'ing', text: "Whoa, whoa. We're not serving that {ing}. Swap it for a fresh one.", delivery: 'alarmed, firm' },
  { id: 'tutorial.warn.gross.2', who: 'mitch', moment: 'tutorial.warn.gross', each: 'ing', text: 'Nope. Not that {ing}. Pick Swap It and a clean one comes down.', delivery: 'firm, helpful' },
  { id: 'tutorial.warn.grossSkip.1', who: 'mitch', moment: 'tutorial.warn.grossSkip', each: 'ing', text: 'He wants {ing}. Just not that {ing}. Swap it.', delivery: 'gentle correction' },
  { id: 'tutorial.warn.grossSkip.2', who: 'mitch', moment: 'tutorial.warn.grossSkip', each: 'ing', text: "Don't skip it. The {ing} is on the ticket. Swap It gets you a good one.", delivery: 'gentle correction' },

  /* ── the five-star event: The Pizza Party ({name} is the event's name) ─────────────────────────────────────── */
  { id: 'event.intro.1', who: 'mitch', moment: 'event.intro', text: "It's {name}! A whole wedding party, and every one of them wants pizza. Nobody's cutting a cake today. The last order's a heart, for the happy couple.", delivery: 'excited, a little overwhelmed' },
  { id: 'event.intro.2', who: 'mitch', moment: 'event.intro', text: "Here we go: {name}. The wedding party's out front and the oven's hot. The last pizza's a heart. I've never made a heart. I've drawn one. On a napkin. Once.", delivery: 'brave, then a small confession' },
  { id: 'event.celebrate.1', who: 'mitch', moment: 'event.celebrate', text: '{name} was a hit! The couple cried. The guests cried. I cried, but that was the onions. We have a lot of onions.', delivery: 'joyful, sniffing' },
  { id: 'event.celebrate.2', who: 'mitch', moment: 'event.celebrate', text: "That's {name} done, and the gold sign's going up. Five stars. The hat stays. The hat earned this.", delivery: 'triumphant, solemn about the hat' },
  { id: 'event.again.1', who: 'mitch', moment: 'event.again', text: "{name} didn't quite come together. The couple's still married, so, mostly fine. We can run it again.", delivery: 'consoling, hopeful' },
  { id: 'event.again.2', who: 'mitch', moment: 'event.again', text: "Okay. {name} fell a little flat. Like a crust. We'll run it again, and the heart's still in the oven's future.", delivery: 'rueful, then upbeat' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     EVERY CUSTOMER: the pack's fallback for anyone with fewer than two lines of their own (neutral voice)
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */
  { id: 'react.3.1', who: 'customer', moment: 'react.3', text: "That's it. That's exactly the pizza. I'd frame it, but I'm going to eat it.", delivery: 'pleased, sincere' },
  { id: 'react.3.2', who: 'customer', moment: 'react.3', text: 'Perfect. Every slice where it should be, and everything on it where it should be.', delivery: 'satisfied' },
  { id: 'react.3.3', who: 'customer', moment: 'react.3', text: "Look at that. That's a pizza that read its own ticket.", delivery: 'impressed, dry' },
  { id: 'react.2.1', who: 'customer', moment: 'react.2', text: "Close. Not the pizza I pictured, but it's a pizza, and I'm hungry.", delivery: 'mild, accepting' },
  { id: 'react.2.2', who: 'customer', moment: 'react.2', text: "It's fine. A fine pizza. Fine.", delivery: 'flat, unconvinced by the third fine' },
  { id: 'react.2.3', who: 'customer', moment: 'react.2', text: 'Nearly. This pizza has one wrong idea on it.', delivery: 'dry' },
  { id: 'react.1.1', who: 'customer', moment: 'react.1', text: "This is not what I ordered. This is some other pizza's problem.", delivery: 'unimpressed' },
  { id: 'react.1.2', who: 'customer', moment: 'react.1', text: "Well. It's round. That's where the good news ends.", delivery: 'deadpan' },
  { id: 'react.1.3', who: 'customer', moment: 'react.1', text: "I've seen this pizza before. In a dream. Not a good one.", delivery: 'haunted, dry' },
  { id: 'react.gross.1', who: 'customer', moment: 'react.gross', text: 'Oh. Oh, no. Something on this pizza is looking back at me.', delivery: 'disgusted, a slow horror' },
  { id: 'react.gross.2', who: 'customer', moment: 'react.gross', text: 'No. No, no. That is not a topping.', delivery: 'gagging, firm' },
  // A complaint that names no food (voicecut): everyone has their own in packs/cast/script.js; these stand in for anyone short.
  { id: 'complain.1', who: 'customer', moment: 'complain', text: "That's not what I ordered.", delivery: 'mildly put out' },
  { id: 'complain.2', who: 'customer', moment: 'complain', text: "Hm. This isn't quite what I asked for.", delivery: 'polite, disappointed' },
  { id: 'complain.gross.hair.1', who: 'customer', moment: 'complain.gross.hair', text: "There's a hair in my cheese. It isn't mine. I checked.", delivery: 'disgusted' },
  { id: 'complain.gross.hair.2', who: 'customer', moment: 'complain.gross.hair', text: 'A hair. In the cheese. On a pizza. People will hear about this.', delivery: 'disgusted, measured' },
  { id: 'complain.gross.mouldy.1', who: 'customer', moment: 'complain.gross.mouldy', text: "These mushrooms are green. They're fuzzy. I'm not eating fuzzy.", delivery: 'revolted' },
  { id: 'complain.gross.mouldy.2', who: 'customer', moment: 'complain.gross.mouldy', text: 'These mushrooms have been here longer than the oven.', delivery: 'dry, revolted' },
  { id: 'complain.gross.fly.1', who: 'customer', moment: 'complain.gross.fly', text: "There's a fly on my pepperoni. It's still there. It's getting comfortable.", delivery: 'disgusted, watching it' },
  { id: 'complain.gross.fly.2', who: 'customer', moment: 'complain.gross.fly', text: 'A fly. On the pepperoni. It has a better seat than I do.', delivery: 'flat, disgusted' },
  // Ridiculous orders (level 4 and 5): said instead of the order sentence; the ticket is plain and complete.
  { id: 'order.odd.justCrust.1', who: 'customer', moment: 'order.odd.justCrust', text: "Just the crust. No sauce, no cheese. I'm here for the edges.", delivery: 'matter-of-fact, as if normal' },
  { id: 'order.odd.justCrust.2', who: 'customer', moment: 'order.odd.justCrust', text: "I'll have the crust. Only the crust. The pizza part is for other people.", delivery: 'calm, certain' },
  { id: 'order.odd.halfAndHalf.1', who: 'customer', moment: 'order.odd.halfAndHalf', text: 'Half pepperoni, half pineapple and anchovies. I contain multitudes.', delivery: 'serene, unbothered' },
  { id: 'order.odd.halfAndHalf.2', who: 'customer', moment: 'order.odd.halfAndHalf', text: "Pepperoni on one half, pineapple and anchovies on the other. I'm sharing with someone I don't like.", delivery: 'deadpan' },
  { id: 'order.odd.heartShaped.1', who: 'customer', moment: 'order.odd.heartShaped', text: "A pepperoni pizza, shaped like a heart. I'm proposing tonight. It's a long story. The pizza's the short version.", delivery: 'nervous, hopeful' },
  { id: 'order.odd.heartShaped.2', who: 'customer', moment: 'order.odd.heartShaped', text: "Can you make it heart-shaped? I'm proposing. They said yes to the pizza place, so I'm hopeful.", delivery: 'nervous, hopeful' },
  { id: 'order.odd.allTheWay.1', who: 'customer', moment: 'order.odd.allTheWay', text: "Everything. All the way. Deep dish, crispy, cut in four. I've cleared my evening.", delivery: 'grave, determined' },
  { id: 'order.odd.allTheWay.2', who: 'customer', moment: 'order.odd.allTheWay', text: 'The Everything Pizza, and I mean everything. Deep dish. Crispy. Four slices. Four big ones.', delivery: 'building, relishing it' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     TONY, the parlor's own: retired opera tenor, pizza purist, offended by pineapple. Big, loud, operatic; every
     complaint is a performance. The humour is grandeur and passion, never where he is from.
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */
  { id: 'greet.1', who: 'tony', moment: 'greet', text: 'Tony. Retired tenor. Forty years at the opera house, and now I sing only for pizza.', delivery: 'grand, announcing himself to the room' },
  { id: 'greet.2', who: 'tony', moment: 'greet', text: 'Good evening! I have warmed up my voice and my appetite. Both are enormous.', delivery: 'operatic, delighted with himself' },
  { id: 'greet.3', who: 'tony', moment: 'greet', text: 'Ah, the Pizza Parlor. I have sung in cathedrals. This is holier.', delivery: 'reverent, arms wide' },
  { id: 'greet.4', who: 'tony', moment: 'greet', text: 'Tony has arrived. The napkin is tucked. Let the evening begin.', delivery: 'a curtain-up announcement' },
  { id: 'greet.5', who: 'tony', moment: 'greet', text: 'I heard pineapple was seen in this mall. I came at once. To stand guard.', delivery: 'grave, heroic' },
  { id: 'smalltalk.1', who: 'tony', moment: 'smalltalk', text: 'My farewell performance drew a standing ovation. Fourteen minutes. I timed it. I was also still singing.', delivery: 'proud, savouring every number' },
  { id: 'smalltalk.2', who: 'tony', moment: 'smalltalk', text: 'A tenor needs three things: breath, passion and a good red sauce. I retired with all three.', delivery: 'warm, philosophical' },
  { id: 'smalltalk.3', who: 'tony', moment: 'smalltalk', text: 'I once stopped a show because a man in row C was eating pineapple. He wept. The audience applauded. Me, not him.', delivery: 'triumphant, then a pointed clarification' },
  { id: 'smalltalk.4', who: 'tony', moment: 'smalltalk', text: 'My neighbours say I sing in the shower. I do not sing in the shower. I perform in the shower.', delivery: 'offended, then grand' },
  { id: 'smalltalk.5', who: 'tony', moment: 'smalltalk', text: 'I have sung for three kings and a duke. The duke fell asleep. I sang louder. He woke up a changed man.', delivery: 'boastful, building' },
  { id: 'goodbye.1', who: 'tony', moment: 'goodbye', text: 'I take my leave. Hold your applause. No. Release it.', delivery: 'a grand exit, milking it' },
  { id: 'goodbye.2', who: 'tony', moment: 'goodbye', text: 'Farewell! I exit the way I entered. Magnificently, and slightly too loud.', delivery: 'booming, pleased' },
  { id: 'goodbye.3', who: 'tony', moment: 'goodbye', text: 'Until next time. I shall hum about this all the way to the car.', delivery: 'warm, already humming' },
  { id: 'goodbye.4', who: 'tony', moment: 'goodbye', text: 'Goodbye! A tenor never says goodbye once. Goodbye! And now the encore. Goodbye!', delivery: 'three goodbyes, each bigger' },
  { id: 'order.dislike.1', who: 'tony', moment: 'order.dislike', text: 'And no pineapple. Not a cube. Not a whisper. A pizza is not a fruit salad with ambitions.', delivery: 'firm, building to disdain' },
  { id: 'order.dislike.2', who: 'tony', moment: 'order.dislike', text: 'No pineapple. If I see pineapple, I sing. If I sing, the windows go. Nobody wants that.', delivery: 'a solemn warning' },
  { id: 'order.dislike.3', who: 'tony', moment: 'order.dislike', text: 'Pineapple belongs on a beach, under an umbrella, far from me. Keep it there.', delivery: 'dismissive, waving it away' },
  // The running gag, after the order: 8 seconds or less, over a normal ticket.
  { id: 'order.gag.1', who: 'tony', moment: 'order.gag', text: 'If pineapple so much as looks at my pizza, I will sing. Nobody wants that. I am very good.', delivery: 'a threat, then quiet pride' },
  { id: 'order.gag.2', who: 'tony', moment: 'order.gag', text: 'Crust, sauce, cheese. Everything else is a guest. Pineapple is a burglar.', delivery: 'slow, like scripture, a snarl on burglar' },
  { id: 'order.gag.3', who: 'tony', moment: 'order.gag', text: 'I have sung the lover, the king, the clown. Never the man who orders pineapple. Never.', delivery: 'grand, a whisper on the last word' },
  { id: 'order.gag.4', who: 'tony', moment: 'order.gag', text: 'Make it the way my grandmother would. She was a terrible cook, but she had standards.', delivery: 'fond, then grave' },
  { id: 'order.odd.justCrust.1', who: 'tony', moment: 'order.odd.justCrust', text: 'Just the crust. No sauce, no cheese. I am in training. A tenor must suffer for his art.', delivery: 'noble suffering' },
  { id: 'order.odd.heartShaped.1', who: 'tony', moment: 'order.odd.heartShaped', text: 'A heart-shaped pepperoni. I am proposing tonight. To my accompanist. Thirty years, and she still plays too fast.', delivery: 'tender, then a grumble' },
  { id: 'order.odd.allTheWay.1', who: 'tony', moment: 'order.odd.allTheWay', text: 'Everything, all the way! Deep dish, crispy, cut in four! A purist may indulge once a decade. Tonight is the night!', delivery: 'wild abandon, enormous' },
  { id: 'react.3.1', who: 'tony', moment: 'react.3', text: 'Bravo! The crust sings, the cheese weeps, and so do I!', delivery: 'ecstatic, an operatic crescendo' },
  { id: 'react.3.2', who: 'tony', moment: 'react.3', text: 'Perfection! If I had a rose, I would throw it. I have a napkin. Take the napkin.', delivery: 'overcome, offering the napkin' },
  { id: 'react.3.3', who: 'tony', moment: 'react.3', text: 'Magnificent! This pizza has range. Low notes in the crust, a high C in the sauce!', delivery: 'rapture, full voice' },
  { id: 'react.3.4', who: 'tony', moment: 'react.3', text: 'Yes! YES! This is what I retired for! I would sing, but my mouth will be busy!', delivery: 'triumphant, already reaching for a slice' },
  { id: 'react.2.1', who: 'tony', moment: 'react.2', text: 'Hm. A fine first act. The second act loses its way.', delivery: 'measured, a connoisseur disappointed' },
  { id: 'react.2.2', who: 'tony', moment: 'react.2', text: 'Good. Not great. At the opera house we called this a Tuesday matinee.', delivery: 'polite, faintly wounded' },
  { id: 'react.2.3', who: 'tony', moment: 'react.2', text: 'Close. Very close. Like a singer who finds the note, then slides off it.', delivery: 'pained, demonstrating the slide' },
  { id: 'react.1.1', who: 'tony', moment: 'react.1', text: 'No. No! This is not a pizza, this is a tragedy in one slice!', delivery: 'anguished, full tragic voice' },
  { id: 'react.1.2', who: 'tony', moment: 'react.1', text: 'I have been booed in Vienna. I preferred it to this.', delivery: 'quiet devastation' },
  { id: 'react.1.3', who: 'tony', moment: 'react.1', text: 'This pizza has broken my heart, and my heart is very large. I have had it measured.', delivery: 'wounded grandeur' },
  { id: 'react.gross.1', who: 'tony', moment: 'react.gross', text: '[gasp] What is THAT? Stop the orchestra! Stop everything!', delivery: 'a stage gasp, then bellowing' },
  { id: 'react.gross.2', who: 'tony', moment: 'react.gross', text: 'There is something on my pizza that was not in the libretto!', delivery: 'horrified, dramatic' },
  { id: 'complain.gross.hair.1', who: 'tony', moment: 'complain.gross.hair', text: 'A hair! In the cheese! I have found hairs in my soup, in my coat, in my wig. Never in my cheese!', delivery: 'escalating horror' },
  { id: 'complain.gross.mouldy.1', who: 'tony', moment: 'complain.gross.mouldy', text: 'These mushrooms are GREEN! The colour of envy! The colour of ROT!', delivery: 'a tragic aria' },
  { id: 'complain.gross.fly.1', who: 'tony', moment: 'complain.gross.fly', text: 'A fly! On my pepperoni! It is humming! It is humming FLAT!', delivery: 'horror, then professional offence' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     PAM, the parlor's own: birthday-party mom (paper crown, confetti, balloons on one wrist). Cheerful, exhausted,
     talks in lists. "For twelve" is said, never made; at the Pizza Party she orders for the wedding party.
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */
  { id: 'greet.1', who: 'pam', moment: 'greet', text: 'Hi! Pam. Birthday party. Twelve kids, one bouncy castle, zero adults who are helping.', delivery: 'cheerful, exhausted, a list' },
  { id: 'greet.2', who: 'pam', moment: 'greet', text: "Hello! Twelve seven-year-olds in the party room. They've found the balloons. I've found you.", delivery: 'bright, frazzled' },
  { id: 'greet.3', who: 'pam', moment: 'greet', text: "Hi there. Birthday mom. Crown's not mine, confetti's not mine, this tired is all mine.", delivery: 'chipper, running on fumes' },
  { id: 'greet.4', who: 'pam', moment: 'greet', text: "Hi! Quick list: cake's melting, clown's late, I'm here. That's the list.", delivery: 'fast, ticking items off' },
  { id: 'greet.5', who: 'pam', moment: 'greet', text: "Hello! Paper crown, balloons on my wrist, confetti in places I won't name. Birthday party.", delivery: 'cheerful, counting on her fingers' },
  { id: 'smalltalk.1', who: 'pam', moment: 'smalltalk', text: 'Things the kids have broken so far: a piñata, a chair, and my faith in party planning.', delivery: 'a list, each item heavier' },
  { id: 'smalltalk.2', who: 'pam', moment: 'smalltalk', text: "I made a schedule. Games at two, cake at three. The schedule's in a puddle now. The puddle happened at two-fifteen.", delivery: 'bright, then flat' },
  { id: 'smalltalk.3', who: 'pam', moment: 'smalltalk', text: "The magician cancelled. I told the kids I'd do a trick. I'm going to make this pizza disappear. They'll love it.", delivery: 'upbeat, a little unhinged' },
  { id: 'smalltalk.4', who: 'pam', moment: 'smalltalk', text: "Twelve kids. Three allergies. One kid who doesn't do crusts. I've learned things about myself today.", delivery: 'a list, then a thousand-yard stare' },
  { id: 'smalltalk.5', who: 'pam', moment: 'smalltalk', text: 'The birthday girl is seven. She wants a pony, a pizza, and for her brother to go live somewhere else. Two out of three.', delivery: 'cheerful, counting' },
  { id: 'goodbye.1', who: 'pam', moment: 'goodbye', text: "Okay! Back to the party room. If you hear screaming, that's normal. If you hear quiet, send help.", delivery: 'brisk, then grave' },
  { id: 'goodbye.2', who: 'pam', moment: 'goodbye', text: 'Thanks! Updated list: pizza, done. Cake, pending. Sleep, Thursday.', delivery: 'ticking off, wistful on sleep' },
  { id: 'goodbye.3', who: 'pam', moment: 'goodbye', text: "Bye! If a child comes in asking for the pizza lady, I don't know her.", delivery: 'cheerful, then a whisper' },
  { id: 'goodbye.4', who: 'pam', moment: 'goodbye', text: 'Thank you! Twelve kids are about to be very loud and very happy. Mostly loud.', delivery: 'warm, resigned' },
  // The running gag, after the order: "for twelve" is said; the ticket is one normal order.
  { id: 'order.gag.1', who: 'pam', moment: 'order.gag', text: "That's for twelve, by the way. Twelve kids, one pizza. I've done the math. The math is bad.", delivery: 'fast, cheerful, then flat on the math' },
  { id: 'order.gag.2', who: 'pam', moment: 'order.gag', text: "Oh, and that's for twelve. One pizza, twelve kids. They'll learn about sharing today. So will I.", delivery: 'bright, then a sigh' },
  { id: 'order.gag.3', who: 'pam', moment: 'order.gag', text: "That's for twelve seven-year-olds. One pizza. It's a party, not a buffet. They'll live. Probably.", delivery: 'brisk, a shrug on probably' },
  { id: 'order.gag.4', who: 'pam', moment: 'order.gag', text: "For twelve! Twelve kids! I'm not ordering twelve pizzas. I'm not made of pizzas. I'm made of coffee.", delivery: 'fast, a little wild' },
  { id: 'order.gag.5', who: 'pam', moment: 'order.gag', text: "That's for the whole party, by the way. One pizza, one basket. They'll share. Nobody in history has ever shared.", delivery: 'cheerful, then deadpan' },
  { id: 'order.odd.heartShaped.1', who: 'pam', moment: 'order.odd.heartShaped', text: "Heart-shaped, please. The birthday girl's in a hearts phase. Last month was dinosaurs. We don't talk about dinosaurs.", delivery: 'chipper, then dark' },
  { id: 'order.odd.justCrust.1', who: 'pam', moment: 'order.odd.justCrust', text: 'Just the crust. One of the kids only eats crusts. Fine. Great. Love that for her.', delivery: 'forced cheer, through her teeth' },
  { id: 'order.odd.halfAndHalf.1', who: 'pam', moment: 'order.odd.halfAndHalf', text: "Half pepperoni, half pineapple and anchovies. Two kids, one pizza. Nobody's going to be happy. That's parenting.", delivery: 'bright, matter-of-fact' },
  { id: 'react.3.1', who: 'pam', moment: 'react.3', text: "Perfect! That's exactly it! Twelve kids might actually stop yelling for four whole minutes!", delivery: 'thrilled, counting the minutes' },
  { id: 'react.3.2', who: 'pam', moment: 'react.3', text: "Oh, that's the one. Crown off to you. Figuratively. It's stapled.", delivery: 'delighted, patting the crown' },
  { id: 'react.3.3', who: 'pam', moment: 'react.3', text: "Yes! A pizza that matches the ticket! Today, that's my pony.", delivery: 'overjoyed, slightly teary' },
  { id: 'react.2.1', who: 'pam', moment: 'react.2', text: "Okay. It's close. The kids won't notice. I noticed. I notice everything now.", delivery: 'bright, then haunted' },
  { id: 'react.2.2', who: 'pam', moment: 'react.2', text: 'Not quite. But neither is the cake, the clown or the day.', delivery: 'a cheerful shrug' },
  { id: 'react.2.3', who: 'pam', moment: 'react.2', text: "Almost right. I'll file it under 'mostly fine.' It's a big file.", delivery: 'upbeat, the list voice' },
  { id: 'react.1.1', who: 'pam', moment: 'react.1', text: 'Oh no. Oh, no no no. This is not the pizza. Twelve kids are going to notice this is not the pizza.', delivery: 'rising panic, still smiling' },
  { id: 'react.1.2', who: 'pam', moment: 'react.1', text: "That's the wrong one. I was so close to one thing going right today.", delivery: 'deflated, bright on the surface' },
  { id: 'react.1.3', who: 'pam', moment: 'react.1', text: "Oh, no. This pizza's going on the list. The list of things that happened today.", delivery: 'flat, exhausted cheer' },
  { id: 'react.gross.1', who: 'pam', moment: 'react.gross', text: 'Ew! Ew ew ew! Okay. Nobody tell the kids. Nobody tell me.', delivery: 'a shudder, then a brisk order' },
  { id: 'complain.gross.fly.1', who: 'pam', moment: 'complain.gross.fly', text: "There's a fly on the pepperoni. Great. Thirteen guests now.", delivery: 'flat, cheerful collapse' },
  { id: 'complain.gross.hair.1', who: 'pam', moment: 'complain.gross.hair', text: "A hair. In the cheese. I've got confetti in my coffee, and now a hair in the cheese.", delivery: 'a tired list' },
  { id: 'complain.gross.mouldy.1', who: 'pam', moment: 'complain.gross.mouldy', text: "The mushrooms are green. The kids will think it's a party colour. I know better. I wish I didn't.", delivery: 'bright, then weary' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     BREEZE, the cameo: the Smoothie Shack's surfer, here as a level-4 visitor because the Hawaiian has pineapple.
     Dreamy and relaxed; the joke is in his words, not their length. A running joke against Tony.
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */
  { id: 'visitor.arrive.1', who: 'breeze', moment: 'visitor.arrive', text: 'Whoa. A pizza place. In a mall. The universe is really coming through today.', delivery: 'dreamy, genuinely amazed' },
  { id: 'visitor.arrive.2', who: 'breeze', moment: 'visitor.arrive', text: 'Hey. I followed the smell of pineapple. It led me here. The nose knows.', delivery: 'relaxed, nodding slowly' },
  { id: 'visitor.arrive.3', who: 'breeze', moment: 'visitor.arrive', text: 'Breeze. From the Smoothie Shack. Took a break from smoothies. Came for pizza. Circle of life.', delivery: 'mellow, serene' },
  { id: 'greet.1', who: 'breeze', moment: 'greet', text: 'Hey, friend. What a day. What a counter. What a moment.', delivery: 'slow, savouring each one' },
  { id: 'greet.2', who: 'breeze', moment: 'greet', text: 'Yo. Saw a guy in here get really upset about pineapple. Big voice. I feel for him.', delivery: 'easygoing, sympathetic' },
  { id: 'greet.3', who: 'breeze', moment: 'greet', text: "Hey. Don't mind the board. It's never been in the ocean. We're working up to it.", delivery: 'calm, fond of the board' },
  { id: 'greet.4', who: 'breeze', moment: 'greet', text: "Hey. The surf report said flat. So I'm here. The pizza report says round.", delivery: 'dreamy, pleased with the logic' },
  { id: 'smalltalk.1', who: 'breeze', moment: 'smalltalk', text: 'Pineapple on pizza is like a wave. Some people fight it. I ride it.', delivery: 'serene wisdom' },
  { id: 'smalltalk.2', who: 'breeze', moment: 'smalltalk', text: "There's a dude at the smoothie place who orders all the protein. We talked for an hour. Deep guy.", delivery: 'slow, impressed' },
  { id: 'smalltalk.3', who: 'breeze', moment: 'smalltalk', text: "I don't own a watch. I own a board. The board has never once told me I'm late.", delivery: 'relaxed, content' },
  { id: 'smalltalk.4', who: 'breeze', moment: 'smalltalk', text: "That opera guy keeps looking at me. I think we're friends now. I don't think he thinks that.", delivery: 'mellow, unbothered' },
  { id: 'goodbye.1', who: 'breeze', moment: 'goodbye', text: 'Later. Gonna go sit by the fountain and think about that pizza.', delivery: 'dreamy, drifting off' },
  { id: 'goodbye.2', who: 'breeze', moment: 'goodbye', text: 'Peace. Tell the pineapple guy I said hi. Not the fan. The other one.', delivery: 'easy, a slow grin' },
  { id: 'goodbye.3', who: 'breeze', moment: 'goodbye', text: "Thanks, friend. Tide's going out. Or in. One of those.", delivery: 'a relaxed shrug' },
  { id: 'react.3.1', who: 'breeze', moment: 'react.3', text: "Oh, that's the wave. That's the wave right there. Pineapple, cheese, sunshine.", delivery: 'blissed out' },
  { id: 'react.3.2', who: 'breeze', moment: 'react.3', text: 'Yeah. Yeah. This pizza gets it.', delivery: 'a slow nod, deep approval' },
  { id: 'react.3.3', who: 'breeze', moment: 'react.3', text: "Perfect. Totally perfect. I'm gonna eat this real slow and think about nothing.", delivery: 'serene' },
  { id: 'react.2.1', who: 'breeze', moment: 'react.2', text: "Close. Like a wave that's almost a wave. Still fun. Still wet.", delivery: 'easygoing, forgiving' },
  { id: 'react.2.2', who: 'breeze', moment: 'react.2', text: 'Mostly there. Mostly there is still there, you know?', delivery: 'dreamy, philosophical' },
  { id: 'react.2.3', who: 'breeze', moment: 'react.2', text: "Hm. One thing's off. I'm not mad. I'm just aware.", delivery: 'calm, a slow blink' },
  { id: 'react.1.1', who: 'breeze', moment: 'react.1', text: 'Oh no. This pizza wiped out, friend. Full wipeout.', delivery: 'sad, gentle' },
  { id: 'react.1.2', who: 'breeze', moment: 'react.1', text: "That's not the one. That's a different pizza's journey.", delivery: 'mellow, letting it go' },
  { id: 'react.1.3', who: 'breeze', moment: 'react.1', text: "Bummer. This pizza went looking for itself and didn't come back.", delivery: 'wistful' },
  { id: 'react.gross.1', who: 'breeze', moment: 'react.gross', text: "Whoa. Whoa. That's not from the sea, and it's not from the land. What is that.", delivery: 'slow dawning alarm' },
  { id: 'complain.gross.fly.1', who: 'breeze', moment: 'complain.gross.fly', text: "There's a fly on the pepperoni. Little dude's just hanging out. On my pizza. Not cool, little dude.", delivery: 'relaxed, then mildly stern' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     THE REGULARS: what they say about the pizza (greet, smalltalk and goodbye come from the cast script)
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */

  /* ── Marge: warm, unhurried; "the usual, hon" is a plain cheese pizza ──────────────────────────────────────── */
  { id: 'greet.1', who: 'marge', moment: 'greet', text: 'Hi, hon. Smells like my kitchen in here. Back when my kitchen worked.', delivery: 'warm, nostalgic' },
  { id: 'order.usual.1', who: 'marge', moment: 'order.usual', text: 'The usual, hon.', delivery: 'warm, expecting it to be known' },
  { id: 'order.usual.2', who: 'marge', moment: 'order.usual', text: 'The usual, hon. Plain cheese, nothing on top. Like my life, and I like my life.', delivery: 'warm, content' },
  { id: 'order.odd.heartShaped.1', who: 'marge', moment: 'order.odd.heartShaped', text: "Heart-shaped, hon. I'm proposing to Harold from bingo tonight. He doesn't know yet. He will.", delivery: 'warm, sly' },
  { id: 'order.odd.justCrust.1', who: 'marge', moment: 'order.odd.justCrust', text: "Just the crust, hon. My dentist says to chew more. He didn't say what.", delivery: 'warm, unbothered' },
  { id: 'react.3.1', who: 'marge', moment: 'react.3', text: "Oh, that's lovely, hon. Plain and perfect. Like a good hymn.", delivery: 'warm, touched' },
  { id: 'react.3.2', who: 'marge', moment: 'react.3', text: "Now that's a pizza. I'm telling the girls at bingo. All of them, this time.", delivery: 'warm, pleased' },
  { id: 'react.3.3', who: 'marge', moment: 'react.3', text: 'Perfect, sweetie. Forty years married and he never once got my pizza right. This is right.', delivery: 'warm, a little wistful' },
  { id: 'react.2.1', who: 'marge', moment: 'react.2', text: "It's fine, hon. Forty years married. I know fine when I see it.", delivery: 'warm, dry' },
  { id: 'react.2.2', who: 'marge', moment: 'react.2', text: 'Close, sweetie. Like a bus that stops a little past the sign.', delivery: 'warm, forgiving' },
  { id: 'react.2.3', who: 'marge', moment: 'react.2', text: "It'll do, hon. Not what I asked for, but I've eaten worse at church.", delivery: 'warm, matter-of-fact' },
  { id: 'react.1.1', who: 'marge', moment: 'react.1', text: "Oh, hon. Oh, no. This isn't my pizza. I don't know whose pizza this is.", delivery: 'gently dismayed' },
  { id: 'react.1.2', who: 'marge', moment: 'react.1', text: "Thirty years on a bus, hon. I've seen a lot of wrong turns. This pizza took all of them.", delivery: 'warm, disappointed' },
  { id: 'react.1.3', who: 'marge', moment: 'react.1', text: "Oh, sweetie. I'm going to eat it, but I'm going to be quiet about it, and you'll know why.", delivery: 'warm, pointed' },
  { id: 'react.gross.1', who: 'marge', moment: 'react.gross', text: "Oh, my stars. Hon. There's something on this that's still alive. Or was.", delivery: 'a hand to the chest' },

  /* ── Gus: the trucker; two larges, "one for the road" (his twin), Delores is the truck ─────────────────────── */
  { id: 'greet.1', who: 'gus', moment: 'greet', text: 'Howdy, buddy. Smelled the oven from the loading dock. Delores is parked sideways. Worth it.', delivery: 'an easy drawl' },
  { id: 'order.twin.1', who: 'gus', moment: 'order.twin', text: 'Two larges. One for now, one for the road.', delivery: 'a warm drawl' },
  { id: 'order.twin.2', who: 'gus', moment: 'order.twin', text: "Two larges, buddy. One for me, one for Delores. She don't eat. She likes the smell.", delivery: 'a fond drawl' },
  { id: 'order.odd.heartShaped.1', who: 'gus', moment: 'order.odd.heartShaped', text: "Heart-shaped, buddy. For Delores. One year together. She's the truck. Don't make it weird.", delivery: 'a sheepish drawl' },
  { id: 'react.3.1', who: 'gus', moment: 'react.3', text: "Now that's worth the exit ramp.", delivery: 'a satisfied drawl' },
  { id: 'react.3.2', who: 'gus', moment: 'react.3', text: "Mm. Beautiful. Pizza like that, I'd haul it across three states and never touch it. I'm touchin' it.", delivery: 'reverent, then eager' },
  { id: 'react.3.3', who: 'gus', moment: 'react.3', text: "That's a pizza, buddy. Box goes on the dash so Delores can see.", delivery: 'a proud drawl' },
  { id: 'react.2.1', who: 'gus', moment: 'react.2', text: "It'll do, buddy. Had worse pizza at a truck stop in Nevada. Wasn't even a pizza. Was a sandwich.", delivery: 'an easygoing drawl' },
  { id: 'react.2.2', who: 'gus', moment: 'react.2', text: "Not bad. Little off. Like a rig pullin' slightly to the left.", delivery: 'an amused drawl' },
  { id: 'react.2.3', who: 'gus', moment: 'react.2', text: 'Close enough for the road. Not for the table. I eat on the road.', delivery: 'a cheerful drawl' },
  { id: 'react.1.1', who: 'gus', moment: 'react.1', text: "Well. I once ate a pizza off a gas-station roller. This is losin' to that pizza.", delivery: 'a deadpan drawl' },
  { id: 'react.1.2', who: 'gus', moment: 'react.1', text: "I'm gonna eat it. I'm a trucker. But I'm gonna be quiet for a while.", delivery: 'a resigned drawl' },
  { id: 'react.1.3', who: 'gus', moment: 'react.1', text: "Buddy, this ain't my pizza. This is some other fella's pizza, and he's gonna be upset too.", delivery: 'slow, sorrowful' },
  { id: 'react.gross.1', who: 'gus', moment: 'react.gross', text: 'Oh, no. Oh, buddy. No. I seen roadkill with better manners.', delivery: 'a low groan' },

  /* ── Coach Bev: booming; meat lover's is her favourite ("a full roster"); caps are her emphasis ─────────────── */
  { id: 'greet.1', who: 'bev', moment: 'greet', text: 'Coach Bev! Pizza night! The team VOTED! It was UNANIMOUS! I counted!', delivery: 'booming' },
  { id: 'order.odd.heartShaped.1', who: 'bev', moment: 'order.odd.heartShaped', text: 'Heart-shaped! For the TEAM! They lost by forty! They need LOVE! And carbs!', delivery: 'booming, tender underneath' },
  { id: 'react.3.1', who: 'bev', moment: 'react.3', text: 'THAT is a pizza! Full roster! Everybody made the TEAM!', delivery: 'triumphant' },
  { id: 'react.3.2', who: 'bev', moment: 'react.3', text: "Touchdown! Slam dunk! Hole in one! Whatever! It's PIZZA and it's RIGHT!", delivery: 'booming, ecstatic' },
  { id: 'react.3.3', who: 'bev', moment: 'react.3', text: "YES! That's executing the PLAY! This is going on the clipboard!", delivery: 'booming, scribbling' },
  { id: 'react.favourite.1', who: 'bev', moment: 'react.favourite', text: "MEAT LOVER'S! Pepperoni AND sausage! A FULL ROSTER!", delivery: 'triumphant, fists up' },
  { id: 'react.favourite.2', who: 'bev', moment: 'react.favourite', text: "That's the meat lover's! Every player showed up! Nobody's BENCHED!", delivery: 'booming, proud' },
  { id: 'react.2.1', who: 'bev', moment: 'react.2', text: 'Not bad! Not great! Sloppy in the second half!', delivery: 'booming, assessing' },
  { id: 'react.2.2', who: 'bev', moment: 'react.2', text: "Solid effort! One bad call! We'll review the tape!", delivery: 'booming, fair' },
  { id: 'react.2.3', who: 'bev', moment: 'react.2', text: "Close! That's a near miss! On the PIZZA!", delivery: 'booming' },
  { id: 'react.1.1', who: 'bev', moment: 'react.1', text: "That's a penalty! Fifteen yards! On the PIZZA!", delivery: 'outraged' },
  { id: 'react.1.2', who: 'bev', moment: 'react.1', text: 'This pizza is BENCHED! For the SEASON!', delivery: 'a booming verdict' },
  { id: 'react.1.3', who: 'bev', moment: 'react.1', text: 'Wrong play! Wrong PIZZA! This pizza never read the playbook!', delivery: 'booming, disgusted' },
  { id: 'react.gross.1', who: 'bev', moment: 'react.gross', text: 'TIMEOUT! TIMEOUT! Something on this pizza is NOT on the roster!', delivery: 'panicked, whistle energy' },

  /* ── Vernon: foppish, fussy, exact; thin crust, light, cut in eight. "I will know." ─────────────────────────── */
  { id: 'greet.1', who: 'vernon', moment: 'greet', text: '[sigh] Good evening. Eight slices, as ever. I shall be counting.', delivery: 'a theatrical sigh, precise' },
  { id: 'order.odd.heartShaped.1', who: 'vernon', moment: 'order.odd.heartShaped', text: "Heart-shaped. For my readers. It's our anniversary. Eleven years, eleven followers. I don't see the connection either.", delivery: 'refined, faintly hurt' },
  { id: 'order.odd.allTheWay.1', who: 'vernon', moment: 'order.odd.allTheWay', text: "Everything, all the way. Deep dish. Crispy. Cut in four. Tonight I am a different man. Tomorrow I'll deny it.", delivery: 'reckless, in a refined way' },
  { id: 'react.3.1', who: 'vernon', moment: 'react.3', text: 'Eight slices. I counted. Twice. [pause] Acceptable.', delivery: 'a long pause, then grudging' },
  { id: 'react.3.2', who: 'vernon', moment: 'react.3', text: 'Hm. Thin. Light. Eight. I have nothing to add. This has never happened.', delivery: 'haughty, faintly shaken' },
  { id: 'react.3.3', who: 'vernon', moment: 'react.3', text: "Four and a half slices out of five. I don't give fives. Fives are for people who need them.", delivery: 'refined, superior' },
  { id: 'react.2.1', who: 'vernon', moment: 'react.2', text: '[sigh] A solid meh. My readers get three paragraphs on it.', delivery: 'a theatrical sigh, unimpressed' },
  { id: 'react.2.2', who: 'vernon', moment: 'react.2', text: "Competent. Forgettable. Like a pizza that's nearly mine.", delivery: 'haughty, bored' },
  { id: 'react.2.3', who: 'vernon', moment: 'react.2', text: "Nearly. Nearly is what I write when I'm being kind. I'm being kind.", delivery: 'cool, pointed' },
  { id: 'react.1.1', who: 'vernon', moment: 'react.1', text: "I've had warmer welcomes from a parking meter.", delivery: 'deeply unimpressed' },
  { id: 'react.1.2', who: 'vernon', moment: 'react.1', text: 'My followers will hear about this. All eleven. Gerald will come back just to read it.', delivery: 'icy, almost pleased' },
  { id: 'react.1.3', who: 'vernon', moment: 'react.1', text: "I said I would know. I know. [sigh] I wish I didn't.", delivery: 'wounded dignity' },
  { id: 'react.gross.1', who: 'vernon', moment: 'react.gross', text: "This will be my most read post ever. I'm not pleased. I'm not displeased.", delivery: 'grim, quietly thrilled' },

  /* ── Sal: gruff, loud, a bit crude; pepperoni is his favourite, after bacon ─────────────────────────────────── */
  { id: 'greet.1', who: 'sal', moment: 'greet', text: "Ay. Pizza. Somethin' I don't gotta make, sell or explain.", delivery: 'gruff relief' },
  { id: 'order.odd.heartShaped.1', who: 'sal', moment: 'order.odd.heartShaped', text: "Heart-shaped. For my wife. Don't make a thing of it. It's a thing.", delivery: 'gruff, embarrassed' },
  { id: 'order.odd.halfAndHalf.1', who: 'sal', moment: 'order.odd.halfAndHalf', text: "Half pepperoni, half pineapple and anchovies. The anchovies are mine. The pineapple's for my brother-in-law. He ain't comin'.", delivery: 'gruff, sly' },
  { id: 'react.3.1', who: 'sal', moment: 'react.3', text: "Now THAT'S a pizza. I'm gonna need a bigger apron.", delivery: 'loud, delighted' },
  { id: 'react.3.2', who: 'sal', moment: 'react.3', text: "Mm. Beautiful. Don't tell nobody I said beautiful. I got a reputation.", delivery: 'gruff, then a glance around' },
  { id: 'react.3.3', who: 'sal', moment: 'react.3', text: "That's the one. Better than anything on my cart. Which, between us, ain't hard.", delivery: 'gruff, honest' },
  { id: 'react.favourite.1', who: 'sal', moment: 'react.favourite', text: 'Pepperoni! My favorite, after bacon. Bacon knows. We talked.', delivery: 'gruff, sincere' },
  { id: 'react.favourite.2', who: 'sal', moment: 'react.favourite', text: "Pepperoni, done right. I could cry. I won't. I'm in public.", delivery: 'gruff, moved' },
  { id: 'react.2.1', who: 'sal', moment: 'react.2', text: "Eh. It's fine. I've had worse. I sell worse.", delivery: 'a gruff shrug' },
  { id: 'react.2.2', who: 'sal', moment: 'react.2', text: "Close. Not perfect. Like my brother-in-law's second cart idea.", delivery: 'gruff, scornful' },
  { id: 'react.2.3', who: 'sal', moment: 'react.2', text: "It's okay. Not what I said, but I eat what I'm given. My wife made sure of that.", delivery: 'gruff, resigned' },
  { id: 'react.1.1', who: 'sal', moment: 'react.1', text: 'What is this? The pigeons out front would send this back. And they eat gum.', delivery: 'loud, disgusted' },
  { id: 'react.1.2', who: 'sal', moment: 'react.1', text: "Ugh. This is worse than my hot dogs, and I know what's in my hot dogs.", delivery: 'gruff, appalled' },
  { id: 'react.1.3', who: 'sal', moment: 'react.1', text: "Ay. I got a cart with a stuck umbrella and a cousin eatin' the inventory, and this pizza is still the worst part of my day.", delivery: 'gruff, aggrieved' },
  { id: 'react.gross.1', who: 'sal', moment: 'react.gross', text: "Oh, that's nasty. I ride the subway every day, and that's the nastiest thing I seen since Tuesday.", delivery: 'loud, revolted' },

  /* ── Professor Oakes: food science, nasal and too fast; a new reason to hate onions here ────────────────────── */
  { id: 'greet.1', who: 'oakes', moment: 'greet', text: "Good evening. I've come for a pizza, and I've brought a ruler. The two are related.", delivery: 'nasal, eager' },
  { id: 'order.dislike.1', who: 'oakes', moment: 'order.dislike', text: "No onions. In an oven, an onion caramelises, and I don't trust a vegetable that changes its story under heat.", delivery: 'nasal, too fast, suspicious' },
  { id: 'order.dislike.2', who: 'oakes', moment: 'order.dislike', text: "No onions. An onion on a pizza sweats. I've measured it. Four millilitres a slice. I have charts.", delivery: 'nasal, brandishing the charts' },
  { id: 'order.dislike.3', who: 'oakes', moment: 'order.dislike', text: 'No onions. Raw, they make you cry. Baked, they make you forget why. I refuse to be manipulated by a bulb.', delivery: 'nasal, righteous' },
  { id: 'order.odd.heartShaped.1', who: 'oakes', moment: 'order.odd.heartShaped', text: "Heart-shaped. I'm proposing. To my research partner. Eleven co-authored papers. Statistically, it's time.", delivery: 'nasal, nervous, certain' },
  { id: 'order.odd.halfAndHalf.1', who: 'oakes', moment: 'order.odd.halfAndHalf', text: "Half pepperoni, half pineapple and anchovies. It's for an experiment. The experiment is called 'what happens.'", delivery: 'nasal, eager' },
  { id: 'react.3.1', who: 'oakes', moment: 'react.3', text: 'Excellent! A forty-centimetre cheese stretch, minimum. I brought the ruler for this exact reason.', delivery: 'nasal, thrilled, measuring' },
  { id: 'react.3.2', who: 'oakes', moment: 'react.3', text: "Splendid. A textbook pizza. I'd know. I wrote the textbook. Nobody bought it.", delivery: 'nasal, proud, then deflating' },
  { id: 'react.3.3', who: 'oakes', moment: 'react.3', text: 'Perfect! Crust, sauce, cheese, in the correct order. Most of my students put the cheese first. Most of them are no longer my students.', delivery: 'nasal, too fast, dark at the end' },
  { id: 'react.2.1', who: 'oakes', moment: 'react.2', text: 'Hm. Within one standard deviation of my order. Barely.', delivery: 'nasal, grudging' },
  { id: 'react.2.2', who: 'oakes', moment: 'react.2', text: "Adequate. I'll write 'adequate' and underline it. Underlining is how I express feelings.", delivery: 'nasal, earnest' },
  { id: 'react.2.3', who: 'oakes', moment: 'react.2', text: "Close. A B-minus pizza. I'm a generous grader. Ask no one.", delivery: 'nasal, quick' },
  { id: 'react.1.1', who: 'oakes', moment: 'react.1', text: 'This is not my pizza. This is a control group.', delivery: 'nasal, clinical' },
  { id: 'react.1.2', who: 'oakes', moment: 'react.1', text: "Fascinating. Every variable is wrong. I'll need a bigger notebook.", delivery: 'nasal, appalled and delighted' },
  { id: 'react.1.3', who: 'oakes', moment: 'react.1', text: "No. This fails. I'd offer extra credit, but a pizza can't do extra credit. I've asked.", delivery: 'nasal, firm' },
  { id: 'react.gross.1', who: 'oakes', moment: 'react.gross', text: "Oh! Oh, that's a specimen! Nobody touch it. I need a jar.", delivery: 'nasal, scientific glee and horror' },

  /* ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════
     THE VISITORS (level 4): Reginald the critic (newest on the menu: the Everything Pizza) and Kai, ten
     ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════ */
  { id: 'visitor.arrive.1', who: 'reginald', moment: 'visitor.arrive', text: "Make way. Reginald. Critic. I've come to review the Pizza Parlor course by course. There is one course. I'll manage.", delivery: 'theatrical, sweeping in' },
  { id: 'visitor.arrive.2', who: 'reginald', moment: 'visitor.arrive', text: "Ah. The Pizza Parlor. I smelled the oven from the fountain. I'll be reviewing the fountain too.", delivery: 'grand, nostrils flared' },
  { id: 'visitor.arrive.3', who: 'reginald', moment: 'visitor.arrive', text: 'Good evening. A critic enters a pizzeria the way a ship enters harbour. Slowly, and with a scarf.', delivery: 'stately' },
  { id: 'greet.1', who: 'reginald', moment: 'greet', text: 'Good evening. Whatever is newest, please. A critic must suffer the new.', delivery: 'theatrical, resigned to greatness' },
  { id: 'react.3.1', who: 'reginald', moment: 'react.3', text: 'Magnificent. The crust alone deserves a paragraph. The cheese, a chapter. The whole, a sequel.', delivery: 'rapturous, sweeping' },
  { id: 'react.3.2', who: 'reginald', moment: 'react.3', text: 'Sublime. Four stars, and the fourth one is reluctant. They always are.', delivery: 'grand, grudging on the fourth' },
  { id: 'react.3.3', who: 'reginald', moment: 'react.3', text: "Perfection. Kai, write this down. 'Round. Hot. Correct.' No. Longer than that. Much longer.", delivery: 'theatrical, dictating' },
  { id: 'react.2.1', who: 'reginald', moment: 'react.2', text: "Hm. A pizza of two halves. One half is excellent. The other half is a review I'll enjoy writing.", delivery: 'theatrical, relishing it' },
  { id: 'react.2.2', who: 'reginald', moment: 'react.2', text: "Nearly. Nearly is the critic's favourite word. It's where the paragraphs live.", delivery: 'grave, pleased with himself' },
  { id: 'react.2.3', who: 'reginald', moment: 'react.2', text: "Fine. Three stars. Wet, but lacking ambition. No, that's my water review. Three stars anyway.", delivery: 'theatrical, catching himself' },
  { id: 'react.1.1', who: 'reginald', moment: 'react.1', text: "Oh, dear. I came for a pizza, and I've been handed material.", delivery: 'a slow, delighted horror' },
  { id: 'react.1.2', who: 'reginald', moment: 'react.1', text: "This is not what I ordered. It is, however, what I'll be writing about until spring.", delivery: 'theatrical, wounded' },
  { id: 'react.1.3', who: 'reginald', moment: 'react.1', text: "A tragedy in eight slices. I'll be gentle in print. I won't. But I'll say I was.", delivery: 'grand, confiding' },
  { id: 'react.gross.1', who: 'reginald', moment: 'react.gross', text: 'Good heavens. There is something on this pizza that has its own review.', delivery: 'aghast, intrigued' },

  { id: 'visitor.arrive.1', who: 'kai', moment: 'visitor.arrive', text: "Hi. Kai. I'm reviewing the Pizza Parlor. Reginald's outside. He's still describing the door.", delivery: 'bright, very serious' },
  { id: 'visitor.arrive.2', who: 'kai', moment: 'visitor.arrive', text: "Hello. I'm here on official business. The business is pizza.", delivery: 'bright, formal' },
  { id: 'visitor.arrive.3', who: 'kai', moment: 'visitor.arrive', text: "Hi. My mom's in the shoe store. I have a notebook and a plan. The plan is pizza.", delivery: 'bright, very serious' },
  { id: 'react.3.1', who: 'kai', moment: 'react.3', text: 'Round. Hot. Correct. Ten out of ten.', delivery: 'bright, decisive' },
  { id: 'react.3.2', who: 'kai', moment: 'react.3', text: "Perfect. That's a smiley face in the notebook. I don't give those out. I just did.", delivery: 'bright, solemn' },
  { id: 'react.3.3', who: 'kai', moment: 'react.3', text: 'Yes. This is the one. Three words: Good. Pizza. Good.', delivery: 'bright, counting the words' },
  { id: 'react.2.1', who: 'kai', moment: 'react.2', text: 'Mostly right. Seven out of ten. The three went somewhere.', delivery: 'bright, serious' },
  { id: 'react.2.2', who: 'kai', moment: 'react.2', text: "Hm. One thing's wrong. I'm drawing a straight face. It's a new face.", delivery: 'bright, thoughtful' },
  { id: 'react.2.3', who: 'kai', moment: 'react.2', text: "It's okay. Reginald would write a page. I'll write 'okay' and circle it.", delivery: 'bright, matter-of-fact' },
  { id: 'react.1.1', who: 'kai', moment: 'react.1', text: "That's the frowny face. I was saving it. Now it's gone.", delivery: 'bright, grave' },
  { id: 'react.1.2', who: 'kai', moment: 'react.1', text: "This isn't what I ordered. Two words: wrong pizza.", delivery: 'bright, firm' },
  { id: 'react.1.3', who: 'kai', moment: 'react.1', text: 'Reginald says a critic must be fair. Fair: this is not my pizza. Done.', delivery: 'bright, final' },
  { id: 'react.gross.1', who: 'kai', moment: 'react.gross', text: "Ew. Okay. That's a new page in the notebook. The page just says 'no.'", delivery: 'bright, shaken' },
] });
